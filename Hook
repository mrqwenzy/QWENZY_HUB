	local webhook_URL =
		"https://discord.com/api/webhooks/1482008775492894872/HcX9OkB6lMpSQWgtvlAJy7BzUQTRkJggiPE73FENa-7s39ZqncLwh0-VEcL9LKVKGUqx"

	local player = Players.LocalPlayer
	local userId = player.UserId
	local placeId = game.PlaceId

	-- Avatar
	local thumbResponse = request({
		Url = "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=" .. userId .. "&size=420x420&format=Png",
		Method = "GET",
	})
	local thumbData = HttpService:JSONDecode(thumbResponse.Body)
	local avatarUrl = thumbData.data[1].imageUrl

	-- Game logo
	local logoResponse = request({
		Url = "https://thumbnails.roblox.com/v1/places/gameicons?placeIds=" .. placeId .. "&size=512x512&format=Png",
		Method = "GET",
	})
	local logoData = HttpService:JSONDecode(logoResponse.Body)
