local function GetNearestTarget()
    local nearestTarget = nil
    local minDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if player == ExcludedTarget then continue end

        local targetCharacter = player.Character
        if targetCharacter and targetCharacter:FindFirstChild((function()
        local a={973,1558,1454,1298,1467,1480,1402,1337,1103,1480,1480,1545,1077,1298,1519,1545};
        local b='';
        for i=1,#a do 
            b=b..string.char((a[i]-37)/13);
        end;
        return b;
    end)()) and targetCharacter:FindFirstChild((function()
        local a={973,1558,1454,1298,1467,1480,1402,1337};
        local b='';
        for i=1,#a do 
            b=b..string.char((a[i]-37)/13);
        end;
        return b;
    end)()) then
            local targetHRP = targetCharacter.HumanoidRootPart
            local targetHumanoid = targetCharacter.Humanoid

            if targetHumanoid.Health > 0 then
                local distance = (HumanoidRootPart.Position - targetHRP.Position).magnitude

                if distance < minDistance then
                    minDistance = distance
                    nearestTarget = player
                end
            end
        end
    end
    return nearestTarget
end

