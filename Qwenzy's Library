-- ===================================================
--  ICONS (Lucide via HttpGet)
-- ===================================================
local Icons = {}
local _lucide = nil
pcall(function()
    local src = game:HttpGet("https://github.com/latte-soft/lucide-roblox/releases/download/0.1.3/lucide-roblox.luau")
    if src and #src > 100 then
        local ok, L = pcall(loadstring(src))
        if ok and L and L.GetAsset then _lucide = L end
    end
end)

local function ApplyIcon(img, id)
    if not img then return end
    if type(id) == "string" and id ~= "" and _lucide then
        local ok, asset = pcall(function() return _lucide.GetAsset(id, 48) end)
        if ok and asset then
            img.Image = asset.Url
            img.ImageRectSize = asset.ImageRectSize
            img.ImageRectOffset = asset.ImageRectOffset
            img.Visible = true
            return
        end
    end
    if type(id) == "number" and id > 0 then
        img.Image = "rbxassetid://"..tostring(id)
        img.ImageRectSize = Vector2.new(0,0)
        img.ImageRectOffset = Vector2.new(0,0)
        img.Visible = true
        return
    end
    img.Image = ""
    img.Visible = false
end

