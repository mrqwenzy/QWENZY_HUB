            Tween(fab, {BackgroundColor3=T.AccB}, 1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(1.4)
            Tween(fab, {BackgroundColor3=T.Acc}, 1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(1.4)
        end
    end)

    fab.MouseButton1Click:Connect(function()
        Ripple(fab)
        local showing = not main.Visible
        main.Visible = showing
        if showing then
            -- Snap back on screen if it drifted off
            local vp2 = workspace.CurrentCamera.ViewportSize
            local ap = main.AbsolutePosition
            local as = main.AbsoluteSize
            if ap.X < 0 or ap.Y < 0 or ap.X+as.X > vp2.X or ap.Y+as.Y > vp2.Y then
                Tween(main, {Position=UDim2.new(0,(vp2.X-as.X)/2,0,(vp2.Y-as.Y)/2)}, 0.3, Enum.EasingStyle.Back)
            end
            Tween(main, {Size=UDim2.new(0,WIN_W,0,WIN_H)}, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            minimized = false
        end
        -- Icon swap
        ApplyIcon(fabIco, showing and "layout-grid" or "layout-grid")
    end)

