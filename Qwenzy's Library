local IsMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- Track latest touch position so CursorX/Y work like Mouse.X/Y
local _touchX, _touchY = 0, 0
UserInputService.TouchMoved:Connect(function(t)   _touchX = t.Position.X; _touchY = t.Position.Y end)
UserInputService.TouchStarted:Connect(function(t) _touchX = t.Position.X; _touchY = t.Position.Y end)

local function CursorX() return IsMobile and _touchX or Mouse.X end
local function CursorY() return IsMobile and _touchY or Mouse.Y end

-- Unified pointer-down on a specific GuiObject (mouse OR touch)
local function OnPointerDown(obj, fn)
    obj.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            fn(inp)
        end
    end)
end

-- Unified global pointer-up (returns connection)
local function OnPointerUp(fn)
    return UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            fn(inp)
        end
    end)
end

