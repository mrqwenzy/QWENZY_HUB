-- ===================================================
--  UTILS
-- ===================================================
local function Tween(obj, props, t, style, dir)
    local ok, tw = pcall(function()
        return TweenService:Create(obj,
            TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
    end)
    if ok and tw then tw:Play() return tw end
end

local function New(cls, props, parent)
    local i = Instance.new(cls)
    for k,v in pairs(props) do pcall(function() i[k]=v end) end
    if parent then i.Parent = parent end
    return i
end

local function Round(i, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = i
    return c
end

local function Stroke(i, col, th, tr)
    local s = Instance.new("UIStroke")
    s.Color = col or Color3.new(1,1,1)
    s.Thickness = th or 1
    s.Transparency = tr or 0.8
    s.Parent = i
    return s
end

local function Grad(i, c0, c1, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(c0, c1)
    g.Rotation = rot or 90
    g.Parent = i
    return g
end

local function Shadow(p)
    return New("ImageLabel", {
        Name="Shadow", BackgroundTransparency=1,
        Image="rbxassetid://6014261993",
        ImageColor3=Color3.new(0,0,0), ImageTransparency=0.6,
        ScaleType=Enum.ScaleType.Slice, SliceCenter=Rect.new(49,49,450,450),
        Size=UDim2.new(1,40,1,40), Position=UDim2.new(0,-20,0,-20),
        ZIndex=(p.ZIndex or 1)-1,
    }, p)
end

local function Ripple(btn)
    pcall(function()
        local rp = New("Frame", {
            BackgroundColor3=Color3.fromRGB(255,255,255),
            BackgroundTransparency=0.78,
            Size=UDim2.new(0,0,0,0),
            Position=UDim2.new(0, Mouse.X-btn.AbsolutePosition.X,
                               0, Mouse.Y-btn.AbsolutePosition.Y),
            AnchorPoint=Vector2.new(0.5,0.5), ZIndex=500, ClipsDescendants=false,
        }, btn)
        Round(rp, 999)
        local sz = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2.4
        Tween(rp, {Size=UDim2.new(0,sz,0,sz), BackgroundTransparency=1}, 0.45, Enum.EasingStyle.Quad)
        task.delay(0.45, function() if rp then rp:Destroy() end end)
    end)
end

-- ===================================================
--  CONFIG
-- ===================================================
local ConfigManager = {}
ConfigManager.__index = ConfigManager

function ConfigManager.new(folder, file)
    local self = setmetatable({Data={}, _folder=folder or "QwenzyUI", _file=file or "Config"}, ConfigManager)
    self:Load()
    return self
end
function ConfigManager:_path() return self._folder.."/"..self._file..".json" end
function ConfigManager:Load()
    pcall(function()
        if not _isfolder(self._folder) then _makefolder(self._folder) end
        local p = self:_path()
        if _isfile(p) then
            local raw = _readfile(p)
            if raw and raw ~= "" then
                local ok, d = pcall(function() return HttpService:JSONDecode(raw) end)
                if ok and type(d)=="table" then self.Data = d end
            end
        end
    end)
end
function ConfigManager:Save()
    pcall(function()
        if not _isfolder(self._folder) then _makefolder(self._folder) end
        _writefile(self:_path(), HttpService:JSONEncode(self.Data))
    end)
end
function ConfigManager:Get(k, def) return self.Data[k] ~= nil and self.Data[k] or def end
function ConfigManager:Set(k, v) self.Data[k] = v; self:Save() end

