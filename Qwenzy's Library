        -- COLOR PICKER
        function Tab:CreateColorPicker(cfg_)
            local initC = cfg_.Color or Color3.fromRGB(255,100,100)
            local hue, sat, bri = initC:ToHSV()
            local collapsed = true
            local WH = 144
            local BH = 16
            local EXP_H = 50 + WH + 10 + BH + 20

            local c = Card(46)
            c.ClipsDescendants = true
            NameLbl(c, cfg_.Name or "Color")

            local swatch = New("Frame", {
                Size=UDim2.new(0,30,0,20), Position=UDim2.new(1,-44,0.5,0),
                AnchorPoint=Vector2.new(0,0.5), BackgroundColor3=initC,
                BorderSizePixel=0, ZIndex=3,
            }, c)
            Round(swatch, 5)
            Stroke(swatch, T.Border, 1, 0.25)

            local chev = New("TextLabel", {
                Size=UDim2.new(0,14,0,14), Position=UDim2.new(1,-12,0.5,0),
                AnchorPoint=Vector2.new(1,0.5), BackgroundTransparency=1,
                Text="v", TextColor3=T.TextM, TextSize=10, Font=Enum.Font.GothamBold,
                TextXAlignment=Enum.TextXAlignment.Center, ZIndex=3,
            }, c)

            local picker = New("Frame", {
                Size=UDim2.new(1,-24,0,WH+BH+18), Position=UDim2.new(0,12,0,50),
                BackgroundTransparency=1, BorderSizePixel=0, ZIndex=3, Visible=false,
            }, c)

            -- Wheel
            local wheelClip = New("Frame", {
                Size=UDim2.new(0,WH,0,WH), Position=UDim2.new(0.5,0,0,0),
                AnchorPoint=Vector2.new(0.5,0), BackgroundColor3=Color3.fromRGB(0,0,0),
                BorderSizePixel=0, ZIndex=10,
            }, picker)
            Round(wheelClip, WH/2)
            New("ImageLabel", {
                Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
                Image="rbxassetid://109617510791865",
                ScaleType=Enum.ScaleType.Fit, ZIndex=11,
            }, wheelClip)
            local darkOv = New("Frame", {
                Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.fromRGB(0,0,0),
                BackgroundTransparency=bri, BorderSizePixel=0, ZIndex=12,
            }, wheelClip)
            Round(darkOv, WH/2)

            local function WheelPos(h, s)
                local angle = math.pi + h * 2 * math.pi
                local r = (WH/2-7)*s
                return UDim2.new(0, WH/2+r*math.cos(angle), 0, WH/2+r*math.sin(angle))
            end

            local wCur = New("Frame", {
                Size=UDim2.new(0,16,0,16), Position=WheelPos(hue,sat),
                AnchorPoint=Vector2.new(0.5,0.5),
                BackgroundColor3=Color3.fromRGB(255,255,255),
                BorderSizePixel=0, ZIndex=14,
            }, wheelClip)
            Round(wCur, 8)
            Stroke(wCur, Color3.fromRGB(0,0,0), 2, 0)
            local wDot = New("Frame", {
                Size=UDim2.new(0,8,0,8), Position=UDim2.new(0.5,0,0.5,0),
                AnchorPoint=Vector2.new(0.5,0.5), BackgroundColor3=initC,
                BorderSizePixel=0, ZIndex=15,
            }, wCur)
            Round(wDot, 4)
            New("TextButton", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=16}, wheelClip)

            -- Brightness bar
            local briTrack = New("Frame", {
                Size=UDim2.new(1,0,0,BH), Position=UDim2.new(0,0,0,WH+8),
                BackgroundColor3=Color3.fromRGB(0,0,0), BorderSizePixel=0, ZIndex=10,
            }, picker)
            Round(briTrack, BH/2)
            local bGrad = Instance.new("UIGradient")
            bGrad.Color = ColorSequence.new(Color3.fromRGB(0,0,0), Color3.fromHSV(hue,1,1))
            bGrad.Rotation = 0
            bGrad.Parent = briTrack
            local bCur = New("Frame", {
                Size=UDim2.new(0,BH+2,0,BH+2), Position=UDim2.new(bri,0,0.5,0),
                AnchorPoint=Vector2.new(0.5,0.5),
                BackgroundColor3=Color3.fromRGB(255,255,255),
                BorderSizePixel=0, ZIndex=12,
            }, briTrack)
            Round(bCur, (BH+2)/2)
            Stroke(bCur, Color3.fromRGB(20,20,20), 1.5, 0)
            New("TextButton", {
                Size=UDim2.new(1,0,1,14), Position=UDim2.new(0,0,0,-7),
                BackgroundTransparency=1, Text="", ZIndex=13,
            }, briTrack)

            local hexLbl = New("TextLabel", {
                Size=UDim2.new(1,0,0,12), Position=UDim2.new(0,0,0,WH+28),
                BackgroundTransparency=1,
                Text=string.format("#%02X%02X%02X",
                    math.floor(initC.R*255),math.floor(initC.G*255),math.floor(initC.B*255)),
                TextColor3=T.TextM, TextSize=10, Font=Enum.Font.Code,
                TextXAlignment=Enum.TextXAlignment.Center, ZIndex=10,
            }, picker)

            local curColor = initC
            local dragW, dragB = false, false

            local function UpdateColor()
                curColor = Color3.fromHSV(hue, sat, bri)
                swatch.BackgroundColor3 = curColor
                wDot.BackgroundColor3 = curColor
                darkOv.BackgroundTransparency = bri
                wCur.Position = WheelPos(hue, sat)
                bCur.Position = UDim2.new(bri,0,0.5,0)
                bGrad.Color = ColorSequence.new(Color3.fromRGB(0,0,0), Color3.fromHSV(hue,1,1))
                hexLbl.Text = string.format("#%02X%02X%02X",
                    math.floor(curColor.R*255),math.floor(curColor.G*255),math.floor(curColor.B*255))
                Qwenzy.Flags[cfg_.Flag or ""] = curColor
                if cfg_.Callback then task.spawn(cfg_.Callback, curColor) end
            end

            local function PickWheel(mx, my)
                local cx = wheelClip.AbsolutePosition.X + WH/2
                local cy = wheelClip.AbsolutePosition.Y + WH/2
                local dx, dy = mx-cx, my-cy
                sat = math.min(math.sqrt(dx*dx+dy*dy)/(WH/2-4), 1)
                hue = (math.atan2(dy,dx) / (2*math.pi) + 0.5) % 1
                UpdateColor()
            end

            local wHit = wheelClip:FindFirstChildWhichIsA("TextButton")
            local bHit = briTrack:FindFirstChildWhichIsA("TextButton")
            if wHit then
                wHit.InputBegan:Connect(function(inp)
                    if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
                        dragW=true; PickWheel(inp.Position.X, inp.Position.Y)
                    end
                end)
            end
            if bHit then
                bHit.InputBegan:Connect(function(inp)
                    if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
                        dragB=true
                    end
                end)
            end
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
                    dragW=false; dragB=false
                end
            end)
            RunService.RenderStepped:Connect(function()
                if dragW then PickWheel(Mouse.X, Mouse.Y) end
                if dragB then
                    bri = math.clamp((Mouse.X-briTrack.AbsolutePosition.X)/briTrack.AbsoluteSize.X,0,1)
                    UpdateColor()
                end
            end)

            local hdrHit = New("TextButton", {
                Size=UDim2.new(1,0,0,46), BackgroundTransparency=1, Text="", ZIndex=c.ZIndex+4,
            }, c)
            hdrHit.MouseButton1Click:Connect(function()
                collapsed = not collapsed
                if not collapsed then
                    picker.Visible = true
                    Tween(c, {Size=UDim2.new(1,0,0,EXP_H)}, 0.28, Enum.EasingStyle.Quart)
                    Tween(chev, {Rotation=180}, 0.22)
                else
                    Tween(c, {Size=UDim2.new(1,0,0,46)}, 0.22, Enum.EasingStyle.Quart)
                    Tween(chev, {Rotation=0}, 0.22)
                    task.delay(0.22, function() if picker then picker.Visible=false end end)
                end
            end)

            local o = {CurrentColor=curColor}
            function o:Set(col)
                curColor=col; o.CurrentColor=col
                swatch.BackgroundColor3=col
                hue,sat,bri=col:ToHSV()
                UpdateColor()
                if cfg_.Callback then task.spawn(cfg_.Callback,col) end
            end
            return o
        end

        -- DROPDOWN
        function Tab:CreateDropdown(cfg_)
            local opts   = cfg_.Options or {}
            local multi  = cfg_.MultipleOptions or false
            local initS  = cfg_.CurrentOption or {}
            local selected = {}
            for _, v in ipairs(initS) do selected[v]=true end

            local open = false
            local c = Card(54)
            c.ZIndex = 5
            c.ClipsDescendants = false

            New("TextLabel", {
                Size=UDim2.new(1,-12,0,20), Position=UDim2.new(0,12,0,5),
                BackgroundTransparency=1, Text=cfg_.Name or "Dropdown",
                TextColor3=T.TextP, TextSize=12, Font=Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Left, ZIndex=6,
            }, c)

            local dbg = New("Frame", {
                Size=UDim2.new(1,-24,0,26), Position=UDim2.new(0,12,0,25),
                BackgroundColor3=T.BGS, BorderSizePixel=0, ZIndex=6,
            }, c)
            Round(dbg, 7)
            Stroke(dbg, T.Border, 1, 0.4)

            local dispLbl = New("TextLabel", {
                Size=UDim2.new(1,-28,1,0), Position=UDim2.new(0,8,0,0),
                BackgroundTransparency=1,
                Text=#initS>0 and table.concat(initS,", ") or "Select...",
                TextColor3=#initS>0 and T.TextP or T.TextM,
                TextSize=11, Font=Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Left,
                TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=7,
            }, dbg)

            local arrow = New("TextLabel", {
                Size=UDim2.new(0,16,1,0), Position=UDim2.new(1,-18,0,0),
                BackgroundTransparency=1, Text="v",
                TextColor3=T.TextM, TextSize=10, Font=Enum.Font.GothamBold,
                TextXAlignment=Enum.TextXAlignment.Center, ZIndex=7,
            }, dbg)

            -- List - parented to ROOT so it always floats above everything
            local _ddSG = New("ScreenGui", {
                ResetOnSpawn=false, ZIndexBehavior=Enum.ZIndexBehavior.Sibling,
                IgnoreGuiInset=true, DisplayOrder=999,
            }, ROOT)
            local listOuter = New("Frame", {
                Size=UDim2.new(0,100,0,0), BackgroundColor3=T.Panel,
                BorderSizePixel=0, ClipsDescendants=false, Visible=false,
            }, _ddSG)
            Round(listOuter, 9)
            Stroke(listOuter, T.Border, 1, 0.35)
            Shadow(listOuter)
            local listF = New("Frame", {
                Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
                BorderSizePixel=0, ClipsDescendants=true,
            }, listOuter)
            local ll = Instance.new("UIListLayout")
            ll.FillDirection = Enum.FillDirection.Vertical
            ll.HorizontalAlignment = Enum.HorizontalAlignment.Center
            ll.SortOrder = Enum.SortOrder.LayoutOrder
            ll.Parent = listF
            local lp = Instance.new("UIPadding")
            lp.PaddingTop=UDim.new(0,4); lp.PaddingBottom=UDim.new(0,4)
            lp.PaddingLeft=UDim.new(0,4); lp.PaddingRight=UDim.new(0,4)
            lp.Parent = listF

            local itemRefs = {}
            local listH = 0

            local function CloseDD()
                if not open then return end; open=false
                local w = listOuter.AbsoluteSize.X
                Tween(listOuter,{Size=UDim2.new(0,w,0,0)},0.16,Enum.EasingStyle.Quart)
                Tween(arrow,{Rotation=0},0.16)
                task.delay(0.17, function()
                    if not open then
                        listOuter.Visible=false
                        listOuter.Size=UDim2.new(0,100,0,0)
                    end
                end)
            end
            table.insert(Window._dropdowns, CloseDD)
            -- Clean up the floating ScreenGui when window closes
            local _origDestroy = Window.Destroy
            Window.Destroy = function(self)
                pcall(function() _ddSG:Destroy() end)
                _origDestroy(self)
            end

            local function UpdateDisplay()
                local keys={}
                for k,v in pairs(selected) do if v then table.insert(keys,k) end end
                dispLbl.Text = #keys>0 and table.concat(keys,", ") or "Select..."
                dispLbl.TextColor3 = #keys>0 and T.TextP or T.TextM
            end

            local function BuildList(optList)
                for _, ch in ipairs(listF:GetChildren()) do
                    if ch:IsA("TextButton") then ch:Destroy() end
                end
                itemRefs = {}
                for i, opt in ipairs(optList) do
                    local item = New("TextButton", {
                        Size=UDim2.new(1,0,0,32),
                        BackgroundColor3=selected[opt] and T.SurfaceH or T.Surface,
                        BorderSizePixel=0, Text="", AutoButtonColor=false,
                        ZIndex=202, LayoutOrder=i,
                    }, listF)
                    Round(item, 6)
                    local ilbl = New("TextLabel", {
                        Size=UDim2.new(1,-32,1,0), Position=UDim2.new(0,10,0,0),
                        BackgroundTransparency=1, Text=opt,
                        TextColor3=selected[opt] and T.TextA or T.TextP,
                        TextSize=12,
                        Font=selected[opt] and Enum.Font.GothamBold or Enum.Font.Gotham,
                        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=203,
                    }, item)
                    local ichk = New("Frame", {
                        Size=UDim2.new(0,14,0,14), Position=UDim2.new(1,-22,0.5,0),
                        AnchorPoint=Vector2.new(0,0.5), BackgroundColor3=T.Acc,
                        BackgroundTransparency=selected[opt] and 0 or 1,
                        BorderSizePixel=0, ZIndex=203,
                    }, item)
                    Round(ichk, 7)
                    itemRefs[opt] = {item=item, lbl=ilbl, chk=ichk}

                    item.MouseEnter:Connect(function()
                        if not selected[opt] then Tween(item,{BackgroundColor3=Qwenzy._T.SurfaceH},0.08) end
                    end)
                    item.MouseLeave:Connect(function()
                        if not selected[opt] then Tween(item,{BackgroundColor3=Qwenzy._T.Surface},0.08) end
                    end)
                    item.MouseButton1Click:Connect(function()
                        Ripple(item)
                        if multi then
                            selected[opt] = not selected[opt]
                        else
                            for k in pairs(selected) do selected[k]=false end
                            selected[opt] = true
                        end
                        for o2, refs in pairs(itemRefs) do
                            local s = selected[o2]==true
                            Tween(refs.item,{BackgroundColor3=s and Qwenzy._T.SurfaceH or Qwenzy._T.Surface},0.1)
                            Tween(refs.chk,{BackgroundTransparency=s and 0 or 1},0.1)
                            refs.lbl.TextColor3 = s and Qwenzy._T.TextA or Qwenzy._T.TextP
                            refs.lbl.Font = s and Enum.Font.GothamBold or Enum.Font.Gotham
                        end
                        UpdateDisplay()
                        local res={}
                        for k,v in pairs(selected) do if v then table.insert(res,k) end end
                        Qwenzy.Flags[cfg_.Flag or ""] = res
                        if cfg_.Callback then task.spawn(cfg_.Callback,res) end
                        if not multi then CloseDD() end
                    end)
                end
                listH = math.min(#optList,6)*32+8
            end

            BuildList(opts)

            local hdrHit = New("TextButton", {
                Size=UDim2.new(1,0,0,54), BackgroundTransparency=1, Text="", ZIndex=c.ZIndex+3,
            }, c)
            hdrHit.MouseButton1Click:Connect(function()
                open = not open
                if open then
                    -- Defer one frame so AbsolutePosition/Size are accurate
                    task.defer(function()
                        if not open then return end
                        local ap = c.AbsolutePosition
                        local as = c.AbsoluteSize
                        listOuter.Position = UDim2.new(0, ap.X, 0, ap.Y + as.Y + 4)
                        listOuter.Size = UDim2.new(0, as.X, 0, 0)
                        listOuter.Visible = true
                        listF.Size = UDim2.new(1,0,0,listH)
                        Tween(listOuter, {Size=UDim2.new(0,as.X,0,listH)}, 0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                        Tween(arrow,{Rotation=180},0.2)
                    end)
                else
                    CloseDD()
                end
            end)

            UserInputService.InputBegan:Connect(function(inp)
                if (inp.UserInputType==Enum.UserInputType.MouseButton1 or
                    inp.UserInputType==Enum.UserInputType.Touch) and open then
                    local mx,my=Mouse.X,Mouse.Y
                    local op,os=listOuter.AbsolutePosition,listOuter.AbsoluteSize
                    local cp,cs=c.AbsolutePosition,c.AbsoluteSize
                    if not(mx>=op.X and mx<=op.X+os.X and my>=op.Y and my<=op.Y+os.Y) and
                       not(mx>=cp.X and mx<=cp.X+cs.X and my>=cp.Y and my<=cp.Y+cs.Y) then
                        CloseDD()
                    end
                end
            end)

            local o = {CurrentOption=initS}
            function o:Refresh(newOpts)
                opts=newOpts; selected={}; BuildList(newOpts); UpdateDisplay()
            end
            function o:Set(newSel)
                for k in pairs(selected) do selected[k]=false end
                for _,v in ipairs(newSel) do selected[v]=true end
                o.CurrentOption=newSel; UpdateDisplay()
                for _, refs in pairs(itemRefs) do
                    local s = selected[refs.lbl.Text]==true
                    refs.item.BackgroundColor3 = s and T.SurfaceH or T.Surface
                    refs.chk.BackgroundTransparency = s and 0 or 1
                    refs.lbl.TextColor3 = s and T.TextA or T.TextP
                    refs.lbl.Font = s and Enum.Font.GothamBold or Enum.Font.Gotham
                end
                local res={}
                for k,v in pairs(selected) do if v then table.insert(res,k) end end
                Qwenzy.Flags[cfg_.Flag or ""] = res
                if cfg_.Callback then task.spawn(cfg_.Callback,res) end
            end
            return o
        end

        -- KEYBIND
        function Tab:CreateKeybind(cfg_)
            local curKey = cfg_.CurrentKeybind or "None"
            local listening = false
            Qwenzy.Flags[cfg_.Flag or ""] = curKey
            local c = Card(46)
            New("TextLabel", {
                Size=UDim2.new(1,-108,1,0), Position=UDim2.new(0,12,0,0),
                BackgroundTransparency=1, Text=cfg_.Name or "Keybind",
                TextColor3=T.TextP, TextSize=12, Font=Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Left, ZIndex=3,
            }, c)
            local badge = New("TextButton", {
                Size=UDim2.new(0,80,0,26), Position=UDim2.new(1,-92,0.5,0),
                AnchorPoint=Vector2.new(0,0.5), BackgroundColor3=T.BGS,
                BorderSizePixel=0, Text=curKey, TextColor3=T.TextA,
                TextSize=11, Font=Enum.Font.GothamBold, AutoButtonColor=false, ZIndex=4,
            }, c)
            Round(badge, 7)
            Stroke(badge, T.Border, 1, 0.35)
            badge.MouseButton1Click:Connect(function()
                if listening then return end
                listening=true; badge.Text="..."; badge.TextColor3=T.Warn
                Tween(badge,{BackgroundColor3=T.SurfaceH},0.12)
            end)
            UserInputService.InputBegan:Connect(function(inp, gp)
                if listening and inp.UserInputType==Enum.UserInputType.Keyboard then
                    listening=false; curKey=inp.KeyCode.Name
                    badge.Text=curKey; badge.TextColor3=T.TextA
                    Tween(badge,{BackgroundColor3=T.BGS},0.12)
                    Ripple(badge)
                    Qwenzy.Flags[cfg_.Flag or ""]=curKey
                    return
                end
                if not gp and not listening then
                    local kc=Enum.KeyCode[curKey]
                    if kc and inp.KeyCode==kc then
                        if cfg_.Callback then task.spawn(cfg_.Callback, false) end
                    end
                end
            end)
            HoverCard(c)
            local o = {CurrentKeybind=curKey}
            function o:Set(k) curKey=k; badge.Text=k; o.CurrentKeybind=k; Qwenzy.Flags[cfg_.Flag or ""]=k end
            return o
        end

        return Tab
    end -- CreateTab

    function Window:SetVisibility(v) self._main.Visible=v end
    function Window:IsVisible() return self._main.Visible end
    function Window:Destroy()
        for _, conn in ipairs(self._conns) do pcall(function() conn:Disconnect() end) end
        self._conns={}
        Tween(self._main,{Size=UDim2.new(0,WIN_W,0,0)},0.2,Enum.EasingStyle.Quart,Enum.EasingDirection.In)
        task.delay(0.2, function() pcall(function() self._sg:Destroy() end) end)
    end

    return Window
end -- CreateWindow

function Qwenzy:SetVisibility(v) for _,w in ipairs(self._windows) do pcall(function() w:SetVisibility(v) end) end end
function Qwenzy:Destroy() for _,w in ipairs(self._windows) do pcall(function() w:Destroy() end) end; self._windows={} end

-- ===================================================
--  CONFIG API
-- ===================================================
local _Cfg = ConfigManager.new("QwenzyUI", "Config")

function Qwenzy:SaveConfig(slot)
    local slots = _Cfg:Get("slots",{})
    local data = {}
    for k,v in pairs(self.Flags) do
        if type(v)=="boolean" or type(v)=="number" or type(v)=="string" then data[k]=v end
    end
    slots[slot]=data; _Cfg:Set("slots",slots)
end
function Qwenzy:LoadConfig(slot)
    local data = (_Cfg:Get("slots",{}))[slot]
    if not data then return false end
    for k,v in pairs(data) do self.Flags[k]=v end
    return true
end
function Qwenzy:DeleteConfig(slot)
    local s=_Cfg:Get("slots",{}); s[slot]=nil; _Cfg:Set("slots",s)
end
function Qwenzy:GetConfigSlots()
    local s=_Cfg:Get("slots",{}); local n={}
    for k in pairs(s) do table.insert(n,k) end
    table.sort(n); return n
end
function Qwenzy:GetConfig() return _Cfg end

return Qwenzy
