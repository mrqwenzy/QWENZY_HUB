    Round(barTrack, 3)
    local barFill = New("Frame", {
        Size=UDim2.new(0,0,1,0), BackgroundColor3=T.Acc,
        BorderSizePixel=0, ZIndex=106,
    }, barTrack)
    Round(barFill, 3)
    Grad(barFill, T.Acc, T.AccB, 90)
    -- Shimmer on bar
    local shimmer = New("Frame", {
        Size=UDim2.new(0,40,1,0), BackgroundColor3=Color3.fromRGB(255,255,255),
        BackgroundTransparency=0.7, BorderSizePixel=0, ZIndex=107,
    }, barFill)

    -- ── MINIGAME: Dodge the blocks ────────────────────
    -- Use known pixel sizes — don't rely on AbsoluteSize which is 0 before first render
    local GAME_W = CW - 48          -- gameArea pixel width
    local GAME_H = CH - barY - 90   -- gameArea pixel height
    local gameArea = New("Frame", {
        Size=UDim2.new(0,GAME_W,0,GAME_H),
        Position=UDim2.new(0,24,0,barY+18),
        BackgroundColor3=T.BG, BackgroundTransparency=0.55,
        BorderSizePixel=0, ZIndex=105, ClipsDescendants=true,
    }, card)
    Round(gameArea, 10)
    Stroke(gameArea, T.Border, 1, 0.5)

    New("TextLabel", {
        Size=UDim2.new(1,0,0,14), Position=UDim2.new(0,0,0,2),
        BackgroundTransparency=1,
        Text="🎮  DODGE  —  Arrow keys / WASD / touch drag",
        TextColor3=T.TextS, TextSize=9, Font=Enum.Font.Gotham,
        TextXAlignment=Enum.TextXAlignment.Center, ZIndex=108,
    }, gameArea)

    local PLAYER_W, PLAYER_H = 52, 11
    local playerPxX = (GAME_W - PLAYER_W) / 2   -- pixel X of paddle left edge
    local player = New("Frame", {
        Size=UDim2.new(0,PLAYER_W,0,PLAYER_H),
        Position=UDim2.new(0,playerPxX,0,GAME_H-PLAYER_H-6),
        BackgroundColor3=T.AccB, BorderSizePixel=0, ZIndex=109,
    }, gameArea)
    Round(player, 5)
    -- Glow outline on paddle
    local playerStroke = Instance.new("UIStroke")
    playerStroke.Color = T.Acc; playerStroke.Thickness=1.5; playerStroke.Transparency=0.2
    playerStroke.Parent = player

    local scoreLabel = New("TextLabel", {
        Size=UDim2.new(0,70,0,14), Position=UDim2.new(1,-74,0,2),
        BackgroundTransparency=1, Text="0 pts",
        TextColor3=T.TextA, TextSize=9, Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Right, ZIndex=108,
    }, gameArea)

    local gameScore   = 0
    local gameActive  = true
    local blocks      = {}
    local spawnTimer  = 0
    local spawnInterval = 0.85
    local PLAYER_SPEED  = 200   -- px/s

    local function SpawnBlock()
        if not gameActive then return end
        local bw  = math.random(28, 60)
        local bx  = math.random(2, math.max(3, GAME_W - bw - 2))
        local blk = New("Frame", {
            Size=UDim2.new(0,bw,0,10),
            Position=UDim2.new(0,bx,0,-14),
            BackgroundColor3=T.Err,
            BackgroundTransparency=0.15,
            BorderSizePixel=0, ZIndex=108,
        }, gameArea)
        Round(blk, 4)
        local bs = Instance.new("UIStroke")
        bs.Color=Color3.fromRGB(255,120,120); bs.Thickness=1; bs.Transparency=0.3
        bs.Parent=blk
        table.insert(blocks, {frame=blk, x=bx, y=-14, w=bw})
    end

    -- Touch drag
    local touchActive, touchStartX, touchStartPx = false, 0, 0
    gameArea.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.Touch then
            touchActive   = true
            touchStartX   = inp.Position.X
            touchStartPx  = playerPxX
        end
    end)
    gameArea.InputChanged:Connect(function(inp)
        if touchActive and inp.UserInputType == Enum.UserInputType.Touch then
            local dx = inp.Position.X - touchStartX
            playerPxX = math.clamp(touchStartPx + dx, 0, GAME_W - PLAYER_W)
        end
    end)
    gameArea.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.Touch then touchActive = false end
    end)

    local gameConn = RunService.RenderStepped:Connect(function(dt)
        if not gameActive then return end

        -- Keyboard movement (pixel/s)
        if UserInputService:IsKeyDown(Enum.KeyCode.Left)  or UserInputService:IsKeyDown(Enum.KeyCode.A) then
            playerPxX = math.clamp(playerPxX - PLAYER_SPEED * dt, 0, GAME_W - PLAYER_W)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Right) or UserInputService:IsKeyDown(Enum.KeyCode.D) then
            playerPxX = math.clamp(playerPxX + PLAYER_SPEED * dt, 0, GAME_W - PLAYER_W)
        end
        player.Position = UDim2.new(0, playerPxX, 0, GAME_H - PLAYER_H - 6)

        -- Spawn
        spawnTimer = spawnTimer + dt
        if spawnTimer >= spawnInterval then
            spawnTimer   = 0
            spawnInterval = math.max(0.3, spawnInterval - 0.025)
            SpawnBlock()
        end

        -- Move + collide
        local fallSpeed = 80 + gameScore * 1.5
        local playerTop = GAME_H - PLAYER_H - 6
        local toRemove = {}
        for i, b in ipairs(blocks) do
            b.y = b.y + fallSpeed * dt
            if b.frame and b.frame.Parent then
                b.frame.Position = UDim2.new(0, b.x, 0, b.y)
            end
            if b.y > GAME_H + 2 then
                -- escaped — point scored
                gameScore = gameScore + 1
                scoreLabel.Text = gameScore .. " pts"
                pcall(function() b.frame:Destroy() end)
                table.insert(toRemove, i)
            elseif b.y + 10 >= playerTop and b.y <= playerTop + PLAYER_H then
                -- overlap X?
                if b.x + b.w >= playerPxX and b.x <= playerPxX + PLAYER_W then
                    -- Hit — flash red
                    Tween(player, {BackgroundColor3=T.Err}, 0.04)
                    task.delay(0.18, function()
                        if player and player.Parent then
                            Tween(player, {BackgroundColor3=T.AccB}, 0.18)
                        end
                    end)
                    pcall(function() b.frame:Destroy() end)
                    table.insert(toRemove, i)
                end
            end
        end
        for i = #toRemove, 1, -1 do table.remove(blocks, toRemove[i]) end
    end)

    -- ── Hint label ────────────────────────────────────
    local hintLbl = New("TextLabel", {
        Size=UDim2.new(1,-48,0,14), Position=UDim2.new(0,24,1,-22),
        BackgroundTransparency=1, Text="Loading...",
        TextColor3=T.TextM, TextSize=10, Font=Enum.Font.Gotham,
        TextXAlignment=Enum.TextXAlignment.Center, ZIndex=105,
    }, card)

    -- ── Real loading steps ─────────────────────────────
    local steps = {
        { label="Connecting to services...",  pct=0.12, fn=function()
            pcall(function() game:GetService("Players").LocalPlayer:GetMouse() end)
        end},
        { label="Fetching icons...",          pct=0.28, fn=function() task.wait(0.08) end},
        { label="Applying glass theme...",    pct=0.44, fn=function() task.wait(0.06) end},
        { label="Building window...",         pct=0.60, fn=function() task.wait(0.06) end},
        { label="Loading saved config...",    pct=0.75, fn=function()
            pcall(function() ConfigManager.new("QwenzyUI","QwenzyConfig"):Load() end)
        end},
        { label="Preloading assets...",       pct=0.88, fn=function()
            pcall(function()
                game:GetService("ContentProvider"):PreloadAsync({"rbxassetid://6014261993"})
            end)
        end},
        { label="Ready!",                     pct=1.00, fn=function() task.wait(0.1) end},
    }

    local function SetProgress(pct, label)
        statusLbl.Text = label
        hintLbl.Text   = label
        Tween(barFill, {Size=UDim2.new(pct,0,1,0)}, 0.3, Enum.EasingStyle.Quart)
        task.delay(0.05, function()
            if shimmer and shimmer.Parent then
                shimmer.Position = UDim2.new(-0.15,0,0,0)
                Tween(shimmer, {Position=UDim2.new(1.1,0,0,0)}, 0.3, Enum.EasingStyle.Sine)
            end
        end)
    end

    -- Wait one frame so the ScreenGui renders before we start the game loop
    task.wait()

    -- Run steps on this thread (blocks here, game loop runs on RenderStepped)
    for _, step in ipairs(steps) do
        SetProgress(step.pct, step.label)
        pcall(step.fn)
        task.wait(0.08)
    end

    -- Done
    gameActive = false
    gameConn:Disconnect()
    pcall(function() orbitConn:Disconnect() end)
    -- clean up remaining blocks
    for _, b in ipairs(blocks) do pcall(function() b.frame:Destroy() end) end
    blocks = {}

    statusLbl.Text = "Score: " .. gameScore .. " pts — nice!"
    task.wait(0.4)

    Tween(bg,   {BackgroundTransparency=1}, 0.4)
    Tween(card, {Position=UDim2.new(0.5,0,0.35,0), BackgroundTransparency=1}, 0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    task.wait(0.4)
    sg:Destroy()
end

-- ===================================================
--  CREATE WINDOW
-- ===================================================
function Qwenzy:CreateWindow(cfg)
    for _, w in ipairs(self._windows) do pcall(function() w:Destroy() end) end
    self._windows = {}

    -- T is the global glass theme
    

    local conns = {}
    local function Track(c) table.insert(conns, c) return c end

    -- Blocking: runs loading screen (with minigame) then returns here
    ShowLoading(cfg.LoadingTitle, cfg.LoadingSubtitle, T)

    -- Main ScreenGui
    local sg = New("ScreenGui", {Name="QwenzyUI_Window", ResetOnSpawn=false,
        ZIndexBehavior=Enum.ZIndexBehavior.Sibling, IgnoreGuiInset=true}, ROOT)

    -- Responsive sizing
    local vp = workspace.CurrentCamera.ViewportSize
    local WIN_W = math.min(680, vp.X - 16)
    local WIN_H = math.min(440, vp.Y - 16)
    local SIDE_W = IsMobile and math.min(120, math.floor(WIN_W * 0.32)) or 174

    -- Main frame — glass dark background
    local main = New("Frame", {
        Name="Main",
        Size=UDim2.new(0, WIN_W, 0, 0),
        Position=UDim2.new(0, (vp.X - WIN_W)/2, 0, (vp.Y - WIN_H)/2),
        AnchorPoint=Vector2.new(0,0),
        BackgroundColor3=T.BG,
        BackgroundTransparency=0.08,
        BorderSizePixel=0,
        ClipsDescendants=true,
    }, sg)
    Round(main, 18)
    -- Outer glass border
    local mainStroke = Instance.new("UIStroke")
    mainStroke.Color = T.Acc
    mainStroke.Thickness = 1.2
    mainStroke.Transparency = 0.55
    mainStroke.Parent = main
    Shadow(main)
    -- Subtle inner gradient
    Grad(main, T.BGS, T.BG, 145)
    -- Top sheen (glass highlight)
    local mainSheen = New("Frame", {
        Size=UDim2.new(1,0,0.45,0), Position=UDim2.new(0,0,0,0),
        BackgroundColor3=Color3.fromRGB(255,255,255),
        BackgroundTransparency=0.97, BorderSizePixel=0, ZIndex=1,
    }, main)
    Round(mainSheen, 18)

    -- Topbar — glass panel
    local topbar = New("Frame", {
        Size=UDim2.new(1,0,0,52), BackgroundColor3=T.Top,
        BackgroundTransparency=0.18, BorderSizePixel=0, ZIndex=3,
    }, main)
    -- Topbar glass sheen
    New("Frame", {
        Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.fromRGB(255,255,255),
        BackgroundTransparency=0.93, BorderSizePixel=0, ZIndex=3,
    }, topbar)
    -- Bottom separator
    New("Frame", {Size=UDim2.new(1,0,0,1), Position=UDim2.new(0,0,1,-1),
        BackgroundColor3=T.Acc, BackgroundTransparency=0.7, BorderSizePixel=0, ZIndex=4}, topbar)
    -- Accent bar with glow effect
    local accLine = New("Frame", {Size=UDim2.new(1,0,0,2), BackgroundColor3=T.Acc, BorderSizePixel=0, ZIndex=4}, topbar)
    Grad(accLine, T.AccD, T.AccB, 90)
    -- Animated shimmer on accent bar
    local accShimmer = New("Frame", {
        Size=UDim2.new(0,80,1,0), Position=UDim2.new(-0.15,0,0,0),
        BackgroundColor3=Color3.fromRGB(255,255,255),
        BackgroundTransparency=0.6, BorderSizePixel=0, ZIndex=5,
    }, accLine)
    task.spawn(function()
        while accLine and accLine.Parent do
            accShimmer.Position = UDim2.new(-0.15,0,0,0)
            Tween(accShimmer, {Position=UDim2.new(1.15,0,0,0)}, 2.2, Enum.EasingStyle.Sine)
            task.wait(3.5)
        end
    end)

    -- Traffic lights (left side) — larger hit targets for touch
    local function WinDot(color, xOff)
        local dot = New("Frame", {
            Size=UDim2.new(0,13,0,13), Position=UDim2.new(0,xOff,0.5,0),
            AnchorPoint=Vector2.new(0,0.5), BackgroundColor3=color,
            BorderSizePixel=0, ZIndex=5,
        }, topbar)
        Round(dot, 7)
        -- Hit area is 44×44 minimum for touch (Apple HIG guideline)
        local hit = New("TextButton", {
            Size=UDim2.new(0,44,0,44), Position=UDim2.new(0.5,0,0.5,0),
            AnchorPoint=Vector2.new(0.5,0.5), BackgroundTransparency=1, Text="", ZIndex=6,
        }, dot)
        Track(hit.MouseEnter:Connect(function() Tween(dot, {Size=UDim2.new(0,15,0,15)}, 0.1) end))
        Track(hit.MouseLeave:Connect(function() Tween(dot, {Size=UDim2.new(0,13,0,13)}, 0.1) end))
        return dot, hit
    end
    local _, closeHit = WinDot(Color3.fromRGB(255,90,90), 14)
    local _, minimHit = WinDot(Color3.fromRGB(255,190,50), 32)
    local _, maximHit = WinDot(Color3.fromRGB(80,210,120), 50)

    -- Icon badge
    local iconBadge = New("Frame", {
        Size=UDim2.new(0,32,0,32), Position=UDim2.new(0,72,0.5,0),
        AnchorPoint=Vector2.new(0,0.5), BackgroundColor3=T.Acc,
        BackgroundTransparency=0.82, BorderSizePixel=0, ZIndex=4,
    }, topbar)
    Round(iconBadge, 9)
    if cfg.Icon and cfg.Icon ~= 0 then
        local ico = New("ImageLabel", {
            Size=UDim2.new(0,18,0,18), Position=UDim2.new(0.5,0,0.5,0),
            AnchorPoint=Vector2.new(0.5,0.5), BackgroundTransparency=1,
            ImageColor3=T.AccB, ZIndex=5,
        }, iconBadge)
        ApplyIcon(ico, cfg.Icon)
    else
        New("TextLabel", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
            Text="Q", TextColor3=T.AccB, TextSize=16, Font=Enum.Font.GothamBold,
            TextXAlignment=Enum.TextXAlignment.Center, ZIndex=5}, iconBadge)
    end

    New("TextLabel", {
        Size=UDim2.new(1,-240,0,20), Position=UDim2.new(0,114,0.5,0),
        AnchorPoint=Vector2.new(0,0.5), BackgroundTransparency=1,
        Text=cfg.Name or "QwenzyUI", TextColor3=T.TextP,
        TextSize=15, Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=4,
    }, topbar)

    -- Drag — supports both mouse and touch
    local dragging, dragX, dragY = false, 0, 0
    Track(topbar.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local px = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.X or Mouse.X
            local py = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.Y or Mouse.Y
            dragX = px - main.AbsolutePosition.X
            dragY = py - main.AbsolutePosition.Y
        end
    end))
    Track(UserInputService.InputChanged:Connect(function(inp)
        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement
                      or inp.UserInputType == Enum.UserInputType.Touch) then
            local vp2 = workspace.CurrentCamera.ViewportSize
            local px = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.X or Mouse.X
            local py = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.Y or Mouse.Y
            main.Position = UDim2.new(0,
                math.clamp(px - dragX, 0, vp2.X - main.AbsoluteSize.X),
                0,
                math.clamp(py - dragY, 0, vp2.Y - main.AbsoluteSize.Y))
        end
    end))
    Track(UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    -- Window controls
    local minimized, prevSz = false, nil
    closeHit.MouseButton1Click:Connect(function()
        Tween(main, {Size=UDim2.new(0,WIN_W,0,0)}, 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.25, function() sg:Destroy() end)
    end)
    minimHit.MouseButton1Click:Connect(function()
        if minimized then
            Tween(main, {Size=prevSz}, 0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            minimized = false
        else
            prevSz = main.Size
            Tween(main, {Size=UDim2.new(0,WIN_W,0,52)}, 0.22, Enum.EasingStyle.Quart)
            minimized = true
        end
    end)
    maximHit.MouseButton1Click:Connect(function()
        local vp2 = workspace.CurrentCamera.ViewportSize
        local w, h = math.min(vp2.X-16,1100), vp2.Y-16
        if main.Size.Y.Offset < WIN_H - 10 then
            Tween(main, {Size=UDim2.new(0,w,0,h), Position=UDim2.new(0,(vp2.X-w)/2,0,(vp2.Y-h)/2)}, 0.3)
        else
            local s = UDim2.new(0,WIN_W,0,WIN_H)
            Tween(main, {Size=s, Position=UDim2.new(0,(vp2.X-WIN_W)/2,0,(vp2.Y-WIN_H)/2)}, 0.3)
        end
    end)

    -- Toggle keybind (keyboard)
    if cfg.ToggleUIKeybind then
        local kc = typeof(cfg.ToggleUIKeybind)=="EnumItem" and cfg.ToggleUIKeybind or Enum.KeyCode[tostring(cfg.ToggleUIKeybind)]
        if kc then
            Track(UserInputService.InputBegan:Connect(function(inp, gp)
                if not gp and inp.KeyCode == kc then main.Visible = not main.Visible end
            end))
        end
    end

    -- Mobile toggle button — floating button to show/hide when no keyboard
    if IsMobile then
        local mToggleSG = New("ScreenGui", {
            Name="QwenzyMobileToggle", ResetOnSpawn=false,
            ZIndexBehavior=Enum.ZIndexBehavior.Sibling, IgnoreGuiInset=true,
            DisplayOrder=8000,
        }, ROOT)
        local mBtn = New("TextButton", {
            Size=UDim2.new(0,48,0,48),
            Position=UDim2.new(1,-60,1,-100),
            BackgroundColor3=T.Acc, BorderSizePixel=0,
            Text="Q", TextColor3=Color3.fromRGB(255,255,255),
            TextSize=18, Font=Enum.Font.GothamBold,
            AutoButtonColor=false, ZIndex=100,
        }, mToggleSG)
        Round(mBtn, 24)
        Stroke(mBtn, T.AccD, 2, 0.2)
        -- Make it draggable too
        local mDrag, mDX, mDY = false, 0, 0
        local mMoved = false
        mBtn.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.Touch
            or inp.UserInputType == Enum.UserInputType.MouseButton1 then
                mDrag = true; mMoved = false
                mDX = inp.Position.X - mBtn.AbsolutePosition.X
                mDY = inp.Position.Y - mBtn.AbsolutePosition.Y
            end
        end)
        UserInputService.InputChanged:Connect(function(inp)
            if mDrag and (inp.UserInputType == Enum.UserInputType.Touch
                       or inp.UserInputType == Enum.UserInputType.MouseMovement) then
                local vp2 = workspace.CurrentCamera.ViewportSize
                local px = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.X or Mouse.X
                local py = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.Y or Mouse.Y
                if math.abs(px - (mBtn.AbsolutePosition.X + mDX)) > 4
                or math.abs(py - (mBtn.AbsolutePosition.Y + mDY)) > 4 then
                    mMoved = true
                end
                mBtn.Position = UDim2.new(0,
                    math.clamp(px - mDX, 0, vp2.X - 48), 0,
                    math.clamp(py - mDY, 0, vp2.Y - 48))
            end
        end)
        UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.Touch
            or inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if mDrag and not mMoved then
                    main.Visible = not main.Visible
                    Tween(mBtn, {BackgroundColor3 = main.Visible and T.Acc or T.AccD}, 0.15)
                end
                mDrag = false
            end
        end)
    end

    -- Sidebar — glass panel
    local sidebar = New("Frame", {
        Name="Sidebar", Size=UDim2.new(0,SIDE_W,1,-52), Position=UDim2.new(0,0,0,52),
        BackgroundColor3=T.Tab, BackgroundTransparency=0.2,
        BorderSizePixel=0, ZIndex=2, ClipsDescendants=true,
    }, main)
    -- Glass sheen on sidebar
    New("Frame", {
        Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.fromRGB(255,255,255),
        BackgroundTransparency=0.96, BorderSizePixel=0, ZIndex=2,
    }, sidebar)
    -- Right edge glow
    New("Frame", {Size=UDim2.new(0,1,1,0), Position=UDim2.new(1,-1,0,0),
        BackgroundColor3=T.Acc, BackgroundTransparency=0.7, BorderSizePixel=0, ZIndex=3}, sidebar)

    local tabCont = New("ScrollingFrame", {
        Size=UDim2.new(1,0,1,-24), BackgroundTransparency=1,
        BorderSizePixel=0, ScrollBarThickness=0,
        CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y,
        ZIndex=3,
    }, sidebar)
    local tabLayout = Instance.new("UIListLayout")
    tabLayout.FillDirection = Enum.FillDirection.Vertical
    tabLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    tabLayout.Padding = UDim.new(0,2)
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Parent = tabCont
    local tabPad = Instance.new("UIPadding")
    tabPad.PaddingTop = UDim.new(0,8)
    tabPad.PaddingBottom = UDim.new(0,8)
    tabPad.PaddingLeft = UDim.new(0,6)
    tabPad.PaddingRight = UDim.new(0,6)
    tabPad.Parent = tabCont

    New("TextLabel", {
        Size=UDim2.new(1,0,0,20), Position=UDim2.new(0,0,1,-22),
        BackgroundTransparency=1, Text="QwenzyUI v"..Qwenzy.Version,
        TextColor3=T.TextM, TextSize=10, Font=Enum.Font.Gotham,
        TextXAlignment=Enum.TextXAlignment.Center, ZIndex=3,
    }, sidebar)

    -- Content
    local content = New("Frame", {
        Name="Content", Size=UDim2.new(1,-SIDE_W,1,-52), Position=UDim2.new(0,SIDE_W,0,52),
        BackgroundTransparency=1, BorderSizePixel=0, ClipsDescendants=true,
    }, main)

    -- Window object
    local Window = {
        _sg=sg, _main=main, _T=T, _conns=conns,
        _tabs={}, _activeTab=nil, _tabN=0,
        _dropdowns={},
    }

    table.insert(Qwenzy._windows, Window)

    -- -----------------------------------------------
    --  CREATE TAB
    -- -----------------------------------------------
    function Window:CreateTab(name, icon)
        self._tabN += 1
        local order = self._tabN
        local isFirst = order == 1

        local tabBtn = New("TextButton", {
            Size=UDim2.new(1,0,0, IsMobile and 48 or 40),
            BackgroundColor3=isFirst and T.SurfaceH or T.Tab,
            BackgroundTransparency=isFirst and 0.25 or 1,
            BorderSizePixel=0, Text="", AutoButtonColor=false,
            ZIndex=3, LayoutOrder=order,
        }, tabCont)
        Round(tabBtn, 10)
        -- Glass stroke on active tab
        local tabStroke = Instance.new("UIStroke")
        tabStroke.Color = T.Acc
        tabStroke.Thickness = 1
        tabStroke.Transparency = isFirst and 0.55 or 1
        tabStroke.Parent = tabBtn

        local ind = New("Frame", {
            Size=UDim2.new(0,4,0.65,0), Position=UDim2.new(0,1,0.175,0),
            BackgroundColor3=T.Acc, BackgroundTransparency=isFirst and 0 or 1,
            BorderSizePixel=0, ZIndex=4,
        }, tabBtn)
        Round(ind, 3)
        -- Gradient + glow on indicator
        Grad(ind, T.AccD, T.AccB, 180)
