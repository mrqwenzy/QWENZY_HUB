    local progressTrack = Instance.new("Frame")
    progressTrack.Size             = UDim2.new(1,-60,0,4)
    progressTrack.Position         = UDim2.new(0,30,0,178)
    progressTrack.BackgroundColor3 = T.BGSecondary
    progressTrack.BorderSizePixel  = 0
    progressTrack.ZIndex           = 103
    progressTrack.Parent           = center
    MakeRound(progressTrack, 2)

    local progressFill = Instance.new("Frame")
    progressFill.Size             = UDim2.new(0,0,1,0)
    progressFill.BackgroundColor3 = T.Accent
    progressFill.BorderSizePixel  = 0
    progressFill.ZIndex           = 104
    progressFill.Parent           = progressTrack
    MakeRound(progressFill, 2)
    MakeGradient(progressFill, T.Accent, T.AccentLight, 90)

    -- Version
    local versionLabel = Instance.new("TextLabel")
    versionLabel.Size              = UDim2.new(1,0,0,18)
    versionLabel.Position          = UDim2.new(0,0,0,196)
    versionLabel.BackgroundTransparency = 1
    versionLabel.Text              = "NexusUI v" .. Nexus.Version
    versionLabel.TextColor3        = T.TextMuted
    versionLabel.TextSize          = 11
    versionLabel.Font              = Enum.Font.Gotham
    versionLabel.TextXAlignment    = Enum.TextXAlignment.Center
    versionLabel.ZIndex            = 103
    versionLabel.Parent            = center

    -- Animate in
    center.Position = UDim2.new(0.5,0,0.6,0)
    center.BackgroundTransparency = 1
    Tween(center, {
        Position = UDim2.new(0.5,0,0.5,0),
        BackgroundTransparency = 0
    }, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    -- Progress animation
    local pulseThread = task.spawn(function()
        while center and center.Parent do
            pulseGlow()
        end
    end)

    Tween(progressFill, {Size = UDim2.new(1,0,1,0)}, 2.0, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
    task.wait(2.2)

    -- Fade out
    task.cancel(pulseThread)
    Tween(backdrop, {BackgroundTransparency = 1}, 0.4)
    Tween(center, {BackgroundTransparency = 1}, 0.4)
    task.wait(0.4)
    screenGui:Destroy()
end

