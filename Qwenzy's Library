local feedbackCooldown = false
local PrevFeedback     = "Empty"

local function sendFeedback(feedbackText)
    local HttpService       = game:GetService("HttpService")
    local MarketplaceService = game:GetService("MarketplaceService")

    local reqFunc  = request or (syn and syn.request) or http_request
    local player   = Players.LocalPlayer
    local userId   = player.UserId
    local placeId  = game.PlaceId

    if feedbackCooldown then
        Qwenzy:Notify({
            Title    = "Cooldown",
            Content  = "Please wait before sending another feedback.",
            Duration = 6.5,
            Image    = "timer",
        })
        return
    end

    if not feedbackText or feedbackText == "" or feedbackText == PrevFeedback then
        Qwenzy:Notify({
            Title    = "Empty Feedback",
            Content  = "Feedback cannot be empty.",
            Duration = 6.5,
            Image    = "rewind",
        })
        return
    end

    if #feedbackText > 1000 then
        Qwenzy:Notify({
            Title    = "Too Long",
            Content  = "Feedback must be under 1000 characters.",
            Duration = 6.5,
            Image    = "text-cursor",
        })
        return
    end

    feedbackCooldown = true

    local gameName = "Unknown"
    pcall(function()
        gameName = MarketplaceService:GetProductInfo(placeId).Name
    end)

    local avatarUrl = ""
    pcall(function()
        local r = reqFunc({
            Url    = "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="
                  .. userId .. "&size=420x420&format=Png",
            Method = "GET",
        })
        avatarUrl = HttpService:JSONDecode(r.Body).data[1].imageUrl
    end)

    local ok = pcall(function()
        reqFunc({
            Url     = "https://discord.com/api/webhooks/1484996114590597370/4UF3tOjm5YIus7-rC6AGQ0tXWw0FOm69jUo95X6XsHECez_vfG9o8Lh429b2CicZCzvR",
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body    = HttpService:JSONEncode({
                ["embeds"] = {
                    {
                        ["title"]     = "📝 Feedback Received",
                        ["color"]     = tonumber(0x57F287),
                        ["thumbnail"] = { ["url"] = avatarUrl },
                        ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ"),
                        ["fields"]    = {
                            { ["name"] = "👤 Display Name", ["value"] = player.DisplayName,    ["inline"] = true  },
                            { ["name"] = "🔖 Username",     ["value"] = "@" .. player.Name,    ["inline"] = true  },
                            { ["name"] = "🆔 User ID",      ["value"] = tostring(userId),       ["inline"] = true  },
                            { ["name"] = "🎮 Game",         ["value"] = gameName,               ["inline"] = true  },
                            { ["name"] = "📌 Place ID",     ["value"] = tostring(placeId),      ["inline"] = true  },
                            { ["name"] = "** **",           ["value"] = "** **",                ["inline"] = false },
                            {
                                ["name"]   = "💬 Feedback",
                                ["value"]  = "```\n" .. feedbackText .. "\n```",
                                ["inline"] = false,
                            },
                        },
                        ["footer"] = { ["text"] = "Feedback • " .. gameName },
                    },
                },
            }),
        })
    end)

    if ok then
        Qwenzy:Notify({ Title = "Feedback Sent", Content = "Thank you!", Duration = 6.5, Image = "send" })
        PrevFeedback = feedbackText
    else
        Qwenzy:Notify({
            Title    = "Failed",
            Content  = "Could not send feedback, please try again.",
            Duration = 6.5,
            Image    = "wifi-off",
        })
        feedbackCooldown = false
        return
    end

    task.delay(360, function()
        feedbackCooldown = false
        Qwenzy:Notify({
            Title    = "Feedback Ready",
            Content  = "You can now send feedback again.",
            Duration = 6.5,
            Image    = "check-circle",
        })
    end)
end

