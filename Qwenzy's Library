local function getMoveKey(moveName)
    local button = Players.LocalPlayer.PlayerGui.Main.Moveset:FindFirstChild(moveName)
    if button then
        local key = button:FindFirstChild("Key")
        if key then
            return Enum.KeyCode[KeyNames[tonumber(key.Text)]]
        end
    end
    return nil
end

local character = function()
    return Players.LocalPlayer.Character or Players.LocalPlayer.CharacterAdded:Wait()
end

local characters = workspace:FindFirstChild("Characters")

local function GetClosestCharacter(maxDist)
    local myChar = character()
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local closest, closestDist = nil, maxDist

    if characters then
        for _, model in ipairs(characters:GetChildren()) do
            if model == myChar then continue end
            local root = model:FindFirstChild("HumanoidRootPart")
            local hum  = model:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = (root.Position - myRoot.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest     = model
                end
            end
        end
    end

    return closest, closestDist
end

local function DashBehindTarget(target, duration)
    duration = duration or 0.3
    local myChar = character()
    if not myChar or not target then return end

    local myRoot    = myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = target:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return end

    local humanoid = myChar:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.AutoRotate = false end

    local cam               = workspace.CurrentCamera
    local radius            = 4
    local maxPlayerRotSpeed = math.rad(120)
    local startPos          = myRoot.Position
    local heightY           = myRoot.Position.Y
    local elapsed           = 0
    local playerAngleOffset = 0
    local lastMousePos      = UserInputService:GetMouseLocation()

    local startAngle = (function()
        local off = myRoot.Position - targetRoot.Position
        return math.atan2(off.X, off.Z)
    end)()

    local smoothStartPos = startPos
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        elapsed = elapsed + dt
        local alpha = math.min(elapsed / duration, 1)

        local targetPos  = targetRoot.Position
        local targetLook = targetRoot.CFrame.LookVector
        local goalAngle  = math.atan2(-targetLook.X, -targetLook.Z)
        local delta      = (goalAngle - startAngle + math.pi) % (2 * math.pi) - math.pi

        local remaining    = 1 - alpha
        local urgency      = math.abs(delta) / math.pi
        local boostedAlpha = math.min(alpha + urgency * remaining * dt * 6, 1)
        local t            = boostedAlpha * boostedAlpha * (3 - 2 * boostedAlpha)

        local currentMousePos = UserInputService:GetMouseLocation()
        local mouseDeltaX     = currentMousePos.X - lastMousePos.X
        lastMousePos = currentMousePos

        local rotDelta      = math.clamp(mouseDeltaX * 0.003, -maxPlayerRotSpeed * dt, maxPlayerRotSpeed * dt)
        playerAngleOffset   = playerAngleOffset + rotDelta
        local finalAngle    = startAngle + delta * t + playerAngleOffset

        local arcPos = targetPos + Vector3.new(
            math.sin(finalAngle) * radius,
            heightY - targetPos.Y,
            math.cos(finalAngle) * radius
        )

        smoothStartPos = smoothStartPos:Lerp(myRoot.Position, dt * 4)
        local lerpedPos = smoothStartPos:Lerp(arcPos, t)

        myRoot.CFrame = CFrame.lookAt(lerpedPos, Vector3.new(targetPos.X, lerpedPos.Y, targetPos.Z))

        cam.CameraType = Enum.CameraType.Scriptable
        local back   = -myRoot.CFrame.LookVector
        local camPos = myRoot.Position + back * 10 + Vector3.new(0, 5, 0)
        cam.CFrame   = CFrame.new(camPos, targetPos + Vector3.new(0, 2, 0))

        if alpha >= 1 then
            conn:Disconnect()
            if humanoid then humanoid.AutoRotate = true end
            cam.CameraType = Enum.CameraType.Custom
        end
    end)

    task.wait(duration)
end

