                Tween(track, {BackgroundColor3=v and Qwenzy._T.TOn or Qwenzy._T.TOff}, 0.2)
                Tween(knob, {Position=v and UDim2.new(0,23,0.5,0) or UDim2.new(0,3,0.5,0)}, 0.22)
                Qwenzy.Flags[cfg_.Flag or ""] = v
