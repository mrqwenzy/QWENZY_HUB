        -- SLIDER
        function Tab:CreateSlider(cfg_)
            local minV = cfg_.Range and cfg_.Range[1] or 0
            local maxV = cfg_.Range and cfg_.Range[2] or 100
            local incr = cfg_.Increment or 1
            local suf  = cfg_.Suffix or ""
            local val  = cfg_.CurrentValue or minV
            Qwenzy.Flags[cfg_.Flag or ""] = val

            -- Taller card on mobile so the track has more finger room
            local c = Card(IsMobile and 72 or 62)
            New("TextLabel", {
                Size=UDim2.new(0.65,0,0,22), Position=UDim2.new(0,14,0,8),
                BackgroundTransparency=1, Text=cfg_.Name or "Slider",
                TextColor3=T.TextP, TextSize=13, Font=Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Left, ZIndex=3,
            }, c)
            local valLbl = New("TextLabel", {
                Size=UDim2.new(0.35,-14,0,22), Position=UDim2.new(0.65,0,0,8),
                BackgroundTransparency=1, Text=tostring(val).." "..suf,
                TextColor3=T.TextA, TextSize=13, Font=Enum.Font.GothamBold,
                TextXAlignment=Enum.TextXAlignment.Right, ZIndex=3,
            }, c)

            -- Thicker track on mobile (easier to see & tap)
            local trackH = IsMobile and 8 or 6
            local trackY = IsMobile and 44 or 39
            local tbg = New("Frame", {
                Size=UDim2.new(1,-28,0,trackH), Position=UDim2.new(0,14,0,trackY),
                BackgroundColor3=T.BGS, BorderSizePixel=0, ZIndex=3,
            }, c)
            Round(tbg, trackH/2)
            local pct = (val-minV)/(maxV-minV)
            local tfill = New("Frame", {
                Size=UDim2.new(pct,0,1,0), BackgroundColor3=T.Acc, BorderSizePixel=0, ZIndex=4,
            }, tbg)
            Round(tfill, trackH/2)
            Grad(tfill, T.Acc, T.AccB, 90)

            -- Bigger knob on mobile
            local knobSz = IsMobile and 24 or 16
            local tknob = New("Frame", {
                Size=UDim2.new(0,knobSz,0,knobSz), Position=UDim2.new(pct,0,0.5,0),
                AnchorPoint=Vector2.new(0.5,0.5), BackgroundColor3=Color3.fromRGB(255,255,255),
                BorderSizePixel=0, ZIndex=5,
            }, tbg)
            Round(tknob, knobSz/2)
            Stroke(tknob, T.Acc, 2, 0.15)

            local draggingS = false
            local function Update(mx)
                local relX = math.clamp(mx - tbg.AbsolutePosition.X, 0, tbg.AbsoluteSize.X)
                local p = relX / tbg.AbsoluteSize.X
                local raw = minV + p*(maxV-minV)
                local stepped = math.clamp(math.round(raw/incr)*incr, minV, maxV)
                if stepped == val then return end
                val = stepped
                local np = (stepped-minV)/(maxV-minV)
                Tween(tfill, {Size=UDim2.new(np,0,1,0)}, 0.04)
                Tween(tknob, {Position=UDim2.new(np,0,0.5,0)}, 0.04)
                valLbl.Text = tostring(stepped).." "..suf
                Qwenzy.Flags[cfg_.Flag or ""] = stepped
                if cfg_.Callback then task.spawn(cfg_.Callback, stepped) end
            end

            -- Large invisible hit area — covers the full card height for easy touch
            local shb = New("TextButton", {
                Size=UDim2.new(1,0,1,0), Position=UDim2.new(0,0,0,0),
                BackgroundTransparency=1, Text="", ZIndex=6,
            }, c)

            -- Start drag on mouse OR touch
            shb.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1
                or inp.UserInputType == Enum.UserInputType.Touch then
                    draggingS = true
                    local bigSz = knobSz + 6
                    Tween(tknob, {Size=UDim2.new(0,bigSz,0,bigSz)}, 0.1, Enum.EasingStyle.Back)
                    local px = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.X or Mouse.X
                    Update(px)
                end
            end)

            Track(UserInputService.InputEnded:Connect(function(inp)
                if (inp.UserInputType == Enum.UserInputType.MouseButton1
                 or inp.UserInputType == Enum.UserInputType.Touch) and draggingS then
                    draggingS = false
                    Tween(tknob, {Size=UDim2.new(0,knobSz,0,knobSz)}, 0.12)
                end
            end))

            Track(RunService.RenderStepped:Connect(function()
                if draggingS then Update(CursorX()) end
            end))

            local o = {CurrentValue=val}
            function o:Set(v)
                v=math.clamp(v,minV,maxV); val=v; o.CurrentValue=v
                local np=(v-minV)/(maxV-minV)
                Tween(tfill,{Size=UDim2.new(np,0,1,0)},0.2)
                Tween(tknob,{Position=UDim2.new(np,0,0.5,0)},0.2)
                valLbl.Text=tostring(v).." "..suf
                Qwenzy.Flags[cfg_.Flag or ""]=v
                if cfg_.Callback then task.spawn(cfg_.Callback,v) end
            end
            return o
        end

