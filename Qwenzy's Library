--[[
  QwenzyUI v3.0 - Module Version
  
  Usage:
    local Qwenzy = loadstring(game:HttpGet("YOUR_RAW_URL"))()
  
  Then:
    local Window = Qwenzy:CreateWindow({...})
    local Tab = Window:CreateTab("Main", "home")
    Tab:CreateButton({...})
    etc.
  
  Full API:
    Qwenzy:CreateWindow(cfg) -> Window
    Qwenzy:Notify(cfg)
    Qwenzy:SetVisibility(bool)
    Qwenzy:Destroy()
    Qwenzy.Flags  -- table of all element values
    Qwenzy.Version
    
    Window:CreateTab(name, icon) -> Tab
    Window:SetVisibility(bool)
    Window:IsVisible() -> bool
    Window:Destroy()
    
    Tab:CreateSection(name)
    Tab:CreateDivider()
    Tab:CreateLabel(text, icon, color)
    Tab:CreateParagraph({Title, Content})
    Tab:CreateButton({Name, Callback})
    Tab:CreateToggle({Name, CurrentValue, Flag, Callback})
    Tab:CreateSlider({Name, Range, Increment, Suffix, CurrentValue, Flag, Callback})
    Tab:CreateInput({Name, CurrentValue, PlaceholderText, Flag, Callback})
    Tab:CreateColorPicker({Name, Color, Flag, Callback})
    Tab:CreateDropdown({Name, Options, CurrentOption, MultipleOptions, Flag, Callback})
    Tab:CreateKeybind({Name, CurrentKeybind, Flag, Callback})
    
    Qwenzy.Themes  -- table of all themes, add custom ones
    Qwenzy:ApplyTheme(name)  -- live theme swap
    Qwenzy:GetConfig() -> ConfigManager
]]

