        end

        local function Card(h, auto)
            local c = New("Frame", {
                Size=UDim2.new(1,0,0,h or 50),
                BackgroundColor3=T.Surface,
                BackgroundTransparency=0.25,
                BorderSizePixel=0,
                ZIndex=2, LayoutOrder=NextN(),
                AutomaticSize=auto and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
            }, page)
            Round(c, 12)
            -- Glass border
            local cs = Instance.new("UIStroke")
            cs.Color = T.Border
            cs.Thickness = 1
            cs.Transparency = 0.45
            cs.Parent = c
            -- Top sheen line
            New("Frame", {
                Size=UDim2.new(1,-24,0,1), Position=UDim2.new(0,12,0,1),
                BackgroundColor3=Color3.fromRGB(255,255,255),
                BackgroundTransparency=0.82, BorderSizePixel=0, ZIndex=3,
            }, c)
            -- Store stroke for hover glow
            c:SetAttribute("_stroke_id", cs ~= nil)
            rawset(c, "_qs", cs)
            return c
        end

        local function HoverHit(c)
            local hit = New("TextButton", {
                Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=c.ZIndex+5,
            }, c)
            local cs = rawget(c, "_qs")
            if not IsMobile then
                hit.MouseEnter:Connect(function()
                    Tween(c, {BackgroundColor3=T.SurfaceH, BackgroundTransparency=0.12}, 0.15)
                    if cs then Tween(cs, {Color=T.Acc, Transparency=0.2}, 0.15) end
                end)
                hit.MouseLeave:Connect(function()
                    Tween(c, {BackgroundColor3=T.Surface, BackgroundTransparency=0.25}, 0.2)
                    if cs then Tween(cs, {Color=T.Border, Transparency=0.45}, 0.2) end
                end)
            end
            if IsMobile then
                hit.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.Touch then
                        Tween(c, {BackgroundColor3=T.SurfaceH, BackgroundTransparency=0.12}, 0.08)
                        if cs then Tween(cs, {Color=T.Acc, Transparency=0.2}, 0.08) end
                    end
                end)
                hit.InputEnded:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.Touch then
                        task.delay(0.15, function()
                            Tween(c, {BackgroundColor3=T.Surface, BackgroundTransparency=0.25}, 0.15)
                            if cs then Tween(cs, {Color=T.Border, Transparency=0.45}, 0.15) end
                        end)
                    end
                end)
            end
            return hit
        end

