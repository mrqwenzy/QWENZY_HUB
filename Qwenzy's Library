        AnchorPoint=Vector2.new(0.5,0.5), BackgroundColor3=T.Surface,
        BorderSizePixel=0, ZIndex=102,
    }, sg)
    Round(card, 20)
    Stroke(card, T.Border, 1, 0.5)
    Shadow(card)

    local strip = New("Frame", {Size=UDim2.new(1,0,0,3), BackgroundColor3=T.Acc, BorderSizePixel=0, ZIndex=103}, card)
    Grad(strip, T.AccD, T.AccB, 90)

    local logoRing = New("Frame", {
        Size=UDim2.new(0,58,0,58), Position=UDim2.new(0.5,0,0,20),
        AnchorPoint=Vector2.new(0.5,0), BackgroundColor3=T.Acc,
        BackgroundTransparency=0.75, BorderSizePixel=0, ZIndex=103,
    }, card)
    Round(logoRing, 29)
    local logoIn = New("Frame", {
        Size=UDim2.new(0,38,0,38), Position=UDim2.new(0.5,0,0.5,0),
        AnchorPoint=Vector2.new(0.5,0.5), BackgroundColor3=T.AccB,
        BorderSizePixel=0, ZIndex=104,
    }, logoRing)
    Round(logoIn, 19)
    New("TextLabel", {
        Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
        Text="Q", TextColor3=Color3.fromRGB(255,255,255),
        TextSize=20, Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Center, ZIndex=105,
    }, logoIn)

    task.spawn(function()
        while logoRing and logoRing.Parent do
            Tween(logoRing, {BackgroundTransparency=0.5, Size=UDim2.new(0,68,0,68), Position=UDim2.new(0.5,0,0,15)}, 1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(1)
            Tween(logoRing, {BackgroundTransparency=0.75, Size=UDim2.new(0,58,0,58), Position=UDim2.new(0.5,0,0,20)}, 1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(1)
        end
    end)

    New("TextLabel", {Size=UDim2.new(1,-40,0,24), Position=UDim2.new(0,20,0,94),
        BackgroundTransparency=1, Text=title or "QwenzyUI",
        TextColor3=T.TextP, TextSize=18, Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Center, ZIndex=103}, card)
    local sub = New("TextLabel", {Size=UDim2.new(1,-40,0,18), Position=UDim2.new(0,20,0,120),
        BackgroundTransparency=1, Text=subtitle or "Loading...",
        TextColor3=T.TextS, TextSize=13, Font=Enum.Font.Gotham,
        TextXAlignment=Enum.TextXAlignment.Center, ZIndex=103}, card)

    local track = New("Frame", {Size=UDim2.new(1,-48,0,4), Position=UDim2.new(0,24,0,158),
        BackgroundColor3=T.BGS, BorderSizePixel=0, ZIndex=103}, card)
    Round(track, 2)
    local fill = New("Frame", {Size=UDim2.new(0,0,1,0), BackgroundColor3=T.Acc, BorderSizePixel=0, ZIndex=104}, track)
    Round(fill, 2)
    Grad(fill, T.Acc, T.AccB, 90)

    local msgs = {"Initializing...","Loading assets...","Building UI...","Almost ready..."}
    task.spawn(function()
        for _, m in ipairs(msgs) do
            task.wait(0.45)
            if sub and sub.Parent then sub.Text = m end
        end
    end)

    card.Position = UDim2.new(0.5,0,0.6,0)
    Tween(card, {Position=UDim2.new(0.5,0,0.5,0)}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    Tween(fill, {Size=UDim2.new(1,0,1,0)}, 1.9, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)

    task.wait(2.1)
    Tween(bg, {BackgroundTransparency=1}, 0.3)
    Tween(card, {BackgroundTransparency=1}, 0.3)
    task.wait(0.3)
    sg:Destroy()
end

-- ===================================================
--  CREATE WINDOW
-- ===================================================
function Qwenzy:CreateWindow(cfg)
    for _, w in ipairs(self._windows) do pcall(function() w:Destroy() end) end
    self._windows = {}

    local T = (cfg.Theme and Themes[cfg.Theme]) or Themes.Default
    self._T = T

    local conns = {}
    local function Track(c) table.insert(conns, c) return c end

    -- Show loading
    ShowLoading(cfg.LoadingTitle, cfg.LoadingSubtitle, T)

    -- Main ScreenGui
    local sg = New("ScreenGui", {Name="QwenzyUI_Window", ResetOnSpawn=false,
        ZIndexBehavior=Enum.ZIndexBehavior.Sibling, IgnoreGuiInset=true}, ROOT)

    -- Responsive sizing
    local vp = workspace.CurrentCamera.ViewportSize
    local WIN_W = math.min(680, vp.X - 16)
    local WIN_H = math.min(440, vp.Y - 16)
    local SIDE_W = IsMobile and math.min(120, math.floor(WIN_W * 0.32)) or 174

    -- Main frame
    local main = New("Frame", {
        Name="Main",
        Size=UDim2.new(0, WIN_W, 0, 0),
        Position=UDim2.new(0, (vp.X - WIN_W)/2, 0, (vp.Y - WIN_H)/2),
        AnchorPoint=Vector2.new(0,0),
        BackgroundColor3=T.BG, BorderSizePixel=0,
        ClipsDescendants=true,
    }, sg)
    Round(main, 16)
    Stroke(main, T.Border, 1, 0.4)
    Shadow(main)
    Grad(main, T.BGS, T.BG, 150)

    -- Topbar
    local topbar = New("Frame", {
        Size=UDim2.new(1,0,0,52), BackgroundColor3=T.Top, BorderSizePixel=0, ZIndex=3,
    }, main)
    New("Frame", {Size=UDim2.new(1,0,0,1), Position=UDim2.new(0,0,1,-1),
        BackgroundColor3=T.Border, BackgroundTransparency=0.5, BorderSizePixel=0, ZIndex=4}, topbar)

    local accLine = New("Frame", {Size=UDim2.new(1,0,0,2), BackgroundColor3=T.Acc, BorderSizePixel=0, ZIndex=4}, topbar)
    Grad(accLine, T.AccD, T.AccB, 90)

    -- Traffic lights (left side) — larger hit targets for touch
    local function WinDot(color, xOff)
        local dot = New("Frame", {
            Size=UDim2.new(0,13,0,13), Position=UDim2.new(0,xOff,0.5,0),
            AnchorPoint=Vector2.new(0,0.5), BackgroundColor3=color,
            BorderSizePixel=0, ZIndex=5,
        }, topbar)
        Round(dot, 7)
        -- Hit area is 44×44 minimum for touch (Apple HIG guideline)
        local hit = New("TextButton", {
            Size=UDim2.new(0,44,0,44), Position=UDim2.new(0.5,0,0.5,0),
            AnchorPoint=Vector2.new(0.5,0.5), BackgroundTransparency=1, Text="", ZIndex=6,
        }, dot)
        Track(hit.MouseEnter:Connect(function() Tween(dot, {Size=UDim2.new(0,15,0,15)}, 0.1) end))
        Track(hit.MouseLeave:Connect(function() Tween(dot, {Size=UDim2.new(0,13,0,13)}, 0.1) end))
        return dot, hit
    end
    local _, closeHit = WinDot(Color3.fromRGB(255,90,90), 14)
    local _, minimHit = WinDot(Color3.fromRGB(255,190,50), 32)
    local _, maximHit = WinDot(Color3.fromRGB(80,210,120), 50)

    -- Icon badge
    local iconBadge = New("Frame", {
        Size=UDim2.new(0,32,0,32), Position=UDim2.new(0,72,0.5,0),
        AnchorPoint=Vector2.new(0,0.5), BackgroundColor3=T.Acc,
        BackgroundTransparency=0.82, BorderSizePixel=0, ZIndex=4,
    }, topbar)
    Round(iconBadge, 9)
    if cfg.Icon and cfg.Icon ~= 0 then
        local ico = New("ImageLabel", {
            Size=UDim2.new(0,18,0,18), Position=UDim2.new(0.5,0,0.5,0),
            AnchorPoint=Vector2.new(0.5,0.5), BackgroundTransparency=1,
            ImageColor3=T.AccB, ZIndex=5,
        }, iconBadge)
        ApplyIcon(ico, cfg.Icon)
    else
        New("TextLabel", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
            Text="Q", TextColor3=T.AccB, TextSize=16, Font=Enum.Font.GothamBold,
            TextXAlignment=Enum.TextXAlignment.Center, ZIndex=5}, iconBadge)
    end

    New("TextLabel", {
        Size=UDim2.new(1,-240,0,20), Position=UDim2.new(0,114,0.5,0),
        AnchorPoint=Vector2.new(0,0.5), BackgroundTransparency=1,
        Text=cfg.Name or "QwenzyUI", TextColor3=T.TextP,
        TextSize=15, Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=4,
    }, topbar)

    -- Drag — supports both mouse and touch
    local dragging, dragX, dragY = false, 0, 0
    Track(topbar.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local px = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.X or Mouse.X
            local py = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.Y or Mouse.Y
            dragX = px - main.AbsolutePosition.X
            dragY = py - main.AbsolutePosition.Y
        end
    end))
    Track(UserInputService.InputChanged:Connect(function(inp)
        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement
                      or inp.UserInputType == Enum.UserInputType.Touch) then
            local vp2 = workspace.CurrentCamera.ViewportSize
            local px = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.X or Mouse.X
            local py = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.Y or Mouse.Y
            main.Position = UDim2.new(0,
                math.clamp(px - dragX, 0, vp2.X - main.AbsoluteSize.X),
                0,
                math.clamp(py - dragY, 0, vp2.Y - main.AbsoluteSize.Y))
        end
    end))
    Track(UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    -- Window controls
    local minimized, prevSz = false, nil
    closeHit.MouseButton1Click:Connect(function()
        Tween(main, {Size=UDim2.new(0,WIN_W,0,0)}, 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.25, function() sg:Destroy() end)
    end)
    minimHit.MouseButton1Click:Connect(function()
        if minimized then
            Tween(main, {Size=prevSz}, 0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            minimized = false
        else
            prevSz = main.Size
            Tween(main, {Size=UDim2.new(0,WIN_W,0,52)}, 0.22, Enum.EasingStyle.Quart)
            minimized = true
        end
    end)
    maximHit.MouseButton1Click:Connect(function()
        local vp2 = workspace.CurrentCamera.ViewportSize
        local w, h = math.min(vp2.X-16,1100), vp2.Y-16
        if main.Size.Y.Offset < WIN_H - 10 then
            Tween(main, {Size=UDim2.new(0,w,0,h), Position=UDim2.new(0,(vp2.X-w)/2,0,(vp2.Y-h)/2)}, 0.3)
        else
            local s = UDim2.new(0,WIN_W,0,WIN_H)
            Tween(main, {Size=s, Position=UDim2.new(0,(vp2.X-WIN_W)/2,0,(vp2.Y-WIN_H)/2)}, 0.3)
        end
    end)

    -- Toggle keybind (keyboard)
    if cfg.ToggleUIKeybind then
        local kc = typeof(cfg.ToggleUIKeybind)=="EnumItem" and cfg.ToggleUIKeybind or Enum.KeyCode[tostring(cfg.ToggleUIKeybind)]
        if kc then
            Track(UserInputService.InputBegan:Connect(function(inp, gp)
                if not gp and inp.KeyCode == kc then main.Visible = not main.Visible end
            end))
        end
    end

    -- Mobile toggle button — floating button to show/hide when no keyboard
    if IsMobile then
        local mToggleSG = New("ScreenGui", {
            Name="QwenzyMobileToggle", ResetOnSpawn=false,
            ZIndexBehavior=Enum.ZIndexBehavior.Sibling, IgnoreGuiInset=true,
            DisplayOrder=8000,
        }, ROOT)
        local mBtn = New("TextButton", {
            Size=UDim2.new(0,48,0,48),
            Position=UDim2.new(1,-60,1,-100),
            BackgroundColor3=T.Acc, BorderSizePixel=0,
            Text="Q", TextColor3=Color3.fromRGB(255,255,255),
            TextSize=18, Font=Enum.Font.GothamBold,
            AutoButtonColor=false, ZIndex=100,
        }, mToggleSG)
        Round(mBtn, 24)
        Stroke(mBtn, T.AccD, 2, 0.2)
        -- Make it draggable too
        local mDrag, mDX, mDY = false, 0, 0
        local mMoved = false
        mBtn.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.Touch
            or inp.UserInputType == Enum.UserInputType.MouseButton1 then
                mDrag = true; mMoved = false
                mDX = inp.Position.X - mBtn.AbsolutePosition.X
                mDY = inp.Position.Y - mBtn.AbsolutePosition.Y
            end
        end)
        UserInputService.InputChanged:Connect(function(inp)
            if mDrag and (inp.UserInputType == Enum.UserInputType.Touch
                       or inp.UserInputType == Enum.UserInputType.MouseMovement) then
                local vp2 = workspace.CurrentCamera.ViewportSize
                local px = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.X or Mouse.X
                local py = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.Y or Mouse.Y
                if math.abs(px - (mBtn.AbsolutePosition.X + mDX)) > 4
                or math.abs(py - (mBtn.AbsolutePosition.Y + mDY)) > 4 then
                    mMoved = true
                end
                mBtn.Position = UDim2.new(0,
                    math.clamp(px - mDX, 0, vp2.X - 48), 0,
                    math.clamp(py - mDY, 0, vp2.Y - 48))
            end
        end)
        UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.Touch
            or inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if mDrag and not mMoved then
                    main.Visible = not main.Visible
                    Tween(mBtn, {BackgroundColor3 = main.Visible and Qwenzy._T.Acc or Qwenzy._T.AccD}, 0.15)
                end
                mDrag = false
            end
        end)
    end

    -- Sidebar
    local sidebar = New("Frame", {
        Name="Sidebar", Size=UDim2.new(0,SIDE_W,1,-52), Position=UDim2.new(0,0,0,52),
        BackgroundColor3=T.Tab, BorderSizePixel=0, ZIndex=2, ClipsDescendants=true,
    }, main)
    New("Frame", {Size=UDim2.new(0,1,1,0), Position=UDim2.new(1,-1,0,0),
        BackgroundColor3=T.Border, BackgroundTransparency=0.5, BorderSizePixel=0, ZIndex=3}, sidebar)

    local tabCont = New("ScrollingFrame", {
        Size=UDim2.new(1,0,1,-24), BackgroundTransparency=1,
        BorderSizePixel=0, ScrollBarThickness=0,
        CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y,
        ZIndex=3,
    }, sidebar)
    local tabLayout = Instance.new("UIListLayout")
    tabLayout.FillDirection = Enum.FillDirection.Vertical
    tabLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    tabLayout.Padding = UDim.new(0,2)
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Parent = tabCont
    local tabPad = Instance.new("UIPadding")
    tabPad.PaddingTop = UDim.new(0,8)
    tabPad.PaddingBottom = UDim.new(0,8)
    tabPad.PaddingLeft = UDim.new(0,6)
    tabPad.PaddingRight = UDim.new(0,6)
    tabPad.Parent = tabCont

    New("TextLabel", {
        Size=UDim2.new(1,0,0,20), Position=UDim2.new(0,0,1,-22),
        BackgroundTransparency=1, Text="QwenzyUI v"..Qwenzy.Version,
        TextColor3=T.TextM, TextSize=10, Font=Enum.Font.Gotham,
        TextXAlignment=Enum.TextXAlignment.Center, ZIndex=3,
    }, sidebar)

    -- Content
    local content = New("Frame", {
        Name="Content", Size=UDim2.new(1,-SIDE_W,1,-52), Position=UDim2.new(0,SIDE_W,0,52),
        BackgroundTransparency=1, BorderSizePixel=0, ClipsDescendants=true,
    }, main)

    -- Window object
    local Window = {
        _sg=sg, _main=main, _T=T, _conns=conns,
        _tabs={}, _activeTab=nil, _tabN=0,
        _dropdowns={},
    }

    table.insert(Qwenzy._windows, Window)

    -- -----------------------------------------------
    --  CREATE TAB
    -- -----------------------------------------------
    function Window:CreateTab(name, icon)
        self._tabN += 1
        local order = self._tabN
        local isFirst = order == 1

        local tabBtn = New("TextButton", {
            Size=UDim2.new(1,0,0, IsMobile and 48 or 40),
            BackgroundColor3=isFirst and T.SurfaceH or T.Tab,
            BackgroundTransparency=isFirst and 0 or 1,
            BorderSizePixel=0, Text="", AutoButtonColor=false,
            ZIndex=3, LayoutOrder=order,
        }, tabCont)
        Round(tabBtn, 10)

        local ind = New("Frame", {
            Size=UDim2.new(0,3,0.6,0), Position=UDim2.new(0,0,0.2,0),
            BackgroundColor3=T.Acc, BackgroundTransparency=isFirst and 0 or 1,
            BorderSizePixel=0, ZIndex=4,
        }, tabBtn)
        Round(ind, 2)
        if isFirst then Grad(ind, T.Acc, T.AccB, 180) end

        -- On mobile narrow sidebar: icon only (no text label)
        local iconOnly = IsMobile and SIDE_W < 140

        local icoOff = 12
        if icon and icon ~= 0 then
            local icoX = iconOnly and UDim2.new(0.5,0,0.5,0) or UDim2.new(0,12,0.5,0)
            local icoAnchor = iconOnly and Vector2.new(0.5,0.5) or Vector2.new(0,0.5)
            local ico = New("ImageLabel", {
                Size=UDim2.new(0,18,0,18), Position=icoX,
                AnchorPoint=icoAnchor, BackgroundTransparency=1,
                ImageColor3=isFirst and T.AccB or T.TextM, ZIndex=4,
            }, tabBtn)
            ApplyIcon(ico, icon)
            icoOff = 36
        end

        local lbl
        if not iconOnly then
            lbl = New("TextLabel", {
                Size=UDim2.new(1,-icoOff-6,1,0), Position=UDim2.new(0,icoOff,0,0),
                BackgroundTransparency=1, Text=name,
                TextColor3=isFirst and T.TextA or T.TextM,
                TextSize= IsMobile and 11 or 13,
                Font=isFirst and Enum.Font.GothamBold or Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Left, ZIndex=4,
            }, tabBtn)
        end

        local page = New("ScrollingFrame", {
            Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
            BorderSizePixel=0, ScrollBarThickness=3,
            ScrollBarImageColor3=T.Acc, ScrollBarImageTransparency=0.45,
            CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y,
            Visible=isFirst,
        }, content)
        local pageLayout = Instance.new("UIListLayout")
        pageLayout.FillDirection = Enum.FillDirection.Vertical
        pageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        pageLayout.Padding = UDim.new(0,5)
        pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        pageLayout.Parent = page
        local pagePad = Instance.new("UIPadding")
        pagePad.PaddingTop = UDim.new(0,12)
        pagePad.PaddingBottom = UDim.new(0,18)
        pagePad.PaddingLeft = UDim.new(0,12)
        pagePad.PaddingRight = UDim.new(0,12)
        pagePad.Parent = page

        local Tab = {_page=page, _btn=tabBtn, _ind=ind, _lbl=lbl, _T=T, _n=0}
        table.insert(self._tabs, Tab)
        if isFirst then self._activeTab = Tab end

        tabBtn.MouseButton1Click:Connect(function()
            Ripple(tabBtn)
            if self._activeTab == Tab then return end
            for _, fn in ipairs(self._dropdowns) do pcall(fn) end
            if self._activeTab then
                local old = self._activeTab
                Tween(old._btn, {BackgroundTransparency=1}, 0.18)
                Tween(old._ind, {BackgroundTransparency=1}, 0.18)
                if old._lbl then Tween(old._lbl, {TextColor3=T.TextM}, 0.18); old._lbl.Font = Enum.Font.Gotham end
                old._page.Visible = false
            end
            self._activeTab = Tab
            page.Visible = true
            page.Position = UDim2.new(0.04,0,0,0)
            Tween(page, {Position=UDim2.new(0,0,0,0)}, 0.2, Enum.EasingStyle.Quart)
            Tween(tabBtn, {BackgroundTransparency=0, BackgroundColor3=T.SurfaceH}, 0.2)
            Tween(ind, {BackgroundTransparency=0}, 0.2)
            if lbl then Tween(lbl, {TextColor3=T.TextA}, 0.2); lbl.Font = Enum.Font.GothamBold end
            for _, c in ipairs(tabBtn:GetChildren()) do
                if c:IsA("ImageLabel") then Tween(c, {ImageColor3=T.AccB}, 0.2) end
            end
        end)

        tabBtn.MouseEnter:Connect(function()
            if not IsMobile and self._activeTab ~= Tab then
                Tween(tabBtn, {BackgroundTransparency=0.85, BackgroundColor3=Qwenzy._T.SurfaceH}, 0.15)
            end
        end)
        tabBtn.MouseLeave:Connect(function()
            if not IsMobile and self._activeTab ~= Tab then
                Tween(tabBtn, {BackgroundTransparency=1}, 0.15)
            end
        end)

        -- -----------------------------------------------
        --  ELEMENT HELPERS
        -- -----------------------------------------------
        local function NextN()
            Tab._n += 1
            return Tab._n
        end

        local function Card(h, auto)
            local c = New("Frame", {
                Size=UDim2.new(1,0,0,h or 50),
                BackgroundColor3=T.Surface, BorderSizePixel=0,
                ZIndex=2, LayoutOrder=NextN(),
                AutomaticSize=auto and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
            }, page)
            Round(c, 11)
            Stroke(c, T.Border, 1, 0.65)
            return c
        end

        local function HoverHit(c)
            local hit = New("TextButton", {
                Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=c.ZIndex+5,
            }, c)
            if not IsMobile then
                hit.MouseEnter:Connect(function() Tween(c, {BackgroundColor3=Qwenzy._T.SurfaceH}, 0.15) end)
                hit.MouseLeave:Connect(function() Tween(c, {BackgroundColor3=Qwenzy._T.Surface}, 0.15) end)
            end
            -- Touch: flash highlight on tap then revert
            if IsMobile then
                hit.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.Touch then
                        Tween(c, {BackgroundColor3=Qwenzy._T.SurfaceH}, 0.08)
                    end
                end)
                hit.InputEnded:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.Touch then
                        task.delay(0.15, function() Tween(c, {BackgroundColor3=Qwenzy._T.Surface}, 0.15) end)
                    end
                end)
            end
            return hit
        end

        local function NameLbl(c, text)
            return New("TextLabel", {
                Size=UDim2.new(1,-70,1,0), Position=UDim2.new(0,14,0,0),
                BackgroundTransparency=1, Text=text,
                TextColor3=T.TextP, TextSize=13, Font=Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Left, ZIndex=3,
            }, c)
        end

        -- SECTION
        function Tab:CreateSection(name)
            Tab._n += 1
            local f = New("Frame", {
                Size=UDim2.new(1,0,0,22), BackgroundTransparency=1,
                BorderSizePixel=0, LayoutOrder=Tab._n,
            }, page)
            New("Frame", {
                Size=UDim2.new(0,4,0,4), Position=UDim2.new(0,2,0.5,-2),
                BackgroundColor3=T.Acc, BorderSizePixel=0, ZIndex=2,
            }, f)
            New("TextLabel", {
                Size=UDim2.new(1,-14,1,0), Position=UDim2.new(0,12,0,0),
                BackgroundTransparency=1, Text=name:upper(),
                TextColor3=T.TextM, TextSize=10, Font=Enum.Font.GothamBold,
                TextXAlignment=Enum.TextXAlignment.Left, ZIndex=2,
            }, f)
            New("Frame", {
