                nameL.TextSize          = 13
                nameL.Font              = Enum.Font.Gotham
                nameL.TextXAlignment    = Enum.TextXAlignment.Left
                nameL.Parent            = card

                -- Swatch preview
                local swatch = Instance.new("Frame")
                swatch.Size             = UDim2.new(0,34,0,24)
                swatch.Position         = UDim2.new(1,-50,0.5,0)
                swatch.AnchorPoint      = Vector2.new(0,0.5)
                swatch.BackgroundColor3 = initColor
                swatch.BorderSizePixel  = 0
                swatch.Parent           = card
                MakeRound(swatch, 6)
                MakeStroke(swatch, T.Border, 1, 0.4)

                -- Expanded picker (simplified HSV)
                local pickerFrame = Instance.new("Frame")
                pickerFrame.Size             = UDim2.new(1,-28,0,0)
                pickerFrame.Position         = UDim2.new(0,14,0,50)
                pickerFrame.BackgroundTransparency = 1
                pickerFrame.ClipsDescendants = true
                pickerFrame.Visible          = false
                pickerFrame.Parent           = card

                local hue, sat, val_ = initColor:ToHSV()

                -- Saturation-Value picker box
                local svBox = Instance.new("ImageLabel")
                svBox.Size        = UDim2.new(1,0,0,120)
                svBox.BackgroundColor3 = Color3.fromHSV(hue,1,1)
                svBox.Image       = "rbxassetid://4155801252"
                svBox.ScaleType   = Enum.ScaleType.Stretch
                svBox.Parent      = pickerFrame
                MakeRound(svBox, 6)

                -- Hue bar
                local hueBar = Instance.new("ImageLabel")
                hueBar.Size   = UDim2.new(1,0,0,16)
                hueBar.Position = UDim2.new(0,0,0,128)
                hueBar.Image  = "rbxassetid://698073928"
                hueBar.ScaleType = Enum.ScaleType.Stretch
                hueBar.BackgroundColor3 = Color3.fromRGB(255,255,255)
                hueBar.Parent = pickerFrame
                MakeRound(hueBar, 4)

                -- SV cursor
                local svCursor = Instance.new("Frame")
                svCursor.Size             = UDim2.new(0,12,0,12)
                svCursor.AnchorPoint      = Vector2.new(0.5,0.5)
                svCursor.Position         = UDim2.new(sat,0,1-val_,0)
                svCursor.BackgroundColor3 = Color3.fromRGB(255,255,255)
                svCursor.BorderSizePixel  = 0
                svCursor.ZIndex           = svBox.ZIndex + 1
                svCursor.Parent           = svBox
                MakeRound(svCursor, 6)
                MakeStroke(svCursor, Color3.fromRGB(0,0,0), 1, 0.5)

                -- Hue cursor
                local hueCursor = Instance.new("Frame")
                hueCursor.Size             = UDim2.new(0,6,1,4)
                hueCursor.AnchorPoint      = Vector2.new(0.5,0.5)
                hueCursor.Position         = UDim2.new(hue,0,0.5,0)
                hueCursor.BackgroundColor3 = Color3.fromRGB(255,255,255)
                hueCursor.BorderSizePixel  = 0
                hueCursor.ZIndex           = hueBar.ZIndex + 1
                hueCursor.Parent           = hueBar
                MakeRound(hueCursor, 2)

                local currentColor = initColor

                local function UpdateColor()
                    currentColor = Color3.fromHSV(hue, sat, val_)
                    swatch.BackgroundColor3 = currentColor
                    svBox.BackgroundColor3  = Color3.fromHSV(hue,1,1)
                    if configSave and config_.Flag then
                        configSave:Set(config_.Flag, {
                            math.floor(currentColor.R*255),
                            math.floor(currentColor.G*255),
                            math.floor(currentColor.B*255)
                        })
                    end
                    if Nexus.Flags and config_.Flag then Nexus.Flags[config_.Flag] = currentColor end
                    if config_.Callback then task.spawn(config_.Callback, currentColor) end
                end

                local draggingSV, draggingH = false, false

                local svHit = Instance.new("TextButton")
                svHit.Size = UDim2.new(1,0,1,0)
                svHit.BackgroundTransparency = 1
                svHit.Text = ""
                svHit.ZIndex = svBox.ZIndex + 2
                svHit.Parent = svBox
                svHit.MouseButton1Down:Connect(function() draggingSV = true end)

                local hHit = Instance.new("TextButton")
                hHit.Size = UDim2.new(1,0,1,0)
                hHit.BackgroundTransparency = 1
                hHit.Text = ""
                hHit.ZIndex = hueBar.ZIndex + 2
                hHit.Parent = hueBar
                hHit.MouseButton1Down:Connect(function() draggingH = true end)

                UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then
                        draggingSV = false
                        draggingH  = false
                    end
                end)
                RunService.RenderStepped:Connect(function()
                    if draggingSV then
                        local relX = math.clamp(Mouse.X - svBox.AbsolutePosition.X, 0, svBox.AbsoluteSize.X)
                        local relY = math.clamp(Mouse.Y - svBox.AbsolutePosition.Y, 0, svBox.AbsoluteSize.Y)
                        sat  = relX / svBox.AbsoluteSize.X
                        val_ = 1 - relY / svBox.AbsoluteSize.Y
                        svCursor.Position = UDim2.new(sat,0,1-val_,0)
                        UpdateColor()
                    end
                    if draggingH then
                        local relX = math.clamp(Mouse.X - hueBar.AbsolutePosition.X, 0, hueBar.AbsoluteSize.X)
                        hue = relX / hueBar.AbsoluteSize.X
                        hueCursor.Position = UDim2.new(hue,0,0.5,0)
                        UpdateColor()
                    end
                end)

                -- Toggle expand
                local headerHit = Instance.new("TextButton")
                headerHit.Size = UDim2.new(1,0,0,46)
                headerHit.BackgroundTransparency = 1
                headerHit.Text = ""
                headerHit.ZIndex = card.ZIndex + 2
                headerHit.Parent = card
                headerHit.MouseButton1Click:Connect(function()
                    collapsed = not collapsed
                    if not collapsed then
                        pickerFrame.Visible = true
                        Tween(card, {Size=UDim2.new(1,0,0,220)}, 0.3, Enum.EasingStyle.Quart)
                    else
                        Tween(card, {Size=UDim2.new(1,0,0,46)}, 0.25, Enum.EasingStyle.Quart)
                        task.delay(0.25, function() if collapsed then pickerFrame.Visible = false end end)
                    end
                end)
                HoverCard(card, T.Surface, T.SurfaceHover)

                local CPObj = {CurrentColor = currentColor}
                function CPObj:Set(c)
                    currentColor = c
                    CPObj.CurrentColor = c
                    swatch.BackgroundColor3 = c
                    hue, sat, val_ = c:ToHSV()
                    svBox.BackgroundColor3  = Color3.fromHSV(hue,1,1)
                    svCursor.Position = UDim2.new(sat,0,1-val_,0)
                    hueCursor.Position = UDim2.new(hue,0,0.5,0)
                    if config_.Callback then task.spawn(config_.Callback, c) end
                end
                return CPObj
            end

            -- ═══════════════════════════════════════
            --  Input (TextBox)
