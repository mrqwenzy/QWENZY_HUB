            -- ═══════════════════════════════════════
            --  Dropdown
            -- ═══════════════════════════════════════
            function Tab:CreateDropdown(config_)
                self._itemOrder = (self._itemOrder or 0) + 1
                local opts    = config_.Options or {}
                local multi   = config_.MultipleOptions or false
                local initSel = config_.CurrentOption or {}
                if configSave and config_.Flag then
                    local saved = configSave:Get(config_.Flag, nil)
                    if saved then initSel = saved end
                end
                if Nexus.Flags and config_.Flag then
                    Nexus.Flags[config_.Flag] = initSel
                end

                local selected = {}
                for _, v in ipairs(initSel) do selected[v] = true end

                local open = false
                local card = BaseCard(self, 56)
                card.LayoutOrder     = self._itemOrder
                card.ClipsDescendants = false
                card.ZIndex          = 5

                local nameL = Instance.new("TextLabel")
                nameL.Size              = UDim2.new(0.6,0,0,22)
                nameL.Position          = UDim2.new(0,14,0,8)
                nameL.BackgroundTransparency = 1
                nameL.Text              = config_.Name or "Dropdown"
                nameL.TextColor3        = T.TextPrimary
                nameL.TextSize          = 13
                nameL.Font              = Enum.Font.Gotham
                nameL.TextXAlignment    = Enum.TextXAlignment.Left
                nameL.Parent            = card

                -- Selected display box
                local dispBG = Instance.new("Frame")
                dispBG.Size             = UDim2.new(1,-28,0,28)
                dispBG.Position         = UDim2.new(0,14,0,30)
                dispBG.BackgroundColor3 = T.BGSecondary
                dispBG.BorderSizePixel  = 0
                dispBG.ZIndex           = 5
                dispBG.Parent           = card
                MakeRound(dispBG, 8)
                MakeStroke(dispBG, T.Border, 1, 0.5)

                local dispLabel = Instance.new("TextLabel")
                dispLabel.Size              = UDim2.new(1,-36,1,0)
                dispLabel.Position          = UDim2.new(0,10,0,0)
                dispLabel.BackgroundTransparency = 1
                dispLabel.Text              = #initSel > 0 and table.concat(initSel,", ") or "Select..."
                dispLabel.TextColor3        = #initSel > 0 and T.TextPrimary or T.TextMuted
                dispLabel.TextSize          = 12
                dispLabel.Font              = Enum.Font.Gotham
                dispLabel.TextXAlignment    = Enum.TextXAlignment.Left
                dispLabel.TextTruncate      = Enum.TextTruncate.AtEnd
                dispLabel.ZIndex            = 6
                dispLabel.Parent            = dispBG

                local arrow = Instance.new("ImageLabel")
                arrow.Size             = UDim2.new(0,16,0,16)
                arrow.Position         = UDim2.new(1,-22,0.5,0)
                arrow.AnchorPoint      = Vector2.new(0,0.5)
                arrow.BackgroundTransparency = 1
                arrow.Image            = "rbxassetid://" .. tostring(Icons["chevron-down"])
                arrow.ImageColor3      = T.TextMuted
                arrow.ZIndex           = 6
                arrow.Parent           = dispBG

                -- Dropdown list (appears below card)
                local listFrame = Instance.new("Frame")
                listFrame.Size             = UDim2.new(1,-28,0,0)
                listFrame.Position         = UDim2.new(0,14,1,4)
                listFrame.BackgroundColor3 = T.Panel
                listFrame.BorderSizePixel  = 0
                listFrame.ZIndex           = 20
                listFrame.ClipsDescendants = true
                listFrame.Visible          = false
                listFrame.Parent           = card
                MakeRound(listFrame, 10)
                MakeStroke(listFrame, T.Border, 1, 0.5)
                Shadow(listFrame, 20)

                local listLayout = Instance.new("UIListLayout")
                listLayout.FillDirection = Enum.FillDirection.Vertical
                listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
                listLayout.SortOrder   = Enum.SortOrder.LayoutOrder
                listLayout.Parent      = listFrame
                MakePadding(listFrame, 4, 4, 4, 4)

                local function UpdateDisplay()
                    local keys = {}
                    for k,v in pairs(selected) do if v then table.insert(keys,k) end end
                    if #keys > 0 then
                        dispLabel.Text = table.concat(keys, ", ")
                        dispLabel.TextColor3 = T.TextPrimary
                    else
                        dispLabel.Text = "Select..."
                        dispLabel.TextColor3 = T.TextMuted
                    end
                end

                local function BuildList(optList)
                    for _, child in ipairs(listFrame:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end

                    for i, opt in ipairs(optList) do
                        local item = Instance.new("TextButton")
                        item.Size             = UDim2.new(1,0,0,32)
                        item.BackgroundColor3 = selected[opt] and T.SurfaceHover or T.Surface
                        item.BackgroundTransparency = selected[opt] and 0 or 0
                        item.BorderSizePixel  = 0
                        item.Text             = ""
                        item.AutoButtonColor  = false
                        item.ZIndex           = 21
                        item.LayoutOrder      = i
                        item.Parent           = listFrame
                        MakeRound(item, 7)

                        local checkIcon = Instance.new("Frame")
                        checkIcon.Size             = UDim2.new(0,16,0,16)
                        checkIcon.Position         = UDim2.new(1,-24,0.5,0)
                        checkIcon.AnchorPoint      = Vector2.new(0,0.5)
                        checkIcon.BackgroundColor3 = T.Accent
                        checkIcon.BackgroundTransparency = selected[opt] and 0 or 1
                        checkIcon.BorderSizePixel  = 0
                        checkIcon.ZIndex           = 22
                        checkIcon.Parent           = item
                        MakeRound(checkIcon, 8)

                        local itemL = Instance.new("TextLabel")
                        itemL.Size              = UDim2.new(1,-34,1,0)
                        itemL.Position          = UDim2.new(0,10,0,0)
                        itemL.BackgroundTransparency = 1
                        itemL.Text              = opt
                        itemL.TextColor3        = selected[opt] and T.TextAccent or T.TextPrimary
                        itemL.TextSize          = 13
                        itemL.Font              = selected[opt] and Enum.Font.GothamBold or Enum.Font.Gotham
                        itemL.TextXAlignment    = Enum.TextXAlignment.Left
                        itemL.ZIndex            = 22
                        itemL.Parent            = item

                        item.MouseEnter:Connect(function()
                            if not selected[opt] then
                                Tween(item, {BackgroundColor3=T.SurfaceHover}, 0.15)
                            end
                        end)
                        item.MouseLeave:Connect(function()
                            if not selected[opt] then
                                Tween(item, {BackgroundColor3=T.Surface}, 0.15)
                            end
                        end)
                        item.MouseButton1Click:Connect(function()
                            if multi then
                                selected[opt] = not selected[opt]
                            else
                                for k in pairs(selected) do selected[k] = false end
                                selected[opt] = true
                            end
                            Tween(checkIcon, {BackgroundTransparency= selected[opt] and 0 or 1}, 0.15)
                            Tween(itemL, {TextColor3= selected[opt] and T.TextAccent or T.TextPrimary}, 0.15)
                            itemL.Font = selected[opt] and Enum.Font.GothamBold or Enum.Font.Gotham
                            UpdateDisplay()

                            local result = {}
                            for k,v in pairs(selected) do if v then table.insert(result,k) end end
                            if configSave and config_.Flag then configSave:Set(config_.Flag, result) end
                            if Nexus.Flags and config_.Flag then Nexus.Flags[config_.Flag] = result end
                            if config_.Callback then task.spawn(config_.Callback, result) end

                            if not multi then
                                open = false
                                Tween(listFrame, {Size=UDim2.new(1,-28,0,0)}, 0.2, Enum.EasingStyle.Quart)
                                Tween(arrow, {Rotation=0}, 0.2)
                                task.delay(0.2, function() listFrame.Visible = false end)
                            end
                        end)
                    end

                    -- Set height
                    local h = math.min(#optList, 6) * 36 + 8
                    return h
                end

                local listH = BuildList(opts)

                local headerHit = Instance.new("TextButton")
                headerHit.Size = UDim2.new(1,0,0,56)
                headerHit.BackgroundTransparency = 1
                headerHit.Text = ""
                headerHit.ZIndex = card.ZIndex + 3
                headerHit.Parent = card

                headerHit.MouseButton1Click:Connect(function()
                    open = not open
                    if open then
                        listFrame.Visible = true
                        listFrame.Size = UDim2.new(1,-28,0,0)
                        Tween(listFrame, {Size=UDim2.new(1,-28,0,listH)}, 0.25, Enum.EasingStyle.Quart)
                        Tween(arrow, {Rotation=180}, 0.25)
                    else
                        Tween(listFrame, {Size=UDim2.new(1,-28,0,0)}, 0.2, Enum.EasingStyle.Quart)
                        Tween(arrow, {Rotation=0}, 0.2)
                        task.delay(0.2, function() if not open then listFrame.Visible = false end end)
                    end
                end)

                HoverCard(card, T.Surface, T.SurfaceHover)

                local DDObj = {CurrentOption = initSel}
                function DDObj:Refresh(newOpts)
                    opts = newOpts
                    selected = {}
                    listH = BuildList(newOpts)
                    UpdateDisplay()
                end
                function DDObj:Set(newSel)
                    for k in pairs(selected) do selected[k] = false end
                    for _, v in ipairs(newSel) do selected[v] = true end
                    DDObj.CurrentOption = newSel
                    UpdateDisplay()
                    local result = {}
                    for k,v in pairs(selected) do if v then table.insert(result,k) end end
                    if configSave and config_.Flag then configSave:Set(config_.Flag, result) end
                    if Nexus.Flags and config_.Flag then Nexus.Flags[config_.Flag] = result end
                    if config_.Callback then task.spawn(config_.Callback, result) end
                end
                return DDObj
            end

            -- ═══════════════════════════════════════
            --  Keybind
            -- ═══════════════════════════════════════
            function Tab:CreateKeybind(config_)
                self._itemOrder = (self._itemOrder or 0) + 1
                local currentKey = config_.CurrentKeybind or "None"
                if configSave and config_.Flag then
                    currentKey = configSave:Get(config_.Flag, currentKey)
                end
                if Nexus.Flags and config_.Flag then
                    Nexus.Flags[config_.Flag] = currentKey
                end

                local listening = false
                local card = BaseCard(self, 46)
                card.LayoutOrder = self._itemOrder

                local nameL = Instance.new("TextLabel")
                nameL.Size              = UDim2.new(1,-120,1,0)
                nameL.Position          = UDim2.new(0,14,0,0)
                nameL.BackgroundTransparency = 1
                nameL.Text              = config_.Name or "Keybind"
                nameL.TextColor3        = T.TextPrimary
                nameL.TextSize          = 13
                nameL.Font              = Enum.Font.Gotham
                nameL.TextXAlignment    = Enum.TextXAlignment.Left
                nameL.Parent            = card

                local keyBadge = Instance.new("TextButton")
                keyBadge.Size             = UDim2.new(0,80,0,28)
                keyBadge.Position         = UDim2.new(1,-92,0.5,0)
                keyBadge.AnchorPoint      = Vector2.new(0,0.5)
                keyBadge.BackgroundColor3 = T.BGSecondary
                keyBadge.BorderSizePixel  = 0
                keyBadge.Text             = currentKey
                keyBadge.TextColor3       = T.TextAccent
                keyBadge.TextSize         = 12
                keyBadge.Font             = Enum.Font.GothamBold
                keyBadge.AutoButtonColor  = false
                keyBadge.ZIndex           = card.ZIndex + 2
                keyBadge.Parent           = card
                MakeRound(keyBadge, 7)
                MakeStroke(keyBadge, T.Border, 1, 0.4)

                keyBadge.MouseButton1Click:Connect(function()
                    if listening then return end
                    listening = true
                    keyBadge.Text      = "..."
                    keyBadge.TextColor3 = T.Warning
                    Tween(keyBadge, {BackgroundColor3=T.Accent:Lerp(T.BGSecondary,0.8)}, 0.15)
                end)

                UserInputService.InputBegan:Connect(function(input, gp)
                    if not listening then
                        -- Handle hold-to-interact
                        if config_.HoldToInteract then
                            local kc = Enum.KeyCode[currentKey]
                            if kc and input.KeyCode == kc then
                                if config_.Callback then task.spawn(config_.Callback, true) end
                            end
                        else
                            local kc = Enum.KeyCode[currentKey]
                            if kc and input.KeyCode == kc and not gp then
                                if config_.Callback then task.spawn(config_.Callback, false) end
                            end
                        end
                        return
                    end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        listening = false
                        currentKey = input.KeyCode.Name
                        keyBadge.Text       = currentKey
                        keyBadge.TextColor3 = T.TextAccent
                        Tween(keyBadge, {BackgroundColor3=T.BGSecondary}, 0.15)
                        if configSave and config_.Flag then configSave:Set(config_.Flag, currentKey) end
                        if Nexus.Flags and config_.Flag then Nexus.Flags[config_.Flag] = currentKey end
                        Ripple(keyBadge)
                    end
                end)
                if config_.HoldToInteract then
                    UserInputService.InputEnded:Connect(function(input)
                        local kc = Enum.KeyCode[currentKey]
                        if kc and input.KeyCode == kc then
                            if config_.Callback then task.spawn(config_.Callback, false) end
                        end
                    end)
                end

                HoverCard(card, T.Surface, T.SurfaceHover)

                local KBObj = {CurrentKeybind = currentKey}
                function KBObj:Set(key)
                    currentKey = key
                    KBObj.CurrentKeybind = key
                    keyBadge.Text = key
                    if configSave and config_.Flag then configSave:Set(config_.Flag, key) end
                    if Nexus.Flags and config_.Flag then Nexus.Flags[config_.Flag] = key end
                end
                return KBObj
            end

            return Tab
        end -- CreateTab

        -- ── Window-level API ──────────────────────
        function Window:SetVisibility(visible)
            self._mainFrame.Visible = visible
        end
        function Window:IsVisible()
            return self._mainFrame.Visible
        end
        function Window:Destroy()
            Tween(self._mainFrame, {BackgroundTransparency=1, Size=UDim2.new(0,0,0,0)}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In)
            task.delay(0.3, function()
                self._screenGui:Destroy()
            end)
        end

        table.insert(Nexus._windows, Window)
        return Window
    end -- BootWindow

    -- ── Key System gating ───────────────────────
    if config.KeySystem then
        local saved = nil
        -- (key file loading requires executor filesystem, skipped)

        -- Validate saved key
        local autoPass = false
        if saved then
            local ks = config.KeySettings
            for _, k in ipairs(ks.Key or {}) do
                local rawKey = k
                if ks.GrabKeyFromSite then
                    pcall(function() rawKey = _HttpGet(k):gsub("%s+","") end)
                end
                if saved == rawKey or saved == k then
                    autoPass = true
                    break
                end
            end
        end

        if autoPass then
            ShowLoadingScreen(config.LoadingTitle, config.LoadingSubtitle, T)
            return BootWindow()
        else
            local win = nil
            ShowKeySystem(config.KeySettings or {}, T,
                function()
                    ShowLoadingScreen(config.LoadingTitle, config.LoadingSubtitle, T)
                    win = BootWindow()
                end,
                function() end
            )
            -- Return a proxy while waiting
            return setmetatable({}, {__index = function(_, k)
                return function() end
            end})
        end
    else
        ShowLoadingScreen(config.LoadingTitle, config.LoadingSubtitle, T)
        return BootWindow()
    end
end

-- ═══════════════════════════════════════════════════
--  TOP-LEVEL API ALIASES
-- ═══════════════════════════════════════════════════
function Nexus:SetVisibility(visible)
    for _, w in ipairs(self._windows) do
        if w._mainFrame then
            w._mainFrame.Visible = visible
        end
    end
end

function Nexus:IsVisible()
    for _, w in ipairs(self._windows) do
        if w._mainFrame then
            return w._mainFrame.Visible
        end
    end
    return false
end

function Nexus:Destroy()
    for _, w in ipairs(self._windows) do
        if w.Destroy then w:Destroy() end
    end
    self._windows = {}
end

