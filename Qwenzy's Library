            }, picker)
            Round(wheelClip, WHEEL/2)

            New("ImageLabel", {
                Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
                Image="rbxassetid://109617510791865",
                ImageColor3=Color3.fromRGB(255,255,255),
                ScaleType=Enum.ScaleType.Fit, ZIndex=11,
            }, wheelClip)

            local darkOv = New("Frame", {
                Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.fromRGB(0,0,0),
                BackgroundTransparency=val_, BorderSizePixel=0, ZIndex=12,
            }, wheelClip)
            Round(darkOv, WHEEL/2)

            local function WheelPos(h, s)
                local angle = (h - 0.25) * 2 * math.pi
                local radius = (WHEEL/2 - 8) * s
                return UDim2.new(0, WHEEL/2 + radius*math.cos(angle), 0, WHEEL/2 + radius*math.sin(angle))
            end

            local wcursor = New("Frame", {
                Size=UDim2.new(0,18,0,18), Position=WheelPos(hue,sat),
                AnchorPoint=Vector2.new(0.5,0.5), BackgroundColor3=Color3.fromRGB(255,255,255),
                BorderSizePixel=0, ZIndex=14,
            }, wheelClip)
            Round(wcursor, 9)
            Stroke(wcursor, Color3.fromRGB(20,20,20), 2, 0)
            local wdot = New("Frame", {
                Size=UDim2.new(0,10,0,10), Position=UDim2.new(0.5,0,0.5,0),
                AnchorPoint=Vector2.new(0.5,0.5), BackgroundColor3=initC,
                BorderSizePixel=0, ZIndex=15,
            }, wcursor)
            Round(wdot, 5)
            New("TextButton", {
                Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=16,
            }, wheelClip)

            local brightTrack = New("Frame", {
                Size=UDim2.new(1,0,0,BH), Position=UDim2.new(0,0,0,WHEEL+10),
                BackgroundColor3=Color3.fromRGB(0,0,0), BorderSizePixel=0, ZIndex=10,
            }, picker)
            Round(brightTrack, BH/2)
            local bGrad = Instance.new("UIGradient")
            bGrad.Color = ColorSequence.new(Color3.fromRGB(0,0,0), Color3.fromHSV(hue,1,1))
            bGrad.Rotation = 0
            bGrad.Parent = brightTrack
            local bcursor = New("Frame", {
                Size=UDim2.new(0,BH+2,0,BH+2), Position=UDim2.new(val_,0,0.5,0),
                AnchorPoint=Vector2.new(0.5,0.5), BackgroundColor3=Color3.fromRGB(255,255,255),
                BorderSizePixel=0, ZIndex=12,
            }, brightTrack)
            Round(bcursor, (BH+2)/2)
            Stroke(bcursor, Color3.fromRGB(30,30,30), 1.5, 0)
            New("TextButton", {
                Size=UDim2.new(1,0,1,14), Position=UDim2.new(0,0,0,-7),
                BackgroundTransparency=1, Text="", ZIndex=13,
            }, brightTrack)

            local hexLbl = New("TextLabel", {
                Size=UDim2.new(1,0,0,14), Position=UDim2.new(0,0,0,WHEEL+32),
                BackgroundTransparency=1,
                Text=string.format("#%02X%02X%02X", math.floor(initC.R*255), math.floor(initC.G*255), math.floor(initC.B*255)),
                TextColor3=T.TextM, TextSize=11, Font=Enum.Font.Code,
                TextXAlignment=Enum.TextXAlignment.Center, ZIndex=10,
            }, picker)

            local curColor = initC
            local dragW, dragB = false, false

            local function UpdateColor()
                curColor = Color3.fromHSV(hue, sat, val_)
                swatch.BackgroundColor3 = curColor
                wdot.BackgroundColor3 = curColor
                darkOv.BackgroundTransparency = val_
                wcursor.Position = WheelPos(hue, sat)
                bcursor.Position = UDim2.new(val_,0,0.5,0)
                bGrad.Color = ColorSequence.new(Color3.fromRGB(0,0,0), Color3.fromHSV(hue,1,1))
                hexLbl.Text = string.format("#%02X%02X%02X", math.floor(curColor.R*255), math.floor(curColor.G*255), math.floor(curColor.B*255))
                Qwenzy.Flags[cfg_.Flag or ""] = curColor
                if cfg_.Callback then task.spawn(cfg_.Callback, curColor) end
            end

            local function PickWheel(mx, my)
                local cx = wheelClip.AbsolutePosition.X + WHEEL/2
                local cy = wheelClip.AbsolutePosition.Y + WHEEL/2
                local dx, dy = mx-cx, my-cy
                sat = math.min(math.sqrt(dx*dx+dy*dy) / (WHEEL/2-4), 1)
                hue = ((math.atan2(dy,dx)/(2*math.pi)) + 0.25) % 1
                UpdateColor()
            end

            local wheelHitBtn = wheelClip:FindFirstChildWhichIsA("TextButton")
            if wheelHitBtn then
                wheelHitBtn.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1
                    or inp.UserInputType == Enum.UserInputType.Touch then
                        dragW = true
                        local px = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.X or Mouse.X
                        local py = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.Y or Mouse.Y
                        PickWheel(px, py)
                    end
                end)
            end
            local brightHitBtn = brightTrack:FindFirstChildWhichIsA("TextButton")
            if brightHitBtn then
                brightHitBtn.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1
                    or inp.UserInputType == Enum.UserInputType.Touch then
                        dragB = true
                        local px = inp.UserInputType == Enum.UserInputType.Touch and inp.Position.X or Mouse.X
                        val_ = math.clamp((px - brightTrack.AbsolutePosition.X) / brightTrack.AbsoluteSize.X, 0, 1)
                        UpdateColor()
                    end
                end)
            end

            Track(UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch then
                    dragW = false; dragB = false
                end
            end))
            Track(RunService.RenderStepped:Connect(function()
                if dragW then PickWheel(CursorX(), CursorY()) end
                if dragB then
                    val_ = math.clamp((CursorX() - brightTrack.AbsolutePosition.X) / brightTrack.AbsoluteSize.X, 0, 1)
                    UpdateColor()
                end
            end))

            local headerHit = New("TextButton", {
                Size=UDim2.new(1,0,0,48), BackgroundTransparency=1, Text="", ZIndex=c.ZIndex+4,
            }, c)
            headerHit.MouseButton1Click:Connect(function()
                collapsed = not collapsed
                if not collapsed then
                    picker.Visible = true
                    Tween(c, {Size=UDim2.new(1,0,0,expandH)}, 0.3, Enum.EasingStyle.Quart)
                    Tween(chev, {Rotation=180}, 0.22)
                else
                    Tween(c, {Size=UDim2.new(1,0,0,48)}, 0.25, Enum.EasingStyle.Quart)
                    Tween(chev, {Rotation=0}, 0.22)
                    task.delay(0.25, function() if picker then picker.Visible=false end end)
                end
            end)

            local o = {CurrentColor=curColor}
            function o:Set(col)
                curColor=col; o.CurrentColor=col
                swatch.BackgroundColor3=col
                hue,sat,val_=col:ToHSV()
                UpdateColor()
                if cfg_.Callback then task.spawn(cfg_.Callback,col) end
            end
            return o
        end

