        Size=UDim2.new(1,46,1,46), Position=UDim2.new(0,-23,0,-23),
        ZIndex=(parent.ZIndex or 1)-1,
    }, parent)
    return s
end

-- Shared top-level overlay for ripples
-- IgnoreGuiInset=true means (0,0) = true screen top-left (ignores the Roblox top bar)
-- AbsolutePosition of GUI elements also ignores the inset offset when read raw,
-- BUT Roblox adds the inset to AbsolutePosition for elements inside normal ScreenGuis.
-- So: overlay origin = screen top-left, cursor = screen coords, AbsolutePos = inset-offset coords.
-- We must subtract the inset from AbsolutePosition to get true screen coords.
local GuiService = game:GetService("GuiService")
local RippleOverlaySG = New("ScreenGui", {
    Name="QwenzyRippleOverlay", ResetOnSpawn=false,
    ZIndexBehavior=Enum.ZIndexBehavior.Global,
    IgnoreGuiInset=true,   -- overlay origin = true screen (0,0)
    DisplayOrder=9999,
}, ROOT)
local RippleOverlay = New("Frame", {
    Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
    BorderSizePixel=0, ZIndex=32766, ClipsDescendants=false,
}, RippleOverlaySG)

local function Ripple(btn, customColor)
    local ap = btn.AbsolutePosition  -- inset-offset coords (inset already added by Roblox)
    local as = btn.AbsoluteSize
    local inset = GuiService:GetGuiInset()
    -- Convert to true screen coords (matching IgnoreGuiInset=true overlay)
    local bx = ap.X - inset.X
    local by = ap.Y - inset.Y
    -- Clamp cursor to button bounds in true screen space
    local cx = math.clamp(CursorX() - inset.X, bx, bx + as.X)
    local cy = math.clamp(CursorY() - inset.Y, by, by + as.Y)

    local color = customColor or Color3.fromRGB(180, 150, 255)

    -- Outer expanding ring
    local ring = New("Frame", {
        BackgroundTransparency=1, Size=UDim2.new(0,0,0,0),
        Position=UDim2.new(0,cx,0,cy), AnchorPoint=Vector2.new(0.5,0.5),
        ZIndex=32767,
    }, RippleOverlay)
    Round(ring, 999)
    local rs = Instance.new("UIStroke")
    rs.Color = color; rs.Thickness = 1.5; rs.Transparency = 0.1; rs.Parent = ring
    local rsz = math.max(as.X, as.Y) * 1.8
    Tween(ring, {Size=UDim2.new(0,rsz,0,rsz)}, 0.42, Enum.EasingStyle.Quart)
    Tween(rs,   {Transparency=1},               0.42, Enum.EasingStyle.Quart)
    task.delay(0.45, function() if ring then ring:Destroy() end end)

    -- Inner filled bloom
    local rp = New("Frame", {
        BackgroundColor3=color, BackgroundTransparency=0.72,
        Size=UDim2.new(0,0,0,0), Position=UDim2.new(0,cx,0,cy),
        AnchorPoint=Vector2.new(0.5,0.5), ZIndex=32766,
    }, RippleOverlay)
    Round(rp, 999)
    local sz = math.max(as.X, as.Y) * 2.2
    Tween(rp, {Size=UDim2.new(0,sz,0,sz), BackgroundTransparency=1}, 0.55, Enum.EasingStyle.Quad)
    task.delay(0.58, function() if rp then rp:Destroy() end end)
end

-- ===================================================
--  CONFIG MANAGER
-- ===================================================
local ConfigManager = {}
ConfigManager.__index = ConfigManager

function ConfigManager.new(folder, file)
    local self = setmetatable({Data={}, _folder=folder or "QwenzyUI", _file=file or "Config"}, ConfigManager)
    self:Load()
    return self
end

function ConfigManager:_path() return self._folder.."/"..self._file..".json" end

function ConfigManager:Load()
    pcall(function()
        if not _isfolder(self._folder) then _makefolder(self._folder) end
        local p = self:_path()
        if _isfile(p) then
            local raw = _readfile(p)
            if raw and raw ~= "" then
                local ok, d = pcall(function() return HttpService:JSONDecode(raw) end)
                if ok and type(d)=="table" then self.Data = d end
            end
        end
    end)
end

function ConfigManager:Save()
    pcall(function()
        if not _isfolder(self._folder) then _makefolder(self._folder) end
        _writefile(self:_path(), HttpService:JSONEncode(self.Data))
    end)
end

function ConfigManager:Get(k, def)
    return self.Data[k] ~= nil and self.Data[k] or def
end

function ConfigManager:Set(k, v)
    self.Data[k] = v
    self:Save()
end

