            -- ═══════════════════════════════════════
            function Tab:CreateToggle(config_)
                self._itemOrder = (self._itemOrder or 0) + 1
                local initVal = config_.CurrentValue
                if configSave and config_.Flag then
                    initVal = configSave:Get(config_.Flag, initVal)
                end
                if Nexus.Flags and config_.Flag then
                    Nexus.Flags[config_.Flag] = initVal
                end

                local card = BaseCard(self, 46)
                card.LayoutOrder = self._itemOrder

                local nameL = Instance.new("TextLabel")
                nameL.Size              = UDim2.new(1,-90,1,0)
                nameL.Position          = UDim2.new(0,14,0,0)
                nameL.BackgroundTransparency = 1
                nameL.Text              = config_.Name or "Toggle"
                nameL.TextColor3        = T.TextPrimary
                nameL.TextSize          = 13
                nameL.Font              = Enum.Font.Gotham
                nameL.TextXAlignment    = Enum.TextXAlignment.Left
                nameL.Parent            = card

                -- Track
                local track = Instance.new("Frame")
                track.Size             = UDim2.new(0,44,0,24)
                track.Position         = UDim2.new(1,-58,0.5,0)
                track.AnchorPoint      = Vector2.new(0,0.5)
                track.BackgroundColor3 = initVal and T.ToggleOn or T.ToggleOff
                track.BorderSizePixel  = 0
                track.Parent           = card
                MakeRound(track, 12)
                MakeStroke(track, T.Border, 1, 0.5)

                -- Knob
                local knob = Instance.new("Frame")
                knob.Size             = UDim2.new(0,18,0,18)
                knob.Position         = initVal
                    and UDim2.new(0,23,0.5,0)
                    or  UDim2.new(0,3,0.5,0)
                knob.AnchorPoint      = Vector2.new(0,0.5)
                knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
                knob.BorderSizePixel  = 0
                knob.ZIndex           = track.ZIndex + 1
                knob.Parent           = track
                MakeRound(knob, 9)

                local value = initVal
                local hitbox = Instance.new("TextButton")
                hitbox.Size                 = UDim2.new(1,0,1,0)
                hitbox.BackgroundTransparency = 1
                hitbox.Text                 = ""
                hitbox.ZIndex               = card.ZIndex + 2
                hitbox.Parent               = card

                HoverCard(card, T.Surface, T.SurfaceHover)

                hitbox.MouseButton1Click:Connect(function()
                    Ripple(card)
                    value = not value
                    Tween(track, {BackgroundColor3 = value and T.ToggleOn or T.ToggleOff}, 0.25)
                    Tween(knob, {Position = value
                        and UDim2.new(0,23,0.5,0)
                        or  UDim2.new(0,3,0.5,0)
                    }, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                    if value then
                        Tween(knob, {Size=UDim2.new(0,20,0,20)}, 0.1)
                        task.wait(0.1)
                        Tween(knob, {Size=UDim2.new(0,18,0,18)}, 0.1)
                    end
                    if configSave and config_.Flag then configSave:Set(config_.Flag, value) end
                    if Nexus.Flags and config_.Flag then Nexus.Flags[config_.Flag] = value end
                    if config_.Callback then task.spawn(config_.Callback, value) end
                end)

                local ToggleObj = {CurrentValue = value}
                function ToggleObj:Set(v)
                    value = v
                    ToggleObj.CurrentValue = v
                    Tween(track, {BackgroundColor3 = v and T.ToggleOn or T.ToggleOff}, 0.25)
                    Tween(knob, {Position = v and UDim2.new(0,23,0.5,0) or UDim2.new(0,3,0.5,0)}, 0.25)
                    if configSave and config_.Flag then configSave:Set(config_.Flag, v) end
                    if Nexus.Flags and config_.Flag then Nexus.Flags[config_.Flag] = v end
                    if config_.Callback then task.spawn(config_.Callback, v) end
                end
                return ToggleObj
            end

            -- ═══════════════════════════════════════
            --  Slider
            -- ═══════════════════════════════════════
            function Tab:CreateSlider(config_)
                self._itemOrder = (self._itemOrder or 0) + 1
                local minV   = config_.Range and config_.Range[1] or 0
                local maxV   = config_.Range and config_.Range[2] or 100
                local incr   = config_.Increment or 1
                local suffix = config_.Suffix or ""
                local initVal = config_.CurrentValue or minV
                if configSave and config_.Flag then
                    initVal = configSave:Get(config_.Flag, initVal)
                end
                if Nexus.Flags and config_.Flag then
                    Nexus.Flags[config_.Flag] = initVal
                end

                local card = BaseCard(self, 60)
                card.LayoutOrder = self._itemOrder

                local nameL = Instance.new("TextLabel")
                nameL.Size              = UDim2.new(0.7,0,0,22)
                nameL.Position          = UDim2.new(0,14,0,8)
                nameL.BackgroundTransparency = 1
                nameL.Text              = config_.Name or "Slider"
                nameL.TextColor3        = T.TextPrimary
                nameL.TextSize          = 13
                nameL.Font              = Enum.Font.Gotham
                nameL.TextXAlignment    = Enum.TextXAlignment.Left
                nameL.Parent            = card

                local valLabel = Instance.new("TextLabel")
                valLabel.Size              = UDim2.new(0.3,-14,0,22)
                valLabel.Position          = UDim2.new(0.7,0,0,8)
                valLabel.BackgroundTransparency = 1
                valLabel.Text              = tostring(initVal) .. " " .. suffix
                valLabel.TextColor3        = T.TextAccent
                valLabel.TextSize          = 13
                valLabel.Font              = Enum.Font.GothamBold
                valLabel.TextXAlignment    = Enum.TextXAlignment.Right
                valLabel.Parent            = card

                -- Track bg
                local trackBG = Instance.new("Frame")
                trackBG.Size             = UDim2.new(1,-28,0,6)
                trackBG.Position         = UDim2.new(0,14,0,38)
                trackBG.BackgroundColor3 = T.BGSecondary
                trackBG.BorderSizePixel  = 0
                trackBG.ZIndex           = card.ZIndex + 1
                trackBG.Parent           = card
                MakeRound(trackBG, 3)

                -- Fill
                local fill = Instance.new("Frame")
                fill.Size             = UDim2.new((initVal-minV)/(maxV-minV),0,1,0)
                fill.BackgroundColor3 = T.Accent
                fill.BorderSizePixel  = 0
                fill.ZIndex           = card.ZIndex + 2
                fill.Parent           = trackBG
                MakeRound(fill, 3)
                MakeGradient(fill, T.Accent, T.AccentLight, 90)

                -- Knob
                local knob = Instance.new("Frame")
                knob.Size             = UDim2.new(0,16,0,16)
                knob.Position         = UDim2.new((initVal-minV)/(maxV-minV),0,0.5,0)
                knob.AnchorPoint      = Vector2.new(0.5,0.5)
                knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
                knob.BorderSizePixel  = 0
                knob.ZIndex           = card.ZIndex + 3
                knob.Parent           = trackBG
                MakeRound(knob, 8)
                MakeStroke(knob, T.Accent, 2, 0.2)

                local currentValue = initVal
                local draggingSlider = false

                local function UpdateSlider(xAbs)
                    local relX = math.clamp(xAbs - trackBG.AbsolutePosition.X, 0, trackBG.AbsoluteSize.X)
                    local pct  = relX / trackBG.AbsoluteSize.X
                    local raw  = minV + pct * (maxV - minV)
                    local stepped = math.round(raw / incr) * incr
                    stepped = math.clamp(stepped, minV, maxV)

                    if stepped ~= currentValue then
                        currentValue = stepped
                        local newPct = (stepped - minV) / (maxV - minV)
                        Tween(fill,  {Size     = UDim2.new(newPct,0,1,0)}, 0.05)
                        Tween(knob,  {Position = UDim2.new(newPct,0,0.5,0)}, 0.05)
                        valLabel.Text = tostring(stepped) .. " " .. suffix
                        if configSave and config_.Flag then configSave:Set(config_.Flag, stepped) end
                        if Nexus.Flags and config_.Flag then Nexus.Flags[config_.Flag] = stepped end
                        if config_.Callback then task.spawn(config_.Callback, stepped) end
                    end
                end

                local hitbox = Instance.new("TextButton")
                hitbox.Size                 = UDim2.new(1,0,1,0)
                hitbox.BackgroundTransparency = 1
                hitbox.Text                 = ""
                hitbox.ZIndex               = card.ZIndex + 4
                hitbox.Parent               = trackBG

                hitbox.MouseButton1Down:Connect(function()
                    draggingSlider = true
                    Tween(knob, {Size=UDim2.new(0,20,0,20)}, 0.1)
                    UpdateSlider(Mouse.X)
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        if draggingSlider then
                            draggingSlider = false
                            Tween(knob, {Size=UDim2.new(0,16,0,16)}, 0.1)
                        end
                    end
                end)
                RunService.RenderStepped:Connect(function()
                    if draggingSlider then
                        UpdateSlider(Mouse.X)
                    end
                end)

                local SliderObj = {CurrentValue = currentValue}
                function SliderObj:Set(v)
                    v = math.clamp(v, minV, maxV)
                    currentValue = v
                    SliderObj.CurrentValue = v
                    local pct = (v - minV) / (maxV - minV)
                    Tween(fill,  {Size     = UDim2.new(pct,0,1,0)}, 0.2)
                    Tween(knob,  {Position = UDim2.new(pct,0,0.5,0)}, 0.2)
                    valLabel.Text = tostring(v) .. " " .. suffix
                    if configSave and config_.Flag then configSave:Set(config_.Flag, v) end
                    if Nexus.Flags and config_.Flag then Nexus.Flags[config_.Flag] = v end
                    if config_.Callback then task.spawn(config_.Callback, v) end
                end
                return SliderObj
            end

            -- ═══════════════════════════════════════
            --  Color Picker
            -- ═══════════════════════════════════════
            function Tab:CreateColorPicker(config_)
                self._itemOrder = (self._itemOrder or 0) + 1
                local initColor = config_.Color or Color3.fromRGB(255,255,255)
                if configSave and config_.Flag then
                    local saved = configSave:Get(config_.Flag, nil)
                    if saved then
                        initColor = Color3.fromRGB(saved[1],saved[2],saved[3])
                    end
                end
                if Nexus.Flags and config_.Flag then
                    Nexus.Flags[config_.Flag] = initColor
                end

                local collapsed = true
                local card = BaseCard(self, 46)
                card.LayoutOrder  = self._itemOrder
                card.ClipsDescendants = true

                local nameL = Instance.new("TextLabel")
                nameL.Size              = UDim2.new(1,-90,0,46)
                nameL.Position          = UDim2.new(0,14,0,0)
                nameL.BackgroundTransparency = 1
