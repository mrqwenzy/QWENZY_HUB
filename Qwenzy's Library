local function ShowLoading(title, sub)
    local sg = New("ScreenGui", {Name="QwenzyLoading", ResetOnSpawn=false,
        ZIndexBehavior=Enum.ZIndexBehavior.Sibling, IgnoreGuiInset=true}, ROOT)

    local bg = New("Frame", {Size=UDim2.new(1,0,1,0), BackgroundColor3=T.BG, BorderSizePixel=0, ZIndex=100}, sg)

    local card = New("Frame", {
        Size=UDim2.new(0,340,0,180),
        Position=UDim2.new(0.5,0,0.55,0),
        AnchorPoint=Vector2.new(0.5,0.5),
        BackgroundColor3=T.Surface, BorderSizePixel=0, ZIndex=102,
    }, sg)
    Round(card, 16)
    Stroke(card, T.Border, 1, 0.35)
    Shadow(card)

    -- top accent line
    local al = New("Frame", {Size=UDim2.new(0.4,0,0,2), Position=UDim2.new(0.3,0,0,0),
        BackgroundColor3=T.Acc, BorderSizePixel=0, ZIndex=103}, card)
    Round(al, 1)

    -- Logo ring
    local ring = New("Frame", {
        Size=UDim2.new(0,52,0,52), Position=UDim2.new(0.5,0,0,18),
        AnchorPoint=Vector2.new(0.5,0), BackgroundColor3=T.Acc,
        BackgroundTransparency=0.8, BorderSizePixel=0, ZIndex=103,
    }, card)
    Round(ring, 26)
    Stroke(ring, T.AccB, 1.5, 0.4)
    New("TextLabel", {
        Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
        Text="Q", TextColor3=T.AccB, TextSize=22, Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Center, ZIndex=104,
    }, ring)

    -- Pulse ring
    task.spawn(function()
        while ring and ring.Parent do
            Tween(ring, {BackgroundTransparency=0.5, Size=UDim2.new(0,60,0,60), Position=UDim2.new(0.5,0,0,14)}, 0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(0.9)
            Tween(ring, {BackgroundTransparency=0.8, Size=UDim2.new(0,52,0,52), Position=UDim2.new(0.5,0,0,18)}, 0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(0.9)
        end
    end)

    New("TextLabel", {Size=UDim2.new(1,-32,0,20), Position=UDim2.new(0,16,0,86),
        BackgroundTransparency=1, Text=title or "QwenzyUI",
        TextColor3=T.TextP, TextSize=16, Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Center, ZIndex=103}, card)
    local subLbl = New("TextLabel", {Size=UDim2.new(1,-32,0,16), Position=UDim2.new(0,16,0,108),
        BackgroundTransparency=1, Text=sub or "Loading...",
        TextColor3=T.TextS, TextSize=12, Font=Enum.Font.Gotham,
        TextXAlignment=Enum.TextXAlignment.Center, ZIndex=103}, card)

    -- Progress track
    local track = New("Frame", {Size=UDim2.new(1,-48,0,3), Position=UDim2.new(0,24,0,144),
        BackgroundColor3=T.BGS, BorderSizePixel=0, ZIndex=103}, card)
    Round(track, 2)
    local fill = New("Frame", {Size=UDim2.new(0,0,1,0), BackgroundColor3=T.Acc, BorderSizePixel=0, ZIndex=104}, track)
    Round(fill, 2)

    -- Steps
    local steps = {"Connecting...","Loading assets...","Building UI...","Ready."}
    task.spawn(function()
        for _, m in ipairs(steps) do
            task.wait(0.42)
            if subLbl and subLbl.Parent then subLbl.Text = m end
        end
    end)

    card.Position = UDim2.new(0.5,0,0.6,0)
    Tween(card, {Position=UDim2.new(0.5,0,0.5,0)}, 0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    Tween(fill, {Size=UDim2.new(1,0,1,0)}, 1.85, Enum.EasingStyle.Quart)

    task.wait(2.0)
    Tween(bg, {BackgroundTransparency=1}, 0.28)
    Tween(card, {BackgroundTransparency=1}, 0.28)
    task.wait(0.28)
    sg:Destroy()
end

-- ===================================================
--  CREATE WINDOW
-- ===================================================
function Qwenzy:CreateWindow(cfg)
    for _, w in ipairs(self._windows) do pcall(function() w:Destroy() end) end
    self._windows = {}

    ShowLoading(cfg.LoadingTitle, cfg.LoadingSubtitle)

    local vp = workspace.CurrentCamera.ViewportSize
    local isMobile = vp.X < 600

    -- Window as % of screen
    local WIN_SW  = isMobile and 0.55 or 0.30
    local WIN_SH  = isMobile and 0.78 or 0.46
    local WIN_W   = math.floor(vp.X * WIN_SW)
    local WIN_H   = math.floor(vp.Y * WIN_SH)
    -- All internal layout in scale (0-1 relative to window)
    local TOP_S   = 0.09   -- topbar as fraction of WIN_H
    local SIDE_S  = isMobile and 0.18 or 0.25  -- sidebar as fraction of WIN_W
    local TOP_H   = math.floor(WIN_H * TOP_S)
    local SIDE_W  = math.floor(WIN_W * SIDE_S)

    local sg = New("ScreenGui", {
        Name="QwenzyUI_Window", ResetOnSpawn=false,
        ZIndexBehavior=Enum.ZIndexBehavior.Sibling, IgnoreGuiInset=true,
    }, ROOT)

    -- Main panel
    local main = New("Frame", {
        Size=UDim2.new(0, WIN_W, 0, 0),
        Position=UDim2.new(0, (vp.X-WIN_W)/2, 0, (vp.Y-WIN_H)/2),
        BackgroundColor3=T.BG, BorderSizePixel=0, ClipsDescendants=true,
    }, sg)
    Round(main, 12)
    Stroke(main, T.Border, 1, 0.25)
    Shadow(main)

    -- ---- TOPBAR ----
    local topbar = New("Frame", {
        Size=UDim2.new(1,0,TOP_S,0),
        BackgroundColor3=T.Top, BorderSizePixel=0, ZIndex=3,
    }, main)
    -- Bottom border glow
    New("Frame", {Size=UDim2.new(1,0,0,1), Position=UDim2.new(0,0,1,0),
        AnchorPoint=Vector2.new(0,1),
        BackgroundColor3=T.Acc, BackgroundTransparency=0.82, BorderSizePixel=0, ZIndex=4}, topbar)

    -- Icon + title
    local titleX = 14
    if cfg.Icon and cfg.Icon ~= 0 then
        local ico = New("ImageLabel", {
            Size=UDim2.new(0,18,0,18), Position=UDim2.new(0,14,0.5,0),
            AnchorPoint=Vector2.new(0,0.5), BackgroundTransparency=1,
            ImageColor3=T.AccB, ZIndex=5,
        }, topbar)
        ApplyIcon(ico, cfg.Icon)
        titleX = 38
    end
    New("TextLabel", {
        Size=UDim2.new(1,-140,0,16), Position=UDim2.new(0,titleX,0.5,0),
        AnchorPoint=Vector2.new(0,0.5), BackgroundTransparency=1,
        Text=cfg.Name or "QwenzyUI", TextColor3=T.TextP,
        TextSize=13, Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=4,
    }, topbar)

    -- Topbar control buttons
    local function TopBtn(icon, xOff, icCol)
        local btnSz = math.floor(TOP_H * 0.62)
        local btn = New("TextButton", {
            Size=UDim2.new(0,btnSz,0,btnSz), Position=UDim2.new(1,xOff,0.5,0),
            AnchorPoint=Vector2.new(1,0.5), BackgroundColor3=T.SurfaceH,
            BackgroundTransparency=0.55, BorderSizePixel=0,
            Text="", AutoButtonColor=false, ZIndex=5,
        }, topbar)
        Round(btn, 7)
        local img = New("ImageLabel", {
            Size=UDim2.new(0,13,0,13), Position=UDim2.new(0.5,0,0.5,0),
            AnchorPoint=Vector2.new(0.5,0.5), BackgroundTransparency=1,
            ImageColor3=icCol or T.TextM, ZIndex=6,
        }, btn)
        ApplyIcon(img, icon)
        btn.MouseEnter:Connect(function()
            Tween(btn, {BackgroundTransparency=0.05, BackgroundColor3=icCol or T.SurfaceH}, 0.1)
            Tween(img, {ImageColor3=icCol or T.TextP}, 0.1)
        end)
        btn.MouseLeave:Connect(function()
            Tween(btn, {BackgroundTransparency=0.55, BackgroundColor3=T.SurfaceH}, 0.1)
            Tween(img, {ImageColor3=icCol or T.TextM}, 0.1)
        end)
        return btn
    end

    local closeBtn = TopBtn("x",     -8,  T.Err)
    local minimBtn = TopBtn("minus", -40, T.TextM)

    -- Drag support (mouse + touch)
    local dragging, dX, dY = false, 0, 0
    topbar.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or
           inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dX = inp.Position.X - main.AbsolutePosition.X
            dY = inp.Position.Y - main.AbsolutePosition.Y
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement or
           inp.UserInputType == Enum.UserInputType.Touch then
            local vp2 = workspace.CurrentCamera.ViewportSize
            main.Position = UDim2.new(0,
                math.clamp(inp.Position.X-dX, 0, vp2.X-main.AbsoluteSize.X),
                0,
                math.clamp(inp.Position.Y-dY, 0, vp2.Y-main.AbsoluteSize.Y))
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or
           inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Close / minimize
    local minimized, prevSize = false, nil
    closeBtn.MouseButton1Click:Connect(function()
        Ripple(closeBtn)
        Tween(main, {Size=UDim2.new(0,WIN_W,0,0)}, 0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.2, function() pcall(function() sg:Destroy() end) end)
    end)
    minimBtn.MouseButton1Click:Connect(function()
        Ripple(minimBtn)
        if minimized then
            Tween(main, {Size=prevSize}, 0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            minimized = false
        else
            prevSize = main.Size
            Tween(main, {Size=UDim2.new(0,WIN_W,0,math.floor(WIN_H*TOP_S))}, 0.2, Enum.EasingStyle.Quart)
            minimized = true
        end
    end)

    -- Keyboard toggle
    if cfg.ToggleUIKeybind then
        local kc = typeof(cfg.ToggleUIKeybind)=="EnumItem"
            and cfg.ToggleUIKeybind
            or Enum.KeyCode[tostring(cfg.ToggleUIKeybind)]
        if kc then
            UserInputService.InputBegan:Connect(function(inp, gp)
                if not gp and inp.KeyCode == kc then
                    main.Visible = not main.Visible
                end
            end)
        end
    end

    -- ---- MOBILE TOGGLE BUTTON ----
    -- Floating pill at bottom-right, always on screen
    local fab = New("TextButton", {
        Size=UDim2.new(0,math.floor(vp.X*0.07),0,math.floor(vp.X*0.07)),
        Position=UDim2.new(1,-math.floor(vp.X*0.09), 1,-math.floor(vp.X*0.09)),
        BackgroundColor3=T.Acc,
        BorderSizePixel=0, Text="", AutoButtonColor=false, ZIndex=400,
    }, sg)
    Round(fab, 999)
    Shadow(fab)
    Stroke(fab, T.AccB, 1, 0.6)

    local fabIco = New("ImageLabel", {
        Size=UDim2.new(0,20,0,20), Position=UDim2.new(0.5,0,0.5,0),
        AnchorPoint=Vector2.new(0.5,0.5), BackgroundTransparency=1,
        ImageColor3=T.BG, ZIndex=401,
    }, fab)
    ApplyIcon(fabIco, "layout-grid")

