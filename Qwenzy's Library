        -- SLIDER
        function Tab:CreateSlider(cfg_)
            local minV = cfg_.Range and cfg_.Range[1] or 0
            local maxV = cfg_.Range and cfg_.Range[2] or 100
            local incr = cfg_.Increment or 1
            local suf  = cfg_.Suffix or ""
            local val  = math.clamp(cfg_.CurrentValue or minV, minV, maxV)
            Qwenzy.Flags[cfg_.Flag or ""] = val

            local c = Card(60)
            New("TextLabel", {
                Size=UDim2.new(0.6,0,0,20), Position=UDim2.new(0,12,0,8),
                BackgroundTransparency=1, Text=cfg_.Name or "Slider",
                TextColor3=T.TextP, TextSize=12, Font=Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Left, ZIndex=3,
            }, c)
            local valLbl = New("TextLabel", {
                Size=UDim2.new(0.4,-12,0,20), Position=UDim2.new(0.6,0,0,8),
                BackgroundTransparency=1, Text=tostring(val).." "..suf,
                TextColor3=T.TextA, TextSize=12, Font=Enum.Font.GothamBold,
                TextXAlignment=Enum.TextXAlignment.Right, ZIndex=3,
            }, c)

            local track = New("Frame", {
                Size=UDim2.new(1,-24,0,5), Position=UDim2.new(0,12,0,36),
                BackgroundColor3=T.BGS, BorderSizePixel=0, ZIndex=3,
            }, c)
            Round(track, 3)
            local pct = (val-minV)/(maxV-minV)
            local fill = New("Frame", {
                Size=UDim2.new(pct,0,1,0), BackgroundColor3=T.Acc, BorderSizePixel=0, ZIndex=4,
            }, track)
            Round(fill, 3)
            local knob = New("Frame", {
                Size=UDim2.new(0,14,0,14),
                Position=UDim2.new(pct,0,0.5,0), AnchorPoint=Vector2.new(0.5,0.5),
                BackgroundColor3=Color3.fromRGB(240,245,255), BorderSizePixel=0, ZIndex=5,
            }, track)
            Round(knob, 7)
            Stroke(knob, T.Acc, 1.5, 0.2)

            local draggingS = false
            local function Update(mx)
                local rel = math.clamp(mx - track.AbsolutePosition.X, 0, track.AbsoluteSize.X)
                local p = rel / track.AbsoluteSize.X
                local raw = minV + p*(maxV-minV)
                local stepped = math.clamp(math.round(raw/incr)*incr, minV, maxV)
                if stepped == val then return end
                val = stepped
                local np = (stepped-minV)/(maxV-minV)
                Tween(fill, {Size=UDim2.new(np,0,1,0)}, 0.04)
                Tween(knob, {Position=UDim2.new(np,0,0.5,0)}, 0.04)
                valLbl.Text = tostring(stepped).." "..suf
                Qwenzy.Flags[cfg_.Flag or ""] = stepped
                if cfg_.Callback then task.spawn(cfg_.Callback, stepped) end
            end

            local shb = New("TextButton", {
                Size=UDim2.new(1,0,1,28), Position=UDim2.new(0,0,0,-14),
                BackgroundTransparency=1, Text="", ZIndex=6,
            }, track)
            shb.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or
                   inp.UserInputType == Enum.UserInputType.Touch then
                    draggingS = true
                    Tween(knob, {Size=UDim2.new(0,17,0,17)}, 0.1, Enum.EasingStyle.Back)
                    Update(inp.Position.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or
                   inp.UserInputType == Enum.UserInputType.Touch then
                    if draggingS then
                        draggingS = false
                        Tween(knob, {Size=UDim2.new(0,14,0,14)}, 0.1)
                    end
                end
            end)
            RunService.RenderStepped:Connect(function()
                if draggingS then Update(Mouse.X) end
            end)

            local o = {CurrentValue=val}
            function o:Set(v)
                v=math.clamp(v,minV,maxV); val=v; o.CurrentValue=v
                local np=(v-minV)/(maxV-minV)
                Tween(fill,{Size=UDim2.new(np,0,1,0)},0.2)
                Tween(knob,{Position=UDim2.new(np,0,0.5,0)},0.2)
                valLbl.Text=tostring(v).." "..suf
                Qwenzy.Flags[cfg_.Flag or ""]=v
                if cfg_.Callback then task.spawn(cfg_.Callback,v) end
            end
            return o
        end

