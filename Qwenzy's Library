                            selected[opt] = true
                        end
                        for o2, refs in pairs(itemRefs) do
                            local s = selected[o2]==true
                            Tween(refs.item,{BackgroundColor3=s and T.SurfaceH or T.Surface},0.12)
                            Tween(refs.chk,{BackgroundTransparency=s and 0 or 1},0.12)
                            refs.lbl.TextColor3 = s and T.TextA or T.TextP
                            refs.lbl.Font = s and Enum.Font.GothamBold or Enum.Font.Gotham
