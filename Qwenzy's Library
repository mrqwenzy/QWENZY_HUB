local function onKey(input, gameProcessed, isSimulated)
    task.spawn(function()
        if not gameProcessed and Ver.Value == currVer then
            for _, moveName in ipairs(Config.BackStab.Moves) do
                local key = getMoveKey(moveName)
                if key and input.KeyCode == key then
                    local target = GetClosestCharacter(Config.BackStab.Range)
                    if target then
                        DashBehindTarget(target, Config.BackStab.Speed)
                    end
                end
            end
        end
    end)

    if
        not gameProcessed
        and AutoConfig.YujiFlash
        and character():GetAttribute("Moveset") == "Itadori"
        and (
            input.KeyCode == Enum.KeyCode.Three
            or (input.KeyCode == Enum.KeyCode.One and character().Humanoid.FloorMaterial == Enum.Material.Air)
        )
        and Players.LocalPlayer.PlayerGui.Main.Moveset["Divergent Fist"].Cooldown.Size.Y.Scale == 0
    then
        if active then return end
        active = true

        if isSimulated then
            TriggerMove(input.KeyCode)
        end
        task.wait(Timing_1)
        TriggerMove(input.KeyCode)
        task.wait(0.3)
        active = false
    end
end

local function simulateKeyFromMove(moveName)
    local key = getMoveKey(moveName)
    if not key then return end
    onKey({ KeyCode = key, UserInputType = Enum.UserInputType.Keyboard }, false)
end

local function hookButton(frame)
    if not frame:IsA("Frame") then return end

    local function onActivated()
        if Ver.Value == currVer then
            simulateKeyFromMove(frame.Name)
        end
    end

    local btn = frame:FindFirstChildWhichIsA("TextButton")
             or frame:FindFirstChildWhichIsA("ImageButton")

    if btn then
        btn.Activated:Connect(onActivated)
    else
        frame.InputBegan:Connect(function(input)
            if
                input.UserInputType == Enum.UserInputType.Touch
                or input.UserInputType == Enum.UserInputType.MouseButton1
            then
                onActivated()
            end
        end)
    end
end

local function hookHotbarButtons()
    local moveset = Players.LocalPlayer.PlayerGui:WaitForChild("Main"):WaitForChild("Moveset")
    for _, frame in ipairs(moveset:GetChildren()) do
        hookButton(frame)
    end
    moveset.ChildAdded:Connect(function(child)
        task.wait()
        hookButton(child)
    end)
end

hookHotbarButtons()
