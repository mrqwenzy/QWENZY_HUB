    -- =============================================
    --  CREATE TAB
    -- =============================================
    function Window:CreateTab(name, icon)
        self._tabN += 1
        local order  = self._tabN
        local isFirst = order == 1
        local mob    = isMobile

        local TAB_SH = 0.11  -- tab button as fraction of sidebar height

        local btn = New("TextButton", {
            Size=UDim2.new(1,0,TAB_SH,0),
            BackgroundColor3=isFirst and T.SurfaceH or T.Tab,
            BackgroundTransparency=isFirst and 0 or 1,
            BorderSizePixel=0, Text="", AutoButtonColor=false,
            ZIndex=3, LayoutOrder=order,
        }, tabScroll)
        Round(btn, 8)

        -- Active indicator: left bar on desktop, bottom dot on mobile
        local indSize   = mob and UDim2.new(0.5,0,0,2)  or UDim2.new(0,2,0.5,0)
        local indPos    = mob and UDim2.new(0.25,0,1,-2) or UDim2.new(0,0,0.25,0)
        local ind = New("Frame", {
            Size=indSize, Position=indPos,
            BackgroundColor3=T.Acc, BackgroundTransparency=isFirst and 0 or 1,
            BorderSizePixel=0, ZIndex=4,
        }, btn)
        Round(ind, 2)

        local icoOff = mob and 0 or 10
        local tabIco
        if icon and icon ~= "" then
            local icoSz = mob and 16 or 16
            tabIco = New("ImageLabel", {
                Size=UDim2.new(0,icoSz,0,icoSz),
                Position=mob and UDim2.new(0.5,0,0.5, mob and -5 or 0)
                             or UDim2.new(0,10,0.5,0),
                AnchorPoint=mob and Vector2.new(0.5,0.5) or Vector2.new(0,0.5),
                BackgroundTransparency=1,
                ImageColor3=isFirst and T.AccB or T.TextM, ZIndex=4,
            }, btn)
            ApplyIcon(tabIco, icon)
            if not mob then icoOff = 32 end
        end

        local lbl
        if mob then
            -- Icon-only sidebar: show tiny name below
            lbl = New("TextLabel", {
                Size=UDim2.new(1,0,0,9), Position=UDim2.new(0,0,1,-11),
                BackgroundTransparency=1, Text=name:sub(1,5),
                TextColor3=isFirst and T.TextA or T.TextM,
                TextSize=7, Font=Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Center, ZIndex=4,
            }, btn)
        else
            lbl = New("TextLabel", {
                Size=UDim2.new(1,-icoOff-6,1,0), Position=UDim2.new(0,icoOff,0,0),
                BackgroundTransparency=1, Text=name,
                TextColor3=isFirst and T.TextA or T.TextM,
                TextSize=12, Font=isFirst and Enum.Font.GothamBold or Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Left, ZIndex=4,
            }, btn)
        end

        -- Page (scrollable)
        local page = New("ScrollingFrame", {
            Size=UDim2.new(1,0,1,0), Position=UDim2.new(0,0,0,0),
            BackgroundTransparency=1,
            BorderSizePixel=0, ScrollBarThickness=2,
            ScrollBarImageColor3=T.Acc, ScrollBarImageTransparency=0.4,
            CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y,
            Visible=isFirst,
        }, content)
        local pl = Instance.new("UIListLayout")
        pl.FillDirection = Enum.FillDirection.Vertical
        pl.HorizontalAlignment = Enum.HorizontalAlignment.Center
        pl.Padding = UDim.new(0, isMobile and 3 or 4)
        pl.SortOrder = Enum.SortOrder.LayoutOrder
        pl.Parent = page
        local pp = Instance.new("UIPadding")
        pp.PaddingTop = UDim.new(0, isMobile and 7 or 10)
        pp.PaddingBottom = UDim.new(0, isMobile and 10 or 16)
        pp.PaddingLeft = UDim.new(0, isMobile and 7 or 10)
        pp.PaddingRight = UDim.new(0, isMobile and 7 or 10)
        pp.Parent = page

        local Tab = {_page=page, _btn=btn, _ind=ind, _lbl=lbl, _ico=tabIco, _n=0}
        table.insert(self._tabs, Tab)
        if isFirst then self._activeTab = Tab end

        btn.MouseButton1Click:Connect(function()
            Ripple(btn)
            if self._activeTab == Tab then return end
            for _, fn in ipairs(self._dropdowns) do pcall(fn) end
            -- Deactivate old
            if self._activeTab then
                local ot = self._activeTab
                Tween(ot._btn, {BackgroundTransparency=1}, 0.15)
                Tween(ot._ind, {BackgroundTransparency=1}, 0.15)
                if ot._lbl then Tween(ot._lbl, {TextColor3=T.TextM}, 0.15) end
                if ot._ico  then Tween(ot._ico,  {ImageColor3=T.TextM}, 0.15) end
                if ot._lbl then ot._lbl.Font = Enum.Font.Gotham end
                ot._page.Visible = false
            end
            -- Activate new
            self._activeTab = Tab
            page.Visible = true
            page.CanvasPosition = Vector2.new(0,0)
            Tween(btn, {BackgroundTransparency=0, BackgroundColor3=T.SurfaceH}, 0.18)
            Tween(ind, {BackgroundTransparency=0}, 0.18)
            if lbl then Tween(lbl, {TextColor3=T.TextA}, 0.18); lbl.Font = Enum.Font.GothamBold end
            if tabIco then Tween(tabIco, {ImageColor3=T.AccB}, 0.18) end
        end)

        btn.MouseEnter:Connect(function()
            if self._activeTab ~= Tab then
                Tween(btn, {BackgroundTransparency=0.82, BackgroundColor3=T.SurfaceH}, 0.1)
            end
        end)
        btn.MouseLeave:Connect(function()
            if self._activeTab ~= Tab then
                Tween(btn, {BackgroundTransparency=1}, 0.1)
