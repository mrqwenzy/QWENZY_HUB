        local Tab = {_page=page, _btn=tabBtn, _ind=ind, _lbl=lbl, _T=T, _n=0,
                     _tabStroke=tabStroke, _indGlow=indGlow}
        table.insert(self._tabs, Tab)
        if isFirst then self._activeTab = Tab end

        local function SwitchToTab()
            Ripple(tabBtn, T.Acc)
            if self._activeTab == Tab then return end
            for _, fn in ipairs(self._dropdowns) do pcall(fn) end
            if self._activeTab then
                local old = self._activeTab
                Tween(old._btn, {BackgroundTransparency=1}, 0.2)
                if old._tabStroke then Tween(old._tabStroke, {Transparency=1}, 0.2) end
                Tween(old._ind, {BackgroundTransparency=1}, 0.2)
                if old._indGlow then Tween(old._indGlow, {Transparency=1}, 0.2) end
                if old._lbl then Tween(old._lbl, {TextColor3=T.TextM}, 0.2); old._lbl.Font = Enum.Font.Gotham end
                old._page.Visible = false
            end
            self._activeTab = Tab
            page.Visible = true
            page.Position = UDim2.new(0.05,0,0,0)
            Tween(page, {Position=UDim2.new(0,0,0,0)}, 0.22, Enum.EasingStyle.Quart)
            Tween(tabBtn, {BackgroundTransparency=0.25, BackgroundColor3=T.SurfaceH}, 0.2)
            Tween(tabStroke, {Transparency=0.55}, 0.2)
            Tween(ind, {BackgroundTransparency=0}, 0.2)
            Tween(indGlow, {Transparency=0.5}, 0.2)
            if lbl then Tween(lbl, {TextColor3=T.TextA}, 0.2); lbl.Font = Enum.Font.GothamBold end
            for _, ch in ipairs(tabBtn:GetChildren()) do
                if ch:IsA("ImageLabel") then Tween(ch, {ImageColor3=T.AccB}, 0.2) end
            end
        end

        tabBtn.MouseButton1Click:Connect(SwitchToTab)
        tabBtn.TouchTap:Connect(SwitchToTab)

        tabBtn.MouseEnter:Connect(function()
            if not IsMobile and self._activeTab ~= Tab then
                Tween(tabBtn, {BackgroundTransparency=0.75, BackgroundColor3=T.SurfaceH}, 0.15)
            end
        end)
        tabBtn.MouseLeave:Connect(function()
            if not IsMobile and self._activeTab ~= Tab then
                Tween(tabBtn, {BackgroundTransparency=1}, 0.15)
            end
        end)

