local function ShowLoadingScreen(title, subtitle, theme)
    local T = theme
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name               = "NexusLoading"
    screenGui.ResetOnSpawn       = false
    screenGui.ZIndexBehavior     = Enum.ZIndexBehavior.Sibling
    screenGui.IgnoreGuiInset     = true
    screenGui.Parent             = CoreGui

    -- Backdrop
    local backdrop = Instance.new("Frame")
    backdrop.Size            = UDim2.new(1,0,1,0)
    backdrop.BackgroundColor3 = T.BG
    backdrop.BackgroundTransparency = 0
    backdrop.BorderSizePixel = 0
    backdrop.ZIndex          = 100
    backdrop.Parent          = screenGui

    -- Animated gradient overlay
    local gradFrame = Instance.new("Frame")
    gradFrame.Size              = UDim2.new(1,0,1,0)
    gradFrame.BackgroundColor3  = Color3.new(1,1,1)
    gradFrame.BackgroundTransparency = 0
    gradFrame.BorderSizePixel   = 0
    gradFrame.ZIndex            = 101
    gradFrame.Parent            = backdrop
    MakeGradient(gradFrame,
        Color3.fromRGB(
            math.floor(T.Accent.R*255 * 0.3),
            math.floor(T.Accent.G*255 * 0.3),
            math.floor(T.Accent.B*255 * 0.3)
        ),
        T.BG, 135)
    gradFrame.BackgroundTransparency = 0.6

    -- Center container
    local center = Instance.new("Frame")
    center.Size              = UDim2.new(0, 400, 0, 220)
    center.Position          = UDim2.new(0.5,0,0.5,0)
    center.AnchorPoint       = Vector2.new(0.5,0.5)
    center.BackgroundColor3  = T.Surface
    center.BackgroundTransparency = 0
    center.BorderSizePixel   = 0
    center.ZIndex            = 102
    center.Parent            = backdrop
    MakeRound(center, 20)
    MakeStroke(center, T.Border, 1, 0.6)
    Shadow(center, 40)

    -- Accent top bar
    local accentBar = Instance.new("Frame")
    accentBar.Size             = UDim2.new(1,0,0,3)
    accentBar.Position         = UDim2.new(0,0,0,0)
    accentBar.BackgroundColor3 = T.Accent
    accentBar.BorderSizePixel  = 0
    accentBar.ZIndex           = 103
    accentBar.Parent           = center
    MakeRound(accentBar, 2)
    MakeGradient(accentBar, T.Accent, T.AccentLight, 90)

    -- Animated glow dot
    local glow = Instance.new("Frame")
    glow.Size             = UDim2.new(0,60,0,60)
    glow.Position         = UDim2.new(0.5,0,0,28)
    glow.AnchorPoint      = Vector2.new(0.5,0)
    glow.BackgroundColor3 = T.Accent
    glow.BackgroundTransparency = 0.3
    glow.BorderSizePixel  = 0
    glow.ZIndex           = 103
    glow.Parent           = center
    MakeRound(glow, 30)

    local glowInner = Instance.new("Frame")
    glowInner.Size             = UDim2.new(0,36,0,36)
    glowInner.Position         = UDim2.new(0.5,0,0.5,0)
    glowInner.AnchorPoint      = Vector2.new(0.5,0.5)
    glowInner.BackgroundColor3 = T.AccentLight
    glowInner.BorderSizePixel  = 0
    glowInner.ZIndex           = 104
    glowInner.Parent           = glow
    MakeRound(glowInner, 18)

    -- Pulse animation
    local function pulseGlow()
        Tween(glow, {BackgroundTransparency=0.6, Size=UDim2.new(0,72,0,72), Position=UDim2.new(0.5,0,0,22)}, 0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
        task.wait(0.9)
        Tween(glow, {BackgroundTransparency=0.3, Size=UDim2.new(0,60,0,60), Position=UDim2.new(0.5,0,0,28)}, 0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
        task.wait(0.9)
    end

    -- Title
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size              = UDim2.new(1,-40,0,28)
    titleLabel.Position          = UDim2.new(0,20,0,105)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text              = title or "NexusUI"
    titleLabel.TextColor3        = T.TextPrimary
    titleLabel.TextSize          = 22
    titleLabel.Font              = Enum.Font.GothamBold
    titleLabel.TextXAlignment    = Enum.TextXAlignment.Center
    titleLabel.ZIndex            = 103
    titleLabel.Parent            = center

    local subtitleLabel = Instance.new("TextLabel")
    subtitleLabel.Size              = UDim2.new(1,-40,0,20)
    subtitleLabel.Position          = UDim2.new(0,20,0,136)
    subtitleLabel.BackgroundTransparency = 1
    subtitleLabel.Text              = subtitle or "Loading..."
    subtitleLabel.TextColor3        = T.TextSecond
    subtitleLabel.TextSize          = 14
