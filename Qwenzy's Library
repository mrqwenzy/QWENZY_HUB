local _nSG, _nCont, _nN = nil, nil, 0

function Qwenzy:Notify(cfg)
    -- Lazy init
    if not _nSG or not _nSG.Parent then
        _nSG = New("ScreenGui", {Name="QwenzyNotifications", ResetOnSpawn=false,
            ZIndexBehavior=Enum.ZIndexBehavior.Sibling, IgnoreGuiInset=true}, ROOT)
        _nCont = New("Frame", {
            Size=UDim2.new(0,300,1,-16), Position=UDim2.new(1,-314,0,8),
            BackgroundTransparency=1, BorderSizePixel=0,
        }, _nSG)
        local ul = Instance.new("UIListLayout")
        ul.FillDirection = Enum.FillDirection.Vertical
        ul.VerticalAlignment = Enum.VerticalAlignment.Bottom
        ul.Padding = UDim.new(0,5)
        ul.SortOrder = Enum.SortOrder.LayoutOrder
        ul.Parent = _nCont
    end

    _nN += 1
    local dur = cfg.Duration or 5

    -- Card
    local card = New("Frame", {
        Name="N".._nN, Size=UDim2.new(1,0,0,70),
        BackgroundColor3=T.Panel, BorderSizePixel=0,
        ClipsDescendants=true, LayoutOrder=_nN,
    }, _nCont)
    Round(card, 10)
    Stroke(card, T.Border, 1, 0.3)

    -- Left accent bar
    local bar = New("Frame", {
        Size=UDim2.new(0,3,1,0), BackgroundColor3=T.Acc,
        BorderSizePixel=0, ZIndex=3,
    }, card)
    Grad(bar, T.AccD, T.AccB, 180)

    local xOff = 18
    if cfg.Image and cfg.Image ~= 0 then
        local ibg = New("Frame", {
            Size=UDim2.new(0,36,0,36), Position=UDim2.new(0,14,0.5,0),
            AnchorPoint=Vector2.new(0,0.5), BackgroundColor3=T.Acc,
            BackgroundTransparency=0.85, BorderSizePixel=0, ZIndex=2,
        }, card)
        Round(ibg, 10)
        local ico = New("ImageLabel", {
            Size=UDim2.new(0,20,0,20), Position=UDim2.new(0.5,0,0.5,0),
            AnchorPoint=Vector2.new(0.5,0.5), BackgroundTransparency=1,
            ImageColor3=T.Acc, ZIndex=3,
        }, ibg)
        ApplyIcon(ico, cfg.Image)
        xOff = 58
    end

    New("TextLabel", {
        Size=UDim2.new(1,-xOff-10,0,18), Position=UDim2.new(0,xOff,0,12),
        BackgroundTransparency=1, Text=cfg.Title or "Notice",
        TextColor3=T.TextP, TextSize=13, Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=2,
    }, card)
    New("TextLabel", {
        Size=UDim2.new(1,-xOff-10,0,18), Position=UDim2.new(0,xOff,0,32),
        BackgroundTransparency=1, Text=cfg.Content or "",
        TextColor3=T.TextS, TextSize=11, Font=Enum.Font.Gotham,
        TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true, ZIndex=2,
    }, card)

    -- Progress bar
    local pbg = New("Frame", {
        Size=UDim2.new(1,0,0,2), Position=UDim2.new(0,0,1,-2),
        BackgroundColor3=T.BGS, BorderSizePixel=0, ZIndex=3,
    }, card)
    local pbar = New("Frame", {
        Size=UDim2.new(1,0,1,0), BackgroundColor3=T.Acc, BorderSizePixel=0, ZIndex=4,
    }, pbg)

    -- Animate in
    card.Position = UDim2.new(1,20,0,0)
    Tween(card, {Position=UDim2.new(0,0,0,0)}, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    local gone = false
    local function dismiss()
        if gone then return end; gone = true
        Tween(card, {Position=UDim2.new(1,20,0,0), BackgroundTransparency=1}, 0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.22, function() pcall(function() card:Destroy() end) end)
    end

    New("TextButton", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=9}, card)
        .MouseButton1Click:Connect(dismiss)

    task.spawn(function()
        Tween(pbar, {Size=UDim2.new(0,0,1,0)}, dur, Enum.EasingStyle.Linear)
        task.wait(dur); dismiss()
    end)
end

