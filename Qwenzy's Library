            local pageLayout = Instance.new("UIListLayout")
            pageLayout.FillDirection      = Enum.FillDirection.Vertical
            pageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            pageLayout.Padding            = UDim.new(0, 5)
            pageLayout.SortOrder          = Enum.SortOrder.LayoutOrder
            pageLayout.Parent             = page
            MakePadding(page, 10, 16, 12, 12)

            local Tab = {
                _page     = page,
                _tabBtn   = tabBtn,
                _indicator = indicator,
                _tabLabel  = tabLabel,
                _theme     = T,
                _configSave = configSave,
                _itemOrder = 0,
            }

            -- Register
            table.insert(Window._tabs, Tab)
            if isFirst then Window._activeTab = Tab end

            -- Tab activation
            tabBtn.MouseButton1Click:Connect(function()
                Ripple(tabBtn)
                if Window._activeTab == Tab then return end

                -- Deactivate old
                if Window._activeTab then
                    local old = Window._activeTab
                    old._page.Visible = false
                    Tween(old._tabBtn, {BackgroundTransparency=1}, 0.2)
                    Tween(old._indicator, {BackgroundTransparency=1}, 0.2)
                    Tween(old._tabLabel, {TextColor3=T.TextMuted}, 0.2)
                    old._tabLabel.Font = Enum.Font.Gotham
                end

                -- Activate new
                Window._activeTab = Tab
                Tab._page.Visible = true
                Tab._page.Position = UDim2.new(0.04,0,0,0)
                Tween(Tab._page, {Position = UDim2.new(0,0,0,0)}, 0.22, Enum.EasingStyle.Quart)
                Tween(tabBtn, {BackgroundTransparency=0}, 0.2)
                Tween(indicator, {BackgroundTransparency=0}, 0.2)
                Tween(tabLabel, {TextColor3=T.TextAccent}, 0.2)
                tabLabel.Font = Enum.Font.GothamBold
            end)

            -- ── Tab Element Helpers ────────────────
            local function NextOrder(self_)
                self_._itemOrder += 1
                return self_._itemOrder
            end

            local function BaseCard(tab, height)
                tab._itemOrder = (tab._itemOrder or 0) + 1
                local card = Instance.new("Frame")
                card.Name             = "Card_" .. tab._itemOrder
                card.Size             = UDim2.new(1,0,0,height or 50)
                card.BackgroundColor3 = T.Surface
                card.BorderSizePixel  = 0
                card.ZIndex           = 2
                card.LayoutOrder      = tab._itemOrder
                card.Parent           = tab._page
                MakeRound(card, 10)
                MakeStroke(card, T.Border, 1, 0.7)
                return card
            end

            local function HoverCard(card, base, hover)
                card.MouseEnter:Connect(function()
                    Tween(card, {BackgroundColor3 = hover or T.SurfaceHover}, 0.18)
                end)
                card.MouseLeave:Connect(function()
                    Tween(card, {BackgroundColor3 = base or T.Surface}, 0.18)
                end)
            end

