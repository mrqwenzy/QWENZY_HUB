-- ===================================================
--  NOTIFICATION
-- ===================================================
local NotifSG, NotifCont
local notifN = 0

local function EnsureNotif(T)
    if NotifSG and NotifSG.Parent then return end
    NotifSG = New("ScreenGui", {Name="QwenzyNotifications", ResetOnSpawn=false,
        ZIndexBehavior=Enum.ZIndexBehavior.Sibling, IgnoreGuiInset=true}, ROOT)
    NotifCont = New("Frame", {
        Size=UDim2.new(0,320,1,-12), Position=UDim2.new(1,-334,0,6),
        BackgroundTransparency=1, BorderSizePixel=0,
    }, NotifSG)
    local ul = Instance.new("UIListLayout")
    ul.FillDirection = Enum.FillDirection.Vertical
    ul.VerticalAlignment = Enum.VerticalAlignment.Bottom
    ul.HorizontalAlignment = Enum.HorizontalAlignment.Center
    ul.Padding = UDim.new(0,6)
    ul.SortOrder = Enum.SortOrder.LayoutOrder
    ul.Parent = NotifCont
end

function Qwenzy:Notify(cfg)
    local T = self._T
    EnsureNotif(T)
    notifN += 1
    local dur = cfg.Duration or 5

    local card = New("Frame", {
        Name="N"..notifN, Size=UDim2.new(1,0,0,76),
        BackgroundColor3=T.Panel, BorderSizePixel=0,
        ClipsDescendants=true, LayoutOrder=notifN,
    }, NotifCont)
    Round(card, 12)
    Stroke(card, T.Border, 1, 0.45)

    local topBar = New("Frame", {Size=UDim2.new(1,0,0,2), BackgroundColor3=T.Acc, BorderSizePixel=0, ZIndex=2}, card)
    Grad(topBar, T.AccD, T.AccB, 90)

    local xOff = 14
    if cfg.Image and cfg.Image ~= 0 then
        local ibg = New("Frame", {
            Size=UDim2.new(0,40,0,40), Position=UDim2.new(0,12,0.5,0),
            AnchorPoint=Vector2.new(0,0.5), BackgroundColor3=T.Acc,
            BackgroundTransparency=0.8, BorderSizePixel=0, ZIndex=2,
        }, card)
        Round(ibg, 11)
        local ico = New("ImageLabel", {
            Size=UDim2.new(0,22,0,22), Position=UDim2.new(0.5,0,0.5,0),
            AnchorPoint=Vector2.new(0.5,0.5), BackgroundTransparency=1,
            ImageColor3=T.AccB, ZIndex=3,
        }, ibg)
        ApplyIcon(ico, cfg.Image)
        xOff = 62
    end

    New("TextLabel", {
        Size=UDim2.new(1,-xOff-10,0,20), Position=UDim2.new(0,xOff,0,14),
        BackgroundTransparency=1, Text=cfg.Title or "Notification",
        TextColor3=T.TextP, TextSize=14, Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=2,
    }, card)

    New("TextLabel", {
        Size=UDim2.new(1,-xOff-10,0,20), Position=UDim2.new(0,xOff,0,36),
        BackgroundTransparency=1, Text=cfg.Content or "",
        TextColor3=T.TextS, TextSize=12, Font=Enum.Font.Gotham,
        TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true, ZIndex=2,
    }, card)

    local pt = New("Frame", {Size=UDim2.new(1,0,0,3), Position=UDim2.new(0,0,1,-3),
        BackgroundColor3=T.BGS, BorderSizePixel=0, ZIndex=3}, card)
    local pf = New("Frame", {Size=UDim2.new(1,0,1,0), BackgroundColor3=T.Acc, BorderSizePixel=0, ZIndex=4}, pt)
    Grad(pf, T.AccD, T.AccB, 90)

    card.Position = UDim2.new(1,20,0,0)
    Tween(card, {Position=UDim2.new(0,0,0,0)}, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    local dismissed = false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        Tween(card, {Position=UDim2.new(1,24,0,0), BackgroundTransparency=1}, 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.25, function() if card then card:Destroy() end end)
    end

    local hit = New("TextButton", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=10}, card)
    hit.MouseButton1Click:Connect(dismiss)

    task.spawn(function()
        Tween(pf, {Size=UDim2.new(0,0,1,0)}, dur, Enum.EasingStyle.Linear)
        task.wait(dur)
        dismiss()
    end)
end

