            }, c)

            local picker = New("Frame", {
                Size=UDim2.new(1,-28,0,WHEEL+BH+22), Position=UDim2.new(0,14,0,52),
                BackgroundTransparency=1, BorderSizePixel=0, ZIndex=3, Visible=false,
            }, c)

            local wheelClip = New("Frame", {
                Size=UDim2.new(0,WHEEL,0,WHEEL), Position=UDim2.new(0.5,0,0,0),
                AnchorPoint=Vector2.new(0.5,0), BackgroundColor3=Color3.fromRGB(10,10,10),
