    MakeLabel(settings.Title or "Key System", 20, T.TextPrimary, 28, Enum.Font.GothamBold):TweenPosition(UDim2.new(0,84,0,26),nil,nil,0,true)
    local titleL = card:FindFirstChildWhichIsA("TextLabel")
    if titleL then titleL.Position = UDim2.new(0,84,0,26) end

    MakeLabel(settings.Title or "Key System", 20, T.TextPrimary, 26, Enum.Font.GothamBold)
    MakeLabel(settings.Subtitle or "Authentication Required", 13, T.TextSecond, 52)
    MakeLabel(settings.Note or "Enter your key to continue.", 12, T.TextMuted, 80)

    -- Input
    local inputBG = Instance.new("Frame")
    inputBG.Size             = UDim2.new(1,-48,0,44)
    inputBG.Position         = UDim2.new(0,24,0,118)
    inputBG.BackgroundColor3 = T.BGSecondary
    inputBG.BorderSizePixel  = 0
    inputBG.Parent           = card
    MakeRound(inputBG, 10)
    MakeStroke(inputBG, T.Border, 1, 0.5)

    local inputBox = Instance.new("TextBox")
    inputBox.Size              = UDim2.new(1,-20,1,0)
    inputBox.Position          = UDim2.new(0,12,0,0)
    inputBox.BackgroundTransparency = 1
    inputBox.Text              = ""
    inputBox.PlaceholderText   = "Enter your key..."
    inputBox.TextColor3        = T.TextPrimary
    inputBox.PlaceholderColor3 = T.TextMuted
    inputBox.TextSize          = 14
    inputBox.Font              = Enum.Font.GothamMono
    inputBox.ClearTextOnFocus  = false
    inputBox.TextXAlignment    = Enum.TextXAlignment.Left
    inputBox.Parent            = inputBG

    -- Status label
    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size              = UDim2.new(1,-48,0,18)
    statusLabel.Position          = UDim2.new(0,24,0,168)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Text              = ""
    statusLabel.TextColor3        = T.Danger
    statusLabel.TextSize          = 12
    statusLabel.Font              = Enum.Font.Gotham
    statusLabel.TextXAlignment    = Enum.TextXAlignment.Left
    statusLabel.Parent            = card

    -- Buttons
    local function MakeButton(text, color, x, w, y)
        local btn = Instance.new("TextButton")
        btn.Size             = UDim2.new(0,w,0,40)
        btn.Position         = UDim2.new(0,x,0,y)
        btn.BackgroundColor3 = color
        btn.BorderSizePixel  = 0
        btn.Text             = text
        btn.TextColor3       = Color3.fromRGB(255,255,255)
        btn.TextSize         = 14
        btn.Font             = Enum.Font.GothamBold
        btn.AutoButtonColor  = false
        btn.Parent           = card
        MakeRound(btn, 10)

        btn.MouseEnter:Connect(function()
            Tween(btn, {BackgroundColor3 = color:Lerp(Color3.fromRGB(255,255,255), 0.08)}, 0.15)
        end)
        btn.MouseLeave:Connect(function()
            Tween(btn, {BackgroundColor3 = color}, 0.15)
        end)
        btn.MouseButton1Down:Connect(function()
            Ripple(btn)
            Tween(btn, {Size = UDim2.new(0, w-4, 0, 38), Position = UDim2.new(0, x+2, 0, y+1)}, 0.08)
        end)
        btn.MouseButton1Up:Connect(function()
            Tween(btn, {Size = UDim2.new(0, w, 0, 40), Position = UDim2.new(0, x, 0, y)}, 0.1)
        end)
        return btn
    end

    local btnW = (420 - 48 - 8) / 2
    local closeBtn  = MakeButton("Cancel",  T.Surface,  24,      btnW, 230)
    local submitBtn = MakeButton("Confirm", T.Accent,   24+btnW+8, btnW, 230)
    MakeStroke(closeBtn, T.Border, 1, 0.5)

    -- Save key check
    local savedKey = nil
    -- Key saving requires executor filesystem; skipped for compatibility

    local function ValidateKey(key)
        local keys = settings.Key or {}
        for _, k in ipairs(keys) do
            if type(k) == "string" then
                local rawKey = k
                if settings.GrabKeyFromSite then
                    pcall(function()
                        rawKey = _HttpGet(k):gsub("%s+","")
                    end)
                end
                if key == rawKey or key == k then
                    return true
                end
            end
        end
        return false
    end

    local function TryKey(key)
        if ValidateKey(key) then
            -- (key saving requires executor filesystem, skipped)
            Tween(card, {BackgroundTransparency=1}, 0.3)
            Tween(backdrop, {BackgroundTransparency=1}, 0.3)
            task.wait(0.3)
            screenGui:Destroy()
            onSuccess()
        else
            statusLabel.Text = "✗  Invalid key. Please try again."
            Tween(inputBG, {BackgroundColor3 = T.Danger:Lerp(T.BGSecondary,0.85)}, 0.15)
            task.wait(0.8)
            Tween(inputBG, {BackgroundColor3 = T.BGSecondary}, 0.3)
            statusLabel.Text = ""
        end
    end

    if savedKey then
        TryKey(savedKey)
        return
    end

    submitBtn.MouseButton1Click:Connect(function()
        TryKey(inputBox.Text:gsub("%s+",""))
    end)
    closeBtn.MouseButton1Click:Connect(function()
        screenGui:Destroy()
        onFail and onFail()
    end)
    inputBox.FocusLost:Connect(function(enter)
        if enter then
            TryKey(inputBox.Text:gsub("%s+",""))
        end
    end)

    -- Animate in
    card.Position = UDim2.new(0.5,0,0.6,0)
    Tween(card, {Position = UDim2.new(0.5,0,0.5,0)}, 0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

