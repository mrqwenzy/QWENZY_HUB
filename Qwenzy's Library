end

-- Shared top-level overlay for ripples — always above every other UI layer
local RippleOverlaySG = New("ScreenGui", {
    Name="QwenzyRippleOverlay", ResetOnSpawn=false,
    ZIndexBehavior=Enum.ZIndexBehavior.Global,
    IgnoreGuiInset=true, DisplayOrder=9999,
}, ROOT)
local RippleOverlay = New("Frame", {
    Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
    BorderSizePixel=0, ZIndex=32766,
}, RippleOverlaySG)

local function Ripple(btn)
    -- AbsolutePosition of the button in screen space
    local ap = btn.AbsolutePosition
    local as = btn.AbsoluteSize
    local mx = math.clamp(CursorX(), ap.X, ap.X + as.X)
    local my = math.clamp(CursorY(), ap.Y, ap.Y + as.Y)

    local rp = New("Frame", {
        BackgroundColor3=Color3.fromRGB(255,255,255),
        BackgroundTransparency=0.75,
        Size=UDim2.new(0,0,0,0),
        -- Position in overlay screen-space coordinates
        Position=UDim2.new(0, mx, 0, my),
        AnchorPoint=Vector2.new(0.5,0.5),
        ZIndex=32767,
        ClipsDescendants=false,
    }, RippleOverlay)
    Round(rp, 999)

    local sz = math.max(as.X, as.Y) * 2.5
    Tween(rp, {Size=UDim2.new(0,sz,0,sz), BackgroundTransparency=1}, 0.5, Enum.EasingStyle.Quad)
    task.delay(0.5, function() if rp then rp:Destroy() end end)
end

-- ===================================================
--  CONFIG MANAGER
-- ===================================================
local ConfigManager = {}
ConfigManager.__index = ConfigManager

function ConfigManager.new(folder, file)
    local self = setmetatable({Data={}, _folder=folder or "QwenzyUI", _file=file or "Config"}, ConfigManager)
    self:Load()
    return self
end

function ConfigManager:_path() return self._folder.."/"..self._file..".json" end

function ConfigManager:Load()
    pcall(function()
        if not _isfolder(self._folder) then _makefolder(self._folder) end
        local p = self:_path()
        if _isfile(p) then
            local raw = _readfile(p)
            if raw and raw ~= "" then
                local ok, d = pcall(function() return HttpService:JSONDecode(raw) end)
                if ok and type(d)=="table" then self.Data = d end
            end
        end
    end)
end

function ConfigManager:Save()
    pcall(function()
        if not _isfolder(self._folder) then _makefolder(self._folder) end
        _writefile(self:_path(), HttpService:JSONEncode(self.Data))
    end)
end

function ConfigManager:Get(k, def)
    return self.Data[k] ~= nil and self.Data[k] or def
end

function ConfigManager:Set(k, v)
    self.Data[k] = v
    self:Save()
end

