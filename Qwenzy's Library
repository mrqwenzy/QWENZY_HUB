                Size=UDim2.new(1,-28,0,28), Position=UDim2.new(0,14,0,28),
                BackgroundColor3=T.BGS, BorderSizePixel=0, ZIndex=6,
            }, c)
            Round(dbg, 9)
            Stroke(dbg, T.Border, 1, 0.45)

            local dispLbl = New("TextLabel", {
                Size=UDim2.new(1,-32,1,0), Position=UDim2.new(0,10,0,0),
                BackgroundTransparency=1,
                Text=#initS>0 and table.concat(initS,", ") or "Select...",
                TextColor3=#initS>0 and T.TextP or T.TextM,
                TextSize=12, Font=Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=7,
            }, dbg)

            local arrow = New("TextLabel", {
                Size=UDim2.new(0,18,1,0), Position=UDim2.new(1,-20,0,0),
                BackgroundTransparency=1, Text="v", TextColor3=T.TextM,
                TextSize=11, Font=Enum.Font.GothamBold, TextXAlignment=Enum.TextXAlignment.Center, ZIndex=7,
            }, dbg)

            local listOuter = New("Frame", {
                Size=UDim2.new(0,100,0,0), BackgroundTransparency=1,
                BorderSizePixel=0, ZIndex=200, ClipsDescendants=true, Visible=false,
            }, sg)
            local listF = New("Frame", {
                Size=UDim2.new(1,0,0,0), BackgroundColor3=T.Panel,
                BorderSizePixel=0, ZIndex=201, AutomaticSize=Enum.AutomaticSize.Y,
            }, listOuter)
            Round(listF, 11)
            Stroke(listF, T.Border, 1, 0.45)
            local ll = Instance.new("UIListLayout")
            ll.FillDirection = Enum.FillDirection.Vertical
            ll.HorizontalAlignment = Enum.HorizontalAlignment.Center
            ll.SortOrder = Enum.SortOrder.LayoutOrder
            ll.Parent = listF
            local lp = Instance.new("UIPadding")
            lp.PaddingTop=UDim.new(0,4); lp.PaddingBottom=UDim.new(0,4)
            lp.PaddingLeft=UDim.new(0,4); lp.PaddingRight=UDim.new(0,4)
            lp.Parent = listF

            local itemRefs = {}
            local listH = 0

            local function UpdateDisplay()
                local keys = {}
                for k,v in pairs(selected) do if v then table.insert(keys,k) end end
                dispLbl.Text = #keys>0 and table.concat(keys,", ") or "Select..."
                dispLbl.TextColor3 = #keys>0 and T.TextP or T.TextM
            end

            local function CloseDD()
                if not open then return end
                open = false
                Tween(listOuter, {Size=UDim2.new(0,listOuter.AbsoluteSize.X,0,0)}, 0.18, Enum.EasingStyle.Quart)
                Tween(arrow, {Rotation=0}, 0.18)
                task.delay(0.18, function() if not open then listOuter.Visible=false end end)
            end

            table.insert(Window._dropdowns, CloseDD)

            local function RefreshItems(optList)
                for _, ch in ipairs(listF:GetChildren()) do
                    if ch:IsA("TextButton") then ch:Destroy() end
                end
                itemRefs = {}
                for i, opt in ipairs(optList) do
                    local item = New("TextButton", {
                        Size=UDim2.new(1,0,0,34),
                        BackgroundColor3=selected[opt] and T.SurfaceH or T.Surface,
                        BorderSizePixel=0, Text="", AutoButtonColor=false, ZIndex=202, LayoutOrder=i,
                    }, listF)
                    Round(item, 7)
                    local ilbl = New("TextLabel", {
                        Size=UDim2.new(1,-36,1,0), Position=UDim2.new(0,10,0,0),
                        BackgroundTransparency=1, Text=opt,
                        TextColor3=selected[opt] and T.TextA or T.TextP,
                        TextSize=13, Font=selected[opt] and Enum.Font.GothamBold or Enum.Font.Gotham,
                        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=203,
                    }, item)
                    local ichk = New("Frame", {
                        Size=UDim2.new(0,16,0,16), Position=UDim2.new(1,-24,0.5,0),
                        AnchorPoint=Vector2.new(0,0.5), BackgroundColor3=T.Acc,
                        BackgroundTransparency=selected[opt] and 0 or 1,
                        BorderSizePixel=0, ZIndex=203,
                    }, item)
                    Round(ichk, 8)
                    itemRefs[opt] = {item=item, lbl=ilbl, chk=ichk}

                    item.MouseEnter:Connect(function()
                        if not IsMobile and not selected[opt] then Tween(item,{BackgroundColor3=Qwenzy._T.SurfaceH},0.1) end
                    end)
                    item.MouseLeave:Connect(function()
                        if not IsMobile and not selected[opt] then Tween(item,{BackgroundColor3=Qwenzy._T.Surface},0.1) end
                    end)
                    item.MouseButton1Click:Connect(function()
                        Ripple(item)
                        if multi then
                            selected[opt] = not selected[opt]
                        else
                            for k in pairs(selected) do selected[k]=false end
                            selected[opt] = true
                        end
                        for o2, refs in pairs(itemRefs) do
                            local s = selected[o2]==true
                            Tween(refs.item,{BackgroundColor3=s and Qwenzy._T.SurfaceH or Qwenzy._T.Surface},0.12)
                            Tween(refs.chk,{BackgroundTransparency=s and 0 or 1},0.12)
                            refs.lbl.TextColor3 = s and Qwenzy._T.TextA or Qwenzy._T.TextP
                            refs.lbl.Font = s and Enum.Font.GothamBold or Enum.Font.Gotham
                        end
                        UpdateDisplay()
                        local res={}
                        for k,v in pairs(selected) do if v then table.insert(res,k) end end
                        Qwenzy.Flags[cfg_.Flag or ""] = res
                        if cfg_.Callback then task.spawn(cfg_.Callback, res) end
                        if not multi then CloseDD() end
                    end)
                end
                listH = math.min(#optList,6)*34+8
            end

            RefreshItems(opts)

            local headerHit = New("TextButton", {
                Size=UDim2.new(1,0,0,56), BackgroundTransparency=1, Text="", ZIndex=c.ZIndex+3,
            }, c)

            headerHit.MouseButton1Click:Connect(function()
                open = not open
                if open then
                    local ap = c.AbsolutePosition
                    local as = c.AbsoluteSize
                    listOuter.Size = UDim2.new(0,as.X,0,0)
                    listOuter.Position = UDim2.new(0,ap.X,0,ap.Y+as.Y+4)
                    listOuter.Visible = true
                    Tween(listOuter,{Size=UDim2.new(0,as.X,0,listH)},0.22,Enum.EasingStyle.Back,Enum.EasingDirection.Out)
                    Tween(arrow,{Rotation=180},0.22)
                else
                    CloseDD()
                end
            end)

            Track(UserInputService.InputBegan:Connect(function(inp)
                if (inp.UserInputType==Enum.UserInputType.MouseButton1
                 or inp.UserInputType==Enum.UserInputType.Touch) and open then
                    local mx = inp.UserInputType==Enum.UserInputType.Touch and inp.Position.X or Mouse.X
                    local my = inp.UserInputType==Enum.UserInputType.Touch and inp.Position.Y or Mouse.Y
                    local op,os = listOuter.AbsolutePosition, listOuter.AbsoluteSize
                    local cp,cs = c.AbsolutePosition, c.AbsoluteSize
                    if not (mx>=op.X and mx<=op.X+os.X and my>=op.Y and my<=op.Y+os.Y) and
                       not (mx>=cp.X and mx<=cp.X+cs.X and my>=cp.Y and my<=cp.Y+cs.Y) then
                        CloseDD()
                    end
                end
            end))

            local o = {CurrentOption=initS}
            function o:Refresh(newOpts)
                opts=newOpts; selected={}; RefreshItems(newOpts); UpdateDisplay()
            end
            function o:Set(newSel)
                for k in pairs(selected) do selected[k]=false end
                for _,v in ipairs(newSel) do selected[v]=true end
                o.CurrentOption=newSel; UpdateDisplay()
                for _, refs in pairs(itemRefs) do
                    local s = selected[refs.lbl.Text]==true
                    refs.item.BackgroundColor3 = s and Qwenzy._T.SurfaceH or Qwenzy._T.Surface
                    refs.chk.BackgroundTransparency = s and 0 or 1
                    refs.lbl.TextColor3 = s and Qwenzy._T.TextA or Qwenzy._T.TextP
                    refs.lbl.Font = s and Enum.Font.GothamBold or Enum.Font.Gotham
                end
                local res={}
                for k,v in pairs(selected) do if v then table.insert(res,k) end end
                Qwenzy.Flags[cfg_.Flag or ""] = res
                if cfg_.Callback then task.spawn(cfg_.Callback,res) end
            end
            return o
        end

        -- KEYBIND
        function Tab:CreateKeybind(cfg_)
            local curKey = cfg_.CurrentKeybind or "None"
            local listening = false
            Qwenzy.Flags[cfg_.Flag or ""] = curKey

            local c = Card(48)

            New("TextLabel", {
                Size=UDim2.new(1,-110,1,0), Position=UDim2.new(0,14,0,0),
                BackgroundTransparency=1, Text=cfg_.Name or "Keybind",
                TextColor3=T.TextP, TextSize=13, Font=Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Left, ZIndex=3,
            }, c)

            -- Hint label: shows [RClick: clear] while listening
            local hintLbl = New("TextLabel", {
                Size=UDim2.new(1,-14,0,12), Position=UDim2.new(0,14,1,-13),
                BackgroundTransparency=1, Text="",
                TextColor3=T.TextM, TextSize=10, Font=Enum.Font.Gotham,
                TextXAlignment=Enum.TextXAlignment.Left, ZIndex=3,
            }, c)

            local badge = New("TextButton", {
                Size=UDim2.new(0,90,0,28), Position=UDim2.new(1,-104,0.5,0),
                AnchorPoint=Vector2.new(0,0.5), BackgroundColor3=T.BGS,
                BorderSizePixel=0, Text=curKey == "None" and "None" or curKey,
                TextColor3=curKey == "None" and T.TextM or T.TextA,
                TextSize=12, Font=Enum.Font.GothamBold, AutoButtonColor=false, ZIndex=4,
            }, c)
            Round(badge, 8)
            local badgeStroke = Stroke(badge, T.Border, 1, 0.4)

            -- Pulse ring — visible only while listening
            local pulse = New("Frame", {
                Size=UDim2.new(1,0,1,0), Position=UDim2.new(0,0,0,0),
                BackgroundTransparency=1, BorderSizePixel=0, ZIndex=3,
            }, badge)
            Round(pulse, 8)
            local pulseStroke = Instance.new("UIStroke")
            pulseStroke.Color = T.Warn
            pulseStroke.Thickness = 0
            pulseStroke.Transparency = 0
            pulseStroke.Parent = pulse

            local pulseLoop = nil
            local function StartPulse()
                pulseStroke.Thickness = 2
                pulseLoop = task.spawn(function()
                    while listening do
                        Tween(pulseStroke, {Transparency=0.1, Thickness=2.5}, 0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
                        task.wait(0.55)
                        if not listening then break end
                        Tween(pulseStroke, {Transparency=0.7, Thickness=1.5}, 0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
                        task.wait(0.55)
                    end
                    pulseStroke.Thickness = 0
                end)
            end
            local function StopPulse()
                if pulseLoop then task.cancel(pulseLoop) pulseLoop = nil end
                pulseStroke.Thickness = 0
            end

            local function CommitKey(newKey)
                listening = false
                StopPulse()
                curKey = newKey
                badge.Text = newKey == "None" and "None" or newKey
                badge.TextColor3 = newKey == "None" and Qwenzy._T.TextM or Qwenzy._T.TextA
                Tween(badge, {BackgroundColor3=Qwenzy._T.BGS}, 0.15)
                Tween(badgeStroke, {Color=Qwenzy._T.Border, Transparency=0.4}, 0.15)
                hintLbl.Text = ""
                Qwenzy.Flags[cfg_.Flag or ""] = newKey
                Ripple(badge)
            end

            local function StartListening()
                if listening then
                    -- second click cancels
                    listening = false
                    StopPulse()
                    badge.Text = curKey == "None" and "None" or curKey
                    badge.TextColor3 = curKey == "None" and Qwenzy._T.TextM or Qwenzy._T.TextA
                    Tween(badge, {BackgroundColor3=Qwenzy._T.BGS}, 0.15)
                    Tween(badgeStroke, {Color=Qwenzy._T.Border, Transparency=0.4}, 0.15)
                    hintLbl.Text = ""
                    return
                end
                listening = true
                badge.Text = "Press key…"
                badge.TextColor3 = T.Warn
                Tween(badge, {BackgroundColor3=T.SurfaceH}, 0.15)
                Tween(badgeStroke, {Color=T.Warn, Transparency=0.1}, 0.15)
                hintLbl.Text = "Esc: cancel  •  RClick: clear"
                StartPulse()
            end

            badge.MouseButton1Click:Connect(StartListening)

            -- Right-click clears the keybind to "None"
            badge.MouseButton2Click:Connect(function()
                if listening then
                    CommitKey("None")
                else
                    CommitKey("None")
                    Qwenzy:Notify({
                        Title   = "Keybind Cleared",
                        Content = (cfg_.Name or "Keybind") .. " has been unbound.",
                        Image   = "x-circle",
                        Duration = 2,
                    })
                end
            end)

            Track(UserInputService.InputBegan:Connect(function(inp, gp)
                if listening then
                    if inp.UserInputType == Enum.UserInputType.Keyboard then
                        if inp.KeyCode == Enum.KeyCode.Escape then
                            -- Cancel — revert to previous key
                            listening = false
                            StopPulse()
                            badge.Text = curKey == "None" and "None" or curKey
                            badge.TextColor3 = curKey == "None" and Qwenzy._T.TextM or Qwenzy._T.TextA
                            Tween(badge, {BackgroundColor3=Qwenzy._T.BGS}, 0.15)
                            Tween(badgeStroke, {Color=Qwenzy._T.Border, Transparency=0.4}, 0.15)
                            hintLbl.Text = ""
                        else
                            CommitKey(inp.KeyCode.Name)
                            if cfg_.Callback then
                                -- notify that keybind changed, don't fire the action
                            end
                        end
                    elseif inp.UserInputType == Enum.UserInputType.MouseButton2 then
                        -- handled by MouseButton2Click above
                    end
                    return -- swallow all input while listening
                end
                -- Normal firing: only fire if NOT game-processed and key matches
                if not gp then
                    local kc = Enum.KeyCode[curKey]
                    if kc and inp.KeyCode == kc then
                        if cfg_.Callback then task.spawn(cfg_.Callback, false) end
                    end
                end
            end))

            HoverHit(c)

            local o = {CurrentKeybind=curKey}
            function o:Set(k)
                curKey = k
                badge.Text = k == "None" and "None" or k
                badge.TextColor3 = k == "None" and Qwenzy._T.TextM or Qwenzy._T.TextA
                o.CurrentKeybind = k
                Qwenzy.Flags[cfg_.Flag or ""] = k
            end
            return o
        end

        return Tab
    end -- CreateTab

    function Window:SetVisibility(v) self._main.Visible = v end
    function Window:IsVisible() return self._main.Visible end
    function Window:Destroy()
        for _, conn in ipairs(self._conns) do pcall(function() conn:Disconnect() end) end
        self._conns = {}
        local sz = self._main.Size
        Tween(self._main, {Size=UDim2.new(sz.X.Scale, sz.X.Offset, 0, 0)}, 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.25, function() pcall(function() self._sg:Destroy() end) end)
    end

    -- Animate in
    Tween(main, {Size=UDim2.new(0,WIN_W,0,WIN_H)}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    return Window
end -- CreateWindow

function Qwenzy:SetVisibility(v)
    for _,w in ipairs(self._windows) do pcall(function() w:SetVisibility(v) end) end
end
function Qwenzy:Destroy()
    for _,w in ipairs(self._windows) do pcall(function() w:Destroy() end) end
    self._windows={}
end

-- ===================================================
--  PERSISTENT CONFIG & THEME HELPERS
-- ===================================================
local _Cfg = ConfigManager.new("QwenzyUI", "QwenzyConfig")

local _CustomThemes = {}
pcall(function()
    local saved = _Cfg:Get("CustomThemes", {})
    for name, data in pairs(saved) do
        local T = {}
        for k, v in pairs(data) do
            if type(v)=="table" and #v==3 then
                T[k] = Color3.fromRGB(v[1],v[2],v[3])
            end
        end
        if T.BG and T.Acc then
            Themes[name] = T
            _CustomThemes[name] = true
        end
    end
end)

local function _C3S(c) return {math.floor(c.R*255),math.floor(c.G*255),math.floor(c.B*255)} end

local _activeThemeName = "Default"

function Qwenzy:ApplyTheme(newName)
    local newT = Themes[newName]
    if not newT then return end
    local oldT = Themes[_activeThemeName] or Themes.Default
    _activeThemeName = newName
    self._T = newT
    pcall(function() _Cfg:Set("ActiveTheme", newName) end)

    local colorMap = {}
    for key, oldC in pairs(oldT) do
        local newC = newT[key]
        if newC then
            local k = string.format("%d_%d_%d",
                math.floor(oldC.R*255), math.floor(oldC.G*255), math.floor(oldC.B*255))
            colorMap[k] = newC
        end
    end
    local function swap(c)
        if not c then return nil end
        local k = string.format("%d_%d_%d",
            math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255))
        return colorMap[k]
    end

    for _, win in ipairs(self._windows) do
        pcall(function()
            if not win._sg or not win._sg.Parent then return end
            local function walk(inst)
                pcall(function()
                    local cls = inst.ClassName
                    if cls=="Frame" or cls=="ScrollingFrame" or cls=="TextButton" or cls=="TextBox" then
                        local nc = swap(inst.BackgroundColor3)
                        if nc and inst.BackgroundTransparency < 0.98 then
                            Tween(inst,{BackgroundColor3=nc},0.3)
                        end
                    end
                    if cls=="TextLabel" or cls=="TextButton" or cls=="TextBox" then
                        local nc = swap(inst.TextColor3)
                        if nc then Tween(inst,{TextColor3=nc},0.3) end
                    end
                    if cls=="ImageLabel" or cls=="ImageButton" then
                        local nc = swap(inst.ImageColor3)
                        if nc then Tween(inst,{ImageColor3=nc},0.3) end
                    end
                    if cls=="UIStroke" then
                        local nc = swap(inst.Color)
                        if nc then Tween(inst,{Color=nc},0.3) end
                    end
                    if cls=="UIGradient" then
                        local ks = inst.Color.Keypoints
                        local changed, newKs = false, {}
                        for _, kp in ipairs(ks) do
                            local nc = swap(kp.Value)
                            if nc then changed=true end
                            table.insert(newKs, ColorSequenceKeypoint.new(kp.Time, nc or kp.Value))
                        end
                        if changed then inst.Color = ColorSequence.new(newKs) end
                    end
                end)
                for _, child in ipairs(inst:GetChildren()) do walk(child) end
            end
            walk(win._sg)
        end)
    end
end

function Qwenzy:SaveTheme(name, themeTable)
    local saved = _Cfg:Get("CustomThemes", {})
    local s = {}
    for k,v in pairs(themeTable) do s[k]=_C3S(v) end
    saved[name] = s
    _Cfg:Set("CustomThemes", saved)
    Themes[name] = themeTable
    _CustomThemes[name] = true
end

function Qwenzy:DeleteTheme(name)
    if not _CustomThemes[name] then return end
    local saved = _Cfg:Get("CustomThemes", {})
    saved[name]=nil; _Cfg:Set("CustomThemes",saved)
    Themes[name]=nil; _CustomThemes[name]=nil
end

function Qwenzy:GetThemeNames()
    local names = {}
    for _,v in ipairs({"Default","Midnight","Rose","Emerald","Neon","Sunset","Ocean","Void","Arctic"}) do
        table.insert(names, v)
    end
    for k in pairs(_CustomThemes) do table.insert(names, k) end
    return names
end

function Qwenzy:SaveConfig(slotName)
    local slots = _Cfg:Get("ConfigSlots", {})
    local data = {}
    for k,v in pairs(self.Flags) do
        local t = type(v)
        if t=="boolean" or t=="number" or t=="string" then data[k]=v end
    end
    slots[slotName] = data
    _Cfg:Set("ConfigSlots", slots)
end

function Qwenzy:LoadConfig(slotName)
    local slots = _Cfg:Get("ConfigSlots", {})
    local data = slots[slotName]
    if not data then return false end
    for k,v in pairs(data) do self.Flags[k]=v end
    return true
end

function Qwenzy:DeleteConfig(slotName)
    local slots = _Cfg:Get("ConfigSlots", {})
    slots[slotName]=nil; _Cfg:Set("ConfigSlots",slots)
end

function Qwenzy:GetConfigSlots()
    local slots = _Cfg:Get("ConfigSlots", {})
    local names = {}
    for name in pairs(slots) do table.insert(names,name) end
    table.sort(names)
    return names
end

function Qwenzy:GetConfig() return _Cfg end

local _savedTheme = _Cfg:Get("ActiveTheme", "Default")
if Themes[_savedTheme] then
    _activeThemeName = _savedTheme
    Qwenzy._T = Themes[_savedTheme]
end

-- ===================================================
--  RETURN MODULE
-- ===================================================
return Qwenzy
