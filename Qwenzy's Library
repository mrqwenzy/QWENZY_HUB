        iconFrame.Parent           = content
        MakeRound(iconFrame, 8)

        local img = Instance.new("ImageLabel")
        img.Size             = UDim2.new(0,20,0,20)
        img.Position         = UDim2.new(0.5,0,0.5,0)
        img.AnchorPoint      = Vector2.new(0.5,0.5)
        img.BackgroundTransparency = 1
        img.Image            = "rbxassetid://" .. tostring(iconId)
        img.ImageColor3      = T.AccentLight
        img.Parent           = iconFrame
        iconSize = 42
    end

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size              = UDim2.new(1,-iconSize,0,20)
    titleLabel.Position          = UDim2.new(0,iconSize,0,0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text              = config.Title or "Notification"
    titleLabel.TextColor3        = T.TextPrimary
    titleLabel.TextSize          = 14
    titleLabel.Font              = Enum.Font.GothamBold
    titleLabel.TextXAlignment    = Enum.TextXAlignment.Left
    titleLabel.TextWrapped       = true
    titleLabel.Parent            = content

    local bodyLabel = Instance.new("TextLabel")
    bodyLabel.Size              = UDim2.new(1,0,0,0)
    bodyLabel.Position          = UDim2.new(0,0,0,24)
    bodyLabel.BackgroundTransparency = 1
    bodyLabel.Text              = config.Content or ""
    bodyLabel.TextColor3        = T.TextSecond
    bodyLabel.TextSize          = 12
    bodyLabel.Font              = Enum.Font.Gotham
    bodyLabel.TextXAlignment    = Enum.TextXAlignment.Left
    bodyLabel.TextWrapped       = true
    bodyLabel.AutomaticSize     = Enum.AutomaticSize.Y
    bodyLabel.Parent            = content

    -- Progress bar
    local progTrack = Instance.new("Frame")
    progTrack.Size             = UDim2.new(1,0,0,2)
    progTrack.Position         = UDim2.new(0,0,1,-2)
    progTrack.BackgroundColor3 = T.BGSecondary
    progTrack.BorderSizePixel  = 0
    progTrack.Parent           = card

    local progFill = Instance.new("Frame")
    progFill.Size             = UDim2.new(1,0,1,0)
    progFill.BackgroundColor3 = T.Accent
    progFill.BorderSizePixel  = 0
    progFill.Parent           = progTrack
    MakeGradient(progFill, T.Accent, T.AccentLight, 90)

    -- Slide in
    card.Position = UDim2.new(1,20,0,0)
    Tween(card, {Position = UDim2.new(0,0,0,0)}, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    -- Auto dismiss
    task.spawn(function()
        Tween(progFill, {Size = UDim2.new(0,0,1,0)}, duration, Enum.EasingStyle.Linear)
        task.wait(duration)
        Tween(card, {Position = UDim2.new(1,20,0,0), BackgroundTransparency=1}, 0.3)
        task.wait(0.3)
        card:Destroy()
    end)

    -- Click to dismiss
    local dismiss = Instance.new("TextButton")
    dismiss.Size                 = UDim2.new(1,0,1,0)
    dismiss.BackgroundTransparency = 1
    dismiss.Text                 = ""
    dismiss.ZIndex               = card.ZIndex + 5
    dismiss.Parent               = card
    dismiss.MouseButton1Click:Connect(function()
        Tween(card, {Position = UDim2.new(1,20,0,0), BackgroundTransparency=1}, 0.3)
        task.wait(0.3)
        card:Destroy()
    end)
end

-- ═══════════════════════════════════════════════════
--  CREATE WINDOW
-- ═══════════════════════════════════════════════════
function Nexus:CreateWindow(config)
    local T
    if config.Theme and Themes[config.Theme] then
        T = Themes[config.Theme]
    else
        T = Themes.Default
    end
    self._activeTheme = T

    local configSave = nil
    if config.ConfigurationSaving and config.ConfigurationSaving.Enabled then
        configSave = ConfigManager.new(
            config.ConfigurationSaving.FolderName,
            config.ConfigurationSaving.FileName
        )
    end

    local function BootWindow()
        -- ── Main ScreenGui ──
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name           = "NexusUI_" .. (config.Name or "Window")
        screenGui.ResetOnSpawn   = false
        screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        screenGui.IgnoreGuiInset = true
        screenGui.Parent         = CoreGui

        -- ── Main frame ──
        local mainFrame = Instance.new("Frame")
        mainFrame.Name             = "MainFrame"
        mainFrame.Size             = UDim2.new(0,680,0,440)
        mainFrame.Position         = UDim2.new(0.5,0,0.5,0)
        mainFrame.AnchorPoint      = Vector2.new(0.5,0.5)
        mainFrame.BackgroundColor3 = T.BG
        mainFrame.BorderSizePixel  = 0
        mainFrame.ClipsDescendants = true
        mainFrame.Parent           = screenGui
        MakeRound(mainFrame, 16)
        MakeStroke(mainFrame, T.Border, 1, 0.5)
        Shadow(mainFrame, 50)

        -- Subtle background gradient
        MakeGradient(mainFrame,
            T.BGSecondary,
            T.BG, 145)

        -- ── Top Bar ──
        local topBar = Instance.new("Frame")
        topBar.Name             = "TopBar"
        topBar.Size             = UDim2.new(1,0,0,52)
        topBar.BackgroundColor3 = T.TopBar
        topBar.BorderSizePixel  = 0
        topBar.ZIndex           = 3
        topBar.Parent           = mainFrame
        MakeStroke(topBar, T.Border, 1, 0.7)

        -- Subtle top-bar gradient
        local tg = Instance.new("UIGradient")
        tg.Color    = ColorSequence.new(T.TopBar, T.BG)
        tg.Rotation = 180
        tg.Parent   = topBar

        -- Accent line at very top
        local accentLine = Instance.new("Frame")
        accentLine.Size             = UDim2.new(1,0,0,2)
        accentLine.BackgroundColor3 = T.Accent
        accentLine.BorderSizePixel  = 0
        accentLine.ZIndex           = 4
        accentLine.Parent           = topBar
        MakeGradient(accentLine, T.AccentDark, T.AccentLight, 90)

        -- Window icon
        local iconArea = Instance.new("Frame")
        iconArea.Size             = UDim2.new(0,36,0,36)
        iconArea.Position         = UDim2.new(0,14,0.5,0)
        iconArea.AnchorPoint      = Vector2.new(0,0.5)
        iconArea.BackgroundColor3 = T.Accent
        iconArea.BackgroundTransparency = 0.82
        iconArea.BorderSizePixel  = 0
        iconArea.ZIndex           = 4
        iconArea.Parent           = topBar
        MakeRound(iconArea, 10)

        if config.Icon and config.Icon ~= 0 then
            local iconImg = Instance.new("ImageLabel")
            iconImg.Size             = UDim2.new(0,22,0,22)
            iconImg.Position         = UDim2.new(0.5,0,0.5,0)
            iconImg.AnchorPoint      = Vector2.new(0.5,0.5)
            iconImg.BackgroundTransparency = 1
            iconImg.Image            = "rbxassetid://" .. tostring(GetIcon(config.Icon))
            iconImg.ImageColor3      = T.AccentLight
            iconImg.ZIndex           = 5
            iconImg.Parent           = iconArea
        end

        -- Window title
        local winTitle = Instance.new("TextLabel")
        winTitle.Size              = UDim2.new(1,-180,0,22)
        winTitle.Position          = UDim2.new(0,60,0.5,0)
        winTitle.AnchorPoint       = Vector2.new(0,0.5)
        winTitle.BackgroundTransparency = 1
        winTitle.Text              = config.Name or "NexusUI"
        winTitle.TextColor3        = T.TextPrimary
        winTitle.TextSize          = 16
        winTitle.Font              = Enum.Font.GothamBold
        winTitle.TextXAlignment    = Enum.TextXAlignment.Left
        winTitle.ZIndex            = 4
        winTitle.Parent            = topBar

        -- Traffic-light buttons
        local function MakeDot(color, x)
            local dot = Instance.new("Frame")
            dot.Size             = UDim2.new(0,12,0,12)
            dot.Position         = UDim2.new(1,x,0.5,0)
            dot.AnchorPoint      = Vector2.new(1,0.5)
            dot.BackgroundColor3 = color
            dot.BorderSizePixel  = 0
            dot.ZIndex           = 5
            dot.Parent           = topBar
            MakeRound(dot, 6)
            return dot
        end

        local closeBtn   = MakeDot(Color3.fromRGB(255,90,90),   -14)
        local minimBtn   = MakeDot(Color3.fromRGB(255,190,50),  -30)
        local maximBtn   = MakeDot(Color3.fromRGB(80,210,120),  -46)

        -- ── Dragging ──
        local dragging, dragOffset
        topBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or
               input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                local pos = input.Position
                dragOffset = Vector2.new(
                    pos.X - mainFrame.AbsolutePosition.X,
                    pos.Y - mainFrame.AbsolutePosition.Y
                )
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (
                input.UserInputType == Enum.UserInputType.MouseMovement or
                input.UserInputType == Enum.UserInputType.Touch
            ) then
                local vp   = workspace.CurrentCamera.ViewportSize
                local pos  = input.Position
                local newX = math.clamp(pos.X - dragOffset.X, 0, vp.X - mainFrame.AbsoluteSize.X)
                local newY = math.clamp(pos.Y - dragOffset.Y, 0, vp.Y - mainFrame.AbsoluteSize.Y)
                mainFrame.Position = UDim2.new(0, newX, 0, newY)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or
               input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        -- Close / minimize / maximize
        local minimized = false
        local storedSize
        closeBtn.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                Tween(mainFrame, {BackgroundTransparency=1, Size=UDim2.new(0,0,0,0)}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In)
                task.wait(0.3)
                screenGui:Destroy()
            end
        end)
        minimBtn.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                if minimized then
                    Tween(mainFrame, {Size = storedSize}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                    minimized = false
                else
                    storedSize = mainFrame.Size
                    Tween(mainFrame, {Size = UDim2.new(0,680,0,52)}, 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
                    minimized = true
                end
            end
        end)
        maximBtn.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                local vp = workspace.CurrentCamera.ViewportSize
                if mainFrame.Size == UDim2.new(0,680,0,440) then
                    Tween(mainFrame, {
                        Size     = UDim2.new(0, math.min(vp.X-40,1000), 0, vp.Y-40),
                        Position = UDim2.new(0.5,0,0.5,0)
                    }, 0.35, Enum.EasingStyle.Quart)
                else
                    Tween(mainFrame, {
                        Size     = UDim2.new(0,680,0,440),
                        Position = UDim2.new(0.5,0,0.5,0)
                    }, 0.35, Enum.EasingStyle.Quart)
                end
            end
        end)

        -- Keybind toggle
        local toggleKey = config.ToggleUIKeybind
        if toggleKey then
            local kc = typeof(toggleKey) == "EnumItem" and toggleKey
                or Enum.KeyCode[toggleKey]
            if kc then
                UserInputService.InputBegan:Connect(function(input, gp)
                    if not gp and input.KeyCode == kc then
                        mainFrame.Visible = not mainFrame.Visible
                    end
                end)
            end
        end

        -- ── Sidebar (tab bar) ──
        local sidebar = Instance.new("Frame")
        sidebar.Name             = "Sidebar"
        sidebar.Size             = UDim2.new(0,180,1,-52)
        sidebar.Position         = UDim2.new(0,0,0,52)
        sidebar.BackgroundColor3 = T.TabBG
        sidebar.BorderSizePixel  = 0
        sidebar.ZIndex           = 2
        sidebar.Parent           = mainFrame

        local sidebarStroke = Instance.new("UIStroke")
        sidebarStroke.Color       = T.Border
        sidebarStroke.Thickness   = 1
        sidebarStroke.Transparency = 0.7
        sidebarStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        sidebarStroke.Parent      = sidebar

        local tabListLayout = Instance.new("UIListLayout")
        tabListLayout.FillDirection = Enum.FillDirection.Vertical
        tabListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        tabListLayout.Padding     = UDim.new(0,4)
        tabListLayout.SortOrder   = Enum.SortOrder.LayoutOrder
        tabListLayout.Parent      = sidebar
        MakePadding(sidebar, 10, 10, 8, 8)

        -- ── Content area ──
        local contentArea = Instance.new("Frame")
        contentArea.Name             = "ContentArea"
        contentArea.Size             = UDim2.new(1,-180,1,-52)
        contentArea.Position         = UDim2.new(0,180,0,52)
        contentArea.BackgroundTransparency = 1
        contentArea.BorderSizePixel  = 0
        contentArea.ClipsDescendants = true
        contentArea.Parent           = mainFrame

        -- Bottom bar
        local bottomBar = Instance.new("Frame")
        bottomBar.Size             = UDim2.new(1,-180,0,28)
        bottomBar.Position         = UDim2.new(0,180,1,-28)
        bottomBar.BackgroundColor3 = T.TopBar
        bottomBar.BackgroundTransparency = 0.5
        bottomBar.BorderSizePixel  = 0
        bottomBar.ZIndex           = 2
        bottomBar.Parent           = mainFrame

        local versionBadge = Instance.new("TextLabel")
        versionBadge.Size              = UDim2.new(0,120,1,0)
        versionBadge.Position          = UDim2.new(1,-128,0,0)
        versionBadge.BackgroundTransparency = 1
        versionBadge.Text              = "NexusUI v" .. Nexus.Version
        versionBadge.TextColor3        = T.TextMuted
        versionBadge.TextSize          = 10
        versionBadge.Font              = Enum.Font.Gotham
        versionBadge.TextXAlignment    = Enum.TextXAlignment.Right
        versionBadge.ZIndex            = 3
        versionBadge.Parent            = bottomBar

        -- Animate in
        mainFrame.Size               = UDim2.new(0,0,0,0)
        mainFrame.BackgroundTransparency = 1
        Tween(mainFrame, {
            Size = UDim2.new(0,680,0,440),
            BackgroundTransparency = 0
        }, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

        -- ════════════════════════════════════════════
        --  WINDOW OBJECT
        -- ════════════════════════════════════════════
        local Window = {}
        Window._tabs        = {}
        Window._activeTab   = nil
        Window._tabOrder    = 0
        Window._screenGui   = screenGui
        Window._mainFrame   = mainFrame
        Window._configSave  = configSave
        Window._theme       = T

        -- ── CreateTab ──────────────────────────────
        function Window:CreateTab(name, icon)
            self._tabOrder += 1
            local order = self._tabOrder
            local isFirst = order == 1

            -- Tab button
            local tabBtn = Instance.new("TextButton")
            tabBtn.Name             = "Tab_" .. name
            tabBtn.Size             = UDim2.new(1,0,0,38)
            tabBtn.BackgroundColor3 = T.Surface
            tabBtn.BackgroundTransparency = isFirst and 0 or 1
            tabBtn.BorderSizePixel  = 0
            tabBtn.Text             = ""
            tabBtn.AutoButtonColor  = false
            tabBtn.ZIndex           = 3
            tabBtn.LayoutOrder      = order
            tabBtn.Parent           = sidebar
            MakeRound(tabBtn, 10)

            -- Active indicator
            local indicator = Instance.new("Frame")
            indicator.Size             = UDim2.new(0,3,0.7,0)
            indicator.Position         = UDim2.new(0,-3,0.15,0)
            indicator.BackgroundColor3 = T.TabActive
            indicator.BorderSizePixel  = 0
            indicator.BackgroundTransparency = isFirst and 0 or 1
            indicator.ZIndex           = 4
            indicator.Parent           = tabBtn
            MakeRound(indicator, 2)

            -- Icon
            local iconOffset = 10
            if icon and icon ~= 0 then
                local iconId = GetIcon(icon)
                local iconImg = Instance.new("ImageLabel")
                iconImg.Size             = UDim2.new(0,18,0,18)
                iconImg.Position         = UDim2.new(0,10,0.5,0)
                iconImg.AnchorPoint      = Vector2.new(0,0.5)
                iconImg.BackgroundTransparency = 1
                iconImg.Image            = "rbxassetid://" .. tostring(iconId)
                iconImg.ImageColor3      = isFirst and T.AccentLight or T.TextMuted
                iconImg.ZIndex           = 4
                iconImg.Parent           = tabBtn
                iconOffset = 34

                if isFirst then
                    indicator._iconImg = iconImg
                end
            end

            local tabLabel = Instance.new("TextLabel")
            tabLabel.Size              = UDim2.new(1,-iconOffset-8,1,0)
            tabLabel.Position          = UDim2.new(0,iconOffset,0,0)
            tabLabel.BackgroundTransparency = 1
            tabLabel.Text              = name
            tabLabel.TextColor3        = isFirst and T.TextAccent or T.TextMuted
            tabLabel.TextSize          = 13
            tabLabel.Font              = isFirst and Enum.Font.GothamBold or Enum.Font.Gotham
            tabLabel.TextXAlignment    = Enum.TextXAlignment.Left
            tabLabel.ZIndex            = 4
            tabLabel.Parent            = tabBtn

            -- Content page
            local page = Instance.new("ScrollingFrame")
            page.Name                  = "Page_" .. name
            page.Size                  = UDim2.new(1,0,1,-28)
            page.Position              = UDim2.new(0,0,0,0)
            page.BackgroundTransparency = 1
            page.BorderSizePixel       = 0
            page.ScrollBarThickness    = 3
            page.ScrollBarImageColor3  = T.Accent
            page.ScrollBarImageTransparency = 0.4
            page.CanvasSize            = UDim2.new(0,0,0,0)
